{
  "version": "3.0.0",
  "sources": {
    "source_a": {
      "description": "Historical match data, statistics, and card records",
      "version": 3,
      "selectors": {
        "match_row": "div.match-row, tr.match-item, .mac-satiri",
        "home_team": ".home-team .name, .ev-sahibi, td:nth-child(2)",
        "away_team": ".away-team .name, .deplasman, td:nth-child(4)",
        "score": ".score-cell, .skor, td:nth-child(3)",
        "date": ".match-date, .tarih, td:nth-child(1)",
        "stats_container": ".match-stats, .mac-istatistik",
        "possession": ".possession, .topa-sahip-olma",
        "shots_on": ".shots-on-target, .isabetli-sut",
        "shots_off": ".shots-off-target, .isabetsiz-sut",
        "corners": ".corners, .korner",
        "fouls": ".fouls, .faul",
        "yellow_cards": ".yellow-cards, .sari-kart",
        "red_cards": ".red-cards, .kirmizi-kart",
        "home_yellows": ".home-yellows, .ev-sari",
        "away_yellows": ".away-yellows, .dep-sari",
        "home_reds": ".home-reds, .ev-kirmizi",
        "away_reds": ".away-reds, .dep-kirmizi"
      },
      "fallback_selectors": [
        {
          "version": 2,
          "selectors": {
            "match_row": "tr.match-item, .mac-satiri",
            "home_team": ".ev-sahibi, td:nth-child(2)",
            "away_team": ".deplasman, td:nth-child(4)",
            "score": ".skor, td:nth-child(3)",
            "date": ".tarih, td:nth-child(1)"
          }
        },
        {
          "version": 1,
          "selectors": {
            "match_row": "tr.match-item",
            "home_team": "td:nth-child(2)",
            "away_team": "td:nth-child(4)",
            "score": "td:nth-child(3)",
            "date": "td:nth-child(1)"
          }
        }
      ]
    },
    "source_b": {
      "description": "Live scores, league tables, and card statistics",
      "version": 2,
      "selectors": {
        "match_row": ".match-card, .event-row",
        "home_team": ".home .team-name",
        "away_team": ".away .team-name",
        "score": ".score, .result",
        "date": ".date, .event-date",
        "yellow_cards": ".cards .yellow, .sari-kart",
        "red_cards": ".cards .red, .kirmizi-kart",
        "league_table_row": ".standings-row, tr.team-row",
        "position": ".pos, td:nth-child(1)",
        "team_name": ".team, td:nth-child(2)",
        "points": ".pts, td:last-child"
      },
      "fallback_selectors": [
        {
          "version": 1,
          "selectors": {
            "match_row": ".event-row",
            "home_team": ".home .team-name",
            "away_team": ".away .team-name",
            "score": ".result",
            "date": ".event-date"
          }
        }
      ]
    },
    "source_c": {
      "description": "Official results, fixture data, and discipline records",
      "version": 2,
      "selectors": {
        "fixture_row": ".fixture, .musabaka",
        "home_team": ".home, .ev",
        "away_team": ".away, .dep",
        "score": ".result, .sonuc",
        "date": ".date, .tarih",
        "referee": ".referee, .hakem",
        "home_yellows": ".home-discipline .yellow, .ev-sari",
        "away_yellows": ".away-discipline .yellow, .dep-sari",
        "home_reds": ".home-discipline .red, .ev-kirmizi",
        "away_reds": ".away-discipline .red, .dep-kirmizi"
      },
      "fallback_selectors": [
        {
          "version": 1,
          "selectors": {
