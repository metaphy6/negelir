            "away_team": ".dep",
            "score": ".sonuc",
            "date": ".tarih"
          }
        }
      ]
    },
    "source_d": {
      "description": "Modern frontend: embedded JSON in data-settings attribute (www.mackolik.com)",
      "version": 1,
      "extraction": "json_embedded",
      "selectors": {
        "data_blob": "[data-settings]",
        "standings_path": "competition.standings[0].table",
        "gamesets_path": "competition.gamesets",
        "team_stats_path": "competition.teamStats",
        "player_stats_path": "competition.playerStats",
        "season_list_path": "seasonList",
