{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/nlp.event.v1/idiom_expansion",
  "title": "nlp.event.v1{kind=idiom_expansion}",
  "description": "An idiom was expanded into its canonical intent/token form during normalization.",
  "type": "object",
  "required": [
    "kind",
    "producer",
    "emitted_at",
    "idiom_id",
    "span"
  ],
  "properties": {
    "kind": {
      "const": "idiom_expansion"
    },
    "producer": {
      "type": "string",
      "enum": [
        "nlp.intent.v1",
        "nlp.dispatcher.v1",
        "nlp.answer.v1",
        "nlp.proofreader.v1"
      ]
    },
    "request_id": {
      "type": ["string", "null"]
    },
    "emitted_at": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp."
    },
    "idiom_id": {
      "type": "string",
      "description": "Identifier of the idiom that was matched."
    },
    "span": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "replaced_tokens": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
