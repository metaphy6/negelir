{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/nlp.event.v1/compliance_refusal_triggered",
  "title": "nlp.event.v1{kind=compliance_refusal_triggered}",
  "description": "A response was refused because a tenant-specific compliance banlist matched.",
  "type": "object",
  "required": [
    "kind",
    "producer",
    "emitted_at"
  ],
  "properties": {
    "kind": {
      "const": "compliance_refusal_triggered"
    },
    "producer": {
      "type": "string",
      "enum": [
        "nlp.answer.v1",
        "nlp.intent.v1"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "tenant_id_h": {
      "type": "string"
    },
    "term_sha8": {
      "type": "string"
    },
    "emitted_at": {
      "type": "string",
      "description": "ISO-8601 UTC."
    }
  },
  "additionalProperties": false
}
