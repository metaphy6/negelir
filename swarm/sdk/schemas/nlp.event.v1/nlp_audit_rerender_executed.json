{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/nlp.event.v1/nlp_audit_rerender_executed",
  "title": "nlp.event.v1{kind=nlp_audit_rerender_executed}",
  "description": "An audit bundle re-render was executed for reproducibility verification.",
  "type": "object",
  "required": [
    "kind",
    "producer",
    "emitted_at"
  ],
  "properties": {
    "kind": {
      "const": "nlp_audit_rerender_executed"
    },
    "producer": {
      "type": "string",
      "enum": [
        "nlp.intent.v1",
        "nlp.answer.v1"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "bundle_sha": {
      "type": "string"
    },
    "audit_path": {
      "type": "string"
    },
    "emitted_at": {
      "type": "string",
      "description": "ISO-8601 UTC."
    }
  },
  "additionalProperties": false
}
