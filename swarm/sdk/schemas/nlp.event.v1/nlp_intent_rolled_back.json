{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/nlp.event.v1/nlp_intent_rolled_back",
  "title": "nlp.event.v1{kind=nlp_intent_rolled_back}",
  "description": "An intent model rollback was executed after retraining did not meet the risk threshold.",
  "type": "object",
  "required": [
    "kind",
    "producer",
    "emitted_at"
  ],
  "properties": {
    "kind": {
      "const": "nlp_intent_rolled_back"
    },
    "producer": {
      "type": "string",
      "enum": [
        "nlp.intent.v1"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "emitted_at": {
      "type": "string",
      "description": "ISO-8601 UTC."
    }
  },
  "additionalProperties": false
}
