{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/nlp.event.v1/pro_drop_resolved",
  "title": "nlp.event.v1{kind=pro_drop_resolved}",
  "description": "The NLP event emitted when a pro-drop implicit subject is resolved successfully during dispatch.",
  "type": "object",
  "required": [
    "kind",
    "producer",
    "emitted_at"
  ],
  "properties": {
    "kind": {
      "const": "pro_drop_resolved"
    },
    "producer": {
      "type": "string",
      "enum": [
        "nlp.intent.v1",
        "nlp.dispatcher.v1",
        "nlp.answer.v1",
        "nlp.proofreader.v1"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string",
      "enum": ["anaphora", "default_team", "disambiguation_emitted"]
    },
    "resolved_entity_id": {
      "type": ["string", "null"]
    },
    "emitted_at": {
      "type": "string",
      "description": "ISO-8601 UTC."
    }
  },
  "additionalProperties": false
}
