{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/nlp.event.v1/conversation_entity_overridden",
  "title": "nlp.event.v1{kind=conversation_entity_overridden}",
  "description": "A conversation entity override was applied to the current request.",
  "type": "object",
  "required": [
    "kind",
    "producer",
    "emitted_at"
  ],
  "properties": {
    "kind": {
      "const": "conversation_entity_overridden"
    },
    "producer": {
      "type": "string",
      "enum": [
        "nlp.intent.v1"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "overridden_kinds": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "emitted_at": {
      "type": "string",
      "description": "ISO-8601 UTC."
    }
  },
  "additionalProperties": false
}
