{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/nlp.event.v1/active_learning_queue_overflow",
  "title": "nlp.event.v1{kind=active_learning_queue_overflow}",
  "description": "The active-learning feedback queue in nlp.dispatcher.v1 overflowed and evicted the oldest row.",
  "type": "object",
  "required": [
    "kind",
    "producer",
    "emitted_at",
    "queue_size",
    "max_size"
  ],
  "properties": {
    "kind": {
      "const": "active_learning_queue_overflow"
    },
    "producer": {
      "type": "string",
      "enum": [
        "nlp.dispatcher.v1"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "emitted_at": {
      "type": "string",
      "description": "ISO-8601 UTC."
    },
    "queue_size": {
      "type": "integer",
      "minimum": 0
    },
    "max_size": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
