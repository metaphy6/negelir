{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/scrape.classified",
  "title": "scrape.classified",
  "description": "Phase 4.2: categorizer verdict + carry-through. Mirrors `ai/swarm/agents/payloads.py::ScrapeClassified`.",
  "type": "object",
  "required": ["raw", "label", "confidence", "classifier_id"],
  "properties": {
    "raw":           { "$ref": "scrape.raw.json" },
    "label":         { "type": "string", "enum": ["fixture_list", "match_detail", "lineup", "odds", "irrelevant"] },
    "confidence":    { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "classifier_id": { "type": "string", "description": "Stable id of the classifier that produced the label (e.g. `rules.v1`)." }
  },
  "additionalProperties": false
}
