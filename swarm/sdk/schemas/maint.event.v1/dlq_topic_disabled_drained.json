{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/maint.event.v1/dlq_topic_disabled_drained",
  "title": "maint.event.v1{kind=dlq_topic_disabled_drained}",
  "description": "Phase 8 §8.5 — notification emitted by maint.dlq.v1 when a replay request targets a topic in RECURSION_DENY_SET, is not in the configured allow-list, or transitions to disabled mid-run. Operator surface for 'why is my replay being refused?'.",
  "type": "object",
  "required": [
    "kind",
    "kind_schema_version",
    "target",
    "produced_at",
    "deny_reason"
  ],
  "properties": {
    "kind": {
      "const": "dlq_topic_disabled_drained"
    },
    "kind_schema_version": {
      "const": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "produced_at": {
      "type": "string"
    },
    "deny_reason": {
      "type": "string",
      "enum": [
        "recursion_deny",
        "allow_list_excluded",
        "topic_disabled_mid_run"
      ]
    },
    "request_id": {
      "type": "string",
      "description": "Originating operator request_id (if any)."
    }
  },
  "additionalProperties": false
}
