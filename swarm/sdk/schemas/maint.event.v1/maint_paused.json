{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/maint.event.v1/maint_paused",
  "title": "maint.event.v1{kind=maint_paused}",
  "description": "Phase 8 §8.10 — notification emitted by a maint.* agent after it successfully processes a `maint_pause` command. Distinguishable from the command itself (kind=maint_pause) by the agent_id field. Notification only.",
  "type": "object",
  "required": ["kind", "produced_at", "kind_schema_version", "agent_id"],
  "properties": {
    "kind":                { "const": "maint_paused" },
    "kind_schema_version": { "const": 1 },
    "produced_at":         { "type": "string" },
    "agent_id":            { "type": "string", "minLength": 1 },
    "target":              { "type": "string", "minLength": 1 },
    "request_id":          { "type": "string", "minLength": 1 },
    "ttl_s":               { "type": "integer", "minimum": 1 },
    "action":              { "type": "string", "enum": ["ttl_refresh", "no_op"] }
  },
  "additionalProperties": false
}
