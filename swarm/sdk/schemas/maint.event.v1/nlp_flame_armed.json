{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/maint.event.v1/nlp_flame_armed",
  "title": "maint.event.v1{kind=nlp_flame_armed}",
  "description": "Operator arms a one-shot NLP flame capture for a request or QA correlation.",
  "type": "object",
  "oneOf": [
    { "required": ["request_id"] },
    { "required": ["qa_correlation_id"] }
  ],
  "required": [
    "kind",
    "kind_schema_version",
    "target",
    "operator_id_h",
    "ttl_h",
    "reason",
    "produced_at"
  ],
  "properties": {
    "kind": { "const": "nlp_flame_armed" },
    "kind_schema_version": { "const": 1 },
    "target": {
      "type": "string",
      "minLength": 1,
      "description": "Command target identifier; v1 uses 'nlp.flame_capture'."
    },
    "request_id": { "type": "string", "minLength": 1 },
    "qa_correlation_id": { "type": "string", "minLength": 1 },
    "operator_id_h": { "type": "string", "minLength": 1 },
    "ttl_h": { "type": "integer", "minimum": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "client_id": { "type": "string", "minLength": 1 },
    "produced_at": { "type": "string" }
  },
  "additionalProperties": false
}
