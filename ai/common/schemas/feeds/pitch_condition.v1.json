{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PitchCondition Payload (v1) — Environment plane",
  "description": "Phase 21.4 — Pitch inspection record.",
  "type": "object",
  "required": ["pitch_id", "venue_id", "surface", "condition", "inspection_at"],
  "additionalProperties": false,
  "properties": {
    "pitch_id": {"type": "string", "minLength": 1},
    "venue_id": {"type": "string", "minLength": 1},
    "surface": {"type": "string", "enum": ["natural_grass", "hybrid", "artificial_turf", "indoor"]},
    "condition": {"type": "string", "enum": ["pristine", "good", "worn", "muddy", "frozen", "playable_with_concerns"]},
    "last_match_at": {"type": ["string", "null"], "format": "date-time"},
    "inspection_at": {"type": "string", "format": "date-time"}
  }
}
