{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract Payload (v1) — Roster-state plane",
  "description": "Phase 21.1 — Player contract status.",
  "type": "object",
  "required": ["contract_id", "player_id", "team_id", "starts_at", "expires_at", "extension"],
  "additionalProperties": false,
  "properties": {
    "contract_id": {"type": "string", "minLength": 1, "description": "Unique contract identifier."},
    "player_id": {"type": "string", "minLength": 1, "description": "FK to Reference plane."},
    "team_id": {"type": "string", "minLength": 1, "description": "FK to Reference plane."},
    "starts_at": {"type": "string", "format": "date", "description": "ISO date."},
    "expires_at": {"type": "string", "format": "date", "description": "ISO date."},
    "extension": {"type": "boolean", "description": "True if this updates an existing contract."}
  }
}
