{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Availability Payload (v1) — Health plane",
  "description": "Phase 21.2 — Player availability status for a fixture or period.",
  "type": "object",
  "required": ["availability_id", "player_id", "team_id", "status", "asserted_at", "source_confidence"],
  "additionalProperties": false,
  "properties": {
    "availability_id": {"type": "string", "minLength": 1},
    "player_id": {"type": "string", "minLength": 1},
    "team_id": {"type": "string", "minLength": 1},
    "fixture_id": {"type": ["string", "null"], "minLength": 1, "description": "None = general availability; set = per-fixture status."},
    "status": {"type": "string", "enum": ["fit", "doubtful", "out", "suspended", "international_duty", "rest"]},
    "asserted_at": {"type": "string", "format": "date-time"},
    "source_confidence": {"type": "string", "enum": ["club_official", "manager_presser", "press", "rumour"]}
  }
}
