{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RefereeAssignment Payload (v1) — Officials plane",
  "description": "Phase 21.3 — Referee assignment for a fixture.",
  "type": "object",
  "required": ["assignment_id", "fixture_id", "main_referee_id", "assistant_referee_ids", "announced_at", "last_minute_change"],
  "additionalProperties": false,
  "properties": {
    "assignment_id": {"type": "string", "minLength": 1},
    "fixture_id": {"type": "string", "minLength": 1, "description": "FK to Schedule plane fixture."},
    "main_referee_id": {"type": "string", "minLength": 1},
    "assistant_referee_ids": {"type": "array", "items": {"type": "string"}},
    "fourth_official_id": {"type": ["string", "null"], "minLength": 1},
    "var_referee_id": {"type": ["string", "null"], "minLength": 1},
    "avar_referee_id": {"type": ["string", "null"], "minLength": 1},
    "announced_at": {"type": "string", "format": "date-time"},
    "last_minute_change": {"type": "boolean", "description": "True if reassigned within 24h pre-KO."}
  }
}
