{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/maint.event.v1/maint_resume",
  "title": "maint.event.v1{kind=maint_resume}",
  "description": "Phase 8 §8.10 — broadcast resume for previously-paused maint.* agents. `target` matches the prior `maint_pause` target ('all' or an agent id).",
  "type": "object",
  "required": ["kind", "target", "request_id", "client_id", "produced_at"],
  "properties": {
    "kind":        { "const": "maint_resume" },
    "target":      { "type": "string", "minLength": 1 },
    "request_id":  { "type": "string", "minLength": 1 },
    "client_id":   { "type": "string", "minLength": 1 },
    "produced_at": { "type": "string" },
    "reason":      { "type": "string" }
  },
  "additionalProperties": false
}
