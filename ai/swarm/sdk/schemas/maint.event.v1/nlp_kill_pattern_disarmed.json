{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/maint.event.v1/nlp_kill_pattern_disarmed",
  "title": "maint.event.v1{kind=nlp_kill_pattern_disarmed}",
  "description": "Operator disarms a previously armed NLP kill pattern.",
  "type": "object",
  "required": [
    "kind",
    "kind_schema_version",
    "target",
    "request_id",
    "operator_id_h",
    "pattern_pack_sha8",
    "reason"
  ],
  "properties": {
    "kind": { "const": "nlp_kill_pattern_disarmed" },
    "kind_schema_version": { "const": 1 },
    "target": {
      "type": "string",
      "minLength": 1,
      "description": "Command target identifier; v1 uses 'nlp.kill_pattern'."
    },
    "request_id": { "type": "string", "minLength": 1 },
    "operator_id_h": { "type": "string", "minLength": 1 },
    "pattern_pack_sha8": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "produced_at": { "type": "string" }
  },
  "additionalProperties": false
}
