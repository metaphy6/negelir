{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/maint.event.v1/backup_key_rotated",
  "title": "maint.event.v1{kind=backup_key_rotated}",
  "description": "Phase 8 §8.3 — notification emitted by maint.backup.v1 after a successful encryption-key rotation. Notification only.",
  "type": "object",
  "required": ["kind", "produced_at", "kind_schema_version", "new_key_version"],
  "properties": {
    "kind":                { "const": "backup_key_rotated" },
    "kind_schema_version": { "const": 1 },
    "produced_at":         { "type": "string" },
    "fire_window_id":      { "type": "string", "minLength": 1 },
    "new_key_version":     { "type": "integer", "minimum": 1 },
    "old_key_version":     { "type": "integer", "minimum": 1 },
    "backup_id":           { "type": "string", "minLength": 1, "description": "The most-recent backup re-encrypted to the new key." }
  },
  "additionalProperties": false
}
