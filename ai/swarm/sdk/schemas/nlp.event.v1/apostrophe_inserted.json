{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/nlp.event.v1/apostrophe_inserted",
  "title": "nlp.event.v1{kind=apostrophe_inserted}",
  "description": "An apostrophe insertion repair was applied to the input.",
  "type": "object",
  "required": [
    "kind",
    "producer",
    "emitted_at"
  ],
  "properties": {
    "kind": {
      "const": "apostrophe_inserted"
    },
    "producer": {
      "type": "string",
      "enum": [
        "nlp.intent.v1"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "emitted_at": {
      "type": "string",
      "description": "ISO-8601 UTC."
    }
  },
  "additionalProperties": false
}
