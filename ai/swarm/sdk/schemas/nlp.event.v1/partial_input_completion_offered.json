{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/nlp.event.v1/partial_input_completion_offered",
  "title": "nlp.event.v1{kind=partial_input_completion_offered}",
  "description": "NLP event kind partial_input_completion_offered for partial Turkish input suggestions.",
  "type": "object",
  "required": [
    "kind",
    "producer",
    "emitted_at"
  ],
  "properties": {
    "kind": {
      "const": "partial_input_completion_offered"
    },
    "producer": {
      "type": "string",
      "enum": [
        "nlp.intent.v1",
        "nlp.dispatcher.v1",
        "nlp.answer.v1",
        "nlp.proofreader.v1"
      ]
    },
    "request_id": {
      "type": ["string", "null"]
    },
    "conversation_id": {
      "type": ["string", "null"]
    },
    "emitted_at": {
      "type": "string",
      "description": "ISO-8601 UTC."
    },
    "completions": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
