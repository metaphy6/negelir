{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/nlp.event.v1/streaming_client_slow_canceled",
  "title": "nlp.event.v1{kind=streaming_client_slow_canceled}",
  "description": "A streaming response was cancelled because the client was too slow.",
  "type": "object",
  "required": [
    "kind",
    "producer",
    "emitted_at"
  ],
  "properties": {
    "kind": {
      "const": "streaming_client_slow_canceled"
    },
    "producer": {
      "type": "string",
      "enum": [
        "nlp.answer.v1",
        "nlp.intent.v1"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "canceled_after_ms": {
      "type": "integer",
      "minimum": 0
    },
    "emitted_at": {
      "type": "string",
      "description": "ISO-8601 UTC."
    }
  },
  "additionalProperties": false
}
