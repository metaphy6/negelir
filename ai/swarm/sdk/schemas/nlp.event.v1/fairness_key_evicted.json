{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/nlp.event.v1/fairness_key_evicted",
  "title": "nlp.event.v1{kind=fairness_key_evicted}",
  "description": "A tenant/tenant-key fairness eviction occurred for NLP humanizer budgeting.",
  "type": "object",
  "required": [
    "kind",
    "producer",
    "emitted_at",
    "fairness_key",
    "evicted_count"
  ],
  "properties": {
    "kind": {"const": "fairness_key_evicted"},
    "producer": {
      "type": "string",
      "enum": ["nlp.intent.v1", "nlp.answer.v1", "nlp.proofreader.v1"]
    },
    "request_id": {"type": ["string", "null"]},
    "emitted_at": {"type": "string", "description": "ISO-8601 UTC."},
    "fairness_key": {"type": "string", "minLength": 1},
    "evicted_count": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
