{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/nlp.event.v1/safe_mode_exited",
  "title": "nlp.event.v1{kind=safe_mode_exited}",
  "description": "The NLP pipeline exited safe mode after recovery.",
  "type": "object",
  "required": [
    "kind",
    "producer",
    "emitted_at",
    "recovery_reason"
  ],
  "properties": {
    "kind": {"const": "safe_mode_exited"},
    "producer": {
      "type": "string",
      "enum": ["nlp.intent.v1", "nlp.answer.v1", "nlp.proofreader.v1"]
    },
    "request_id": {"type": ["string", "null"]},
    "emitted_at": {"type": "string", "description": "ISO-8601 UTC."},
    "recovery_reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
