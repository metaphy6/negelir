{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/nlp.event.v1/repeated_query_threshold_crossed",
  "title": "nlp.event.v1{kind=repeated_query_threshold_crossed}",
  "description": "A repeated-query threshold was crossed within a conversation.",
  "type": "object",
  "required": [
    "kind",
    "producer",
    "emitted_at",
    "repeat_count",
    "window_s"
  ],
  "properties": {
    "kind": {
      "const": "repeated_query_threshold_crossed"
    },
    "producer": {
      "type": "string",
      "enum": [
        "nlp.intent.v1",
        "nlp.dispatcher.v1",
        "nlp.answer.v1",
        "nlp.proofreader.v1"
      ]
    },
    "request_id": {
      "type": ["string", "null"]
    },
    "emitted_at": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp."
    },
    "repeat_count": {
      "type": "integer",
      "minimum": 1,
      "description": "The number of repeated queries detected within the window."
    },
    "window_s": {
      "type": "integer",
      "minimum": 1,
      "description": "The time window in seconds used for repeat detection."
    }
  },
  "additionalProperties": false
}
