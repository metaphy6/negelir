{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/nlp.event.v1/disclosure_emitted",
  "title": "nlp.event.v1{kind=disclosure_emitted}",
  "description": "A regulatory disclosure was emitted for a QA answer.",
  "type": "object",
  "required": [
    "kind",
    "producer",
    "request_id",
    "conversation_id",
    "disclosure_id",
    "disclosure_version",
    "emitted_at"
  ],
  "properties": {
    "kind": {
      "const": "disclosure_emitted"
    },
    "producer": {
      "type": "string",
      "enum": [
        "nlp.answer.v1"
      ]
    },
    "request_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": ["string", "null"]
    },
    "disclosure_id": {
      "type": "string"
    },
    "disclosure_version": {
      "type": "integer"
    },
    "emitted_at": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp."
    }
  },
  "additionalProperties": false
}
