{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "negelir/swarm/source.watch.report.v1",
  "title": "source.watch.report.v1",
  "description": "Deterministic source-watcher report emitted on SDK heartbeats. Carries the same classification output and update plan the legacy scheduler produced.",
  "type": "object",
  "required": ["source", "produced_at", "classification"],
  "properties": {
    "source": {
      "type": "string"
    },
    "produced_at": {
      "type": "string"
    },
    "classification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "severity", "reason"],
        "properties": {
          "path": {"type": "string"},
          "kind": {"type": "string"},
          "severity": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "plan": {
      "type": ["object", "null"]
    },
    "plan_summary_tr": {
      "type": ["string", "null"]
    },
    "plan_summary_source": {
      "type": ["string", "null"],
      "enum": ["llm", "fallback", "disabled", null]
    },
    "skipped_reason": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}