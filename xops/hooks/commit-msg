#!/usr/bin/env python3
"""commit-msg hook — enforce Conventional Commits format.

Installed by `make hooks.install`.  Source lives at xops/hooks/commit-msg.

Allowed types: feat fix docs style refactor perf test chore build ci revert
Format:        <type>[optional scope][optional !]: <description>
Examples:      feat(phase-10): add lexicon loader
               fix: off-by-one in retry logic
               refactor(phase-22)!: move scraper/ to root

The hook exits 0 (allow) or 1 (block) — git aborts the commit on exit 1.
"""
from __future__ import annotations

import re
import sys
from pathlib import Path

CONVENTIONAL_RE = re.compile(
    r"^(feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert)"
    r"(\([^)]+\))?"
    r"(!)?:"
    r" .+"
)

SKIP_PATTERNS = (
    # Merge commits generated by git itself
    re.compile(r"^Merge "),
    # Revert commits generated by `git revert`
    re.compile(r"^Revert \""),
    # Initial commit — one-time bootstrap exception
    re.compile(r"^Initial commit$"),
)


def main() -> int:
    if len(sys.argv) < 2:
        print("commit-msg: missing commit message file argument", file=sys.stderr)
        return 1

    msg_file = Path(sys.argv[1])
    try:
        raw = msg_file.read_text(encoding="utf-8")
    except OSError as exc:
        print(f"commit-msg: cannot read {msg_file}: {exc}", file=sys.stderr)
        return 1

    # First non-empty, non-comment line is the subject.
    subject = next(
        (line for line in raw.splitlines() if line.strip() and not line.startswith("#")),
        "",
    )

    if any(pat.match(subject) for pat in SKIP_PATTERNS):
        return 0

    if not CONVENTIONAL_RE.match(subject):
        print(
            "\n[commit-msg] Commit rejected — message does not follow Conventional Commits.\n"
            "\n"
            f"  Subject: {subject!r}\n"
            "\n"
            "  Required format:\n"
            "    <type>[(<scope>)][!]: <description>\n"
            "\n"
            "  Allowed types: feat  fix  docs  style  refactor  perf  test\n"
            "                 chore  build  ci  revert\n"
            "\n"
            "  Examples:\n"
            "    feat(phase-10): add lexicon loader\n"
            "    fix: off-by-one in retry logic\n"
            "    refactor(phase-22)!: move scraper/ to root\n",
            file=sys.stderr,
        )
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
