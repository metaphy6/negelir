# ─────────────────────────────────────────────────────────────────────────────
# Negelir — environment variable template (LOCAL DEV)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to xops/env/.env (or run `make env`) and adjust as
# needed. Compose loads it via `env_file:` per service AND via
# `--env-file xops/env/.env` (auto-injected by xops/makefile/_common.py)
# for its own ${VAR} substitution. The Python config layer reads each
# variable below with `os.getenv(...)` defaults that match the values
# shown here.
#
# Naming convention
# -----------------
#   NEGELIR_<COMPONENT>_<KEY>  Primary naming pattern: all new vars go here
#   NEGELIR_*       AI / scraper / scheduler / training knobs (ai/common/config.py)
#   SCRAPE_*        Scraper sources & HTTP behaviour (cross-cutting)
#   POSTGRES_*      Postgres connection (Python + Go server share these) [legacy]
#   REDIS_*         Redis connection (Python + Go server share these) [legacy]
#   MACKOLIK_*      Mackolik archive season IDs (data layer constants)
#   OPENFOOTBALL_*  openfootball season list (data layer)
#   FOOTBALLDATA_*  football-data.co.uk season codes (data layer)
#   AI_*            Python runtime knobs that pre-date the NEGELIR_ prefix [legacy]
#   DB_*, HTTP_*,   Go server only (read in server/cmd/main.go); listed here [legacy]
#   CACHE_*,        so docker-compose has a single source of truth
#   SERVER_*
#
# Precedence (highest → lowest):
#   1. exported shell env var
#   2. .env file (loaded by docker-compose / direnv) at xops/env/.env
#   3. hardcoded default in ai/common/config.py
#   4. canonical reference: ai/common/defaults.yaml
#
# `tests/test_config_sync.py` enforces that every NEGELIR_* / SCRAPE_* key
# documented here is actually consumed by the Python config layer, and vice
# versa. Add new env vars in BOTH places.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime config: Python+Go shared defaults ──
# Set NEGELIR_COMMON_STRICT=1 to make Config.validate() reject any unknown env key
# matching reserved prefixes (NEGELIR_*, SCRAPE_*, SWARM_*). Off by default.
NEGELIR_COMMON_STRICT=0

# Phase 11: device probe defaults
# Path where the probe writes the atomic inventory JSON (tmpfs recommended).
NEGELIR_COMMON_DEVICE_PROBE_PATH=/var/run/negelir/device.json
# Probe subprocess hard timeout (seconds)
NEGELIR_COMMON_DEVICE_PROBE_TIMEOUT_S=5
# Hotplug debounce window (seconds) for udev-triggered re-probes
NEGELIR_COMMON_DEVICE_PROBE_HOTPLUG_DEBOUNCE_S=10
# Supported NVIDIA driver version (major.minor format, e.g., "555" for R555+)
# Probe refuses combinations below this version with device.alert.v1{kind=unsupported_runtime}.
NEGELIR_COMMON_DRIVER_NVIDIA_MIN_VERSION=555
# Supported CUDA compute capability minimum (e.g., 3.5 for Kepler, 6.0 for P100, 7.0 for V100, 8.0 for Ampere)
NEGELIR_COMMON_CUDA_MIN_COMPUTE_CAPABILITY=6.0
# Supported cuDNN version (semver, e.g., "9.0.0"). Probe checks major.minor.
NEGELIR_COMMON_CUDNN_MIN_VERSION=9.0.0
# Supported CUDA version (semver, e.g., "12.4.0")
NEGELIR_COMMON_CUDA_MIN_VERSION=12.4.0
# Supported ROCm version (semver, e.g., "6.2.0")
NEGELIR_COMMON_ROCM_MIN_VERSION=6.2.0
# Supported OpenVINO version (semver, e.g., "2025.0.0")
NEGELIR_COMMON_OPENVINO_MIN_VERSION=2025.0.0
# Supported glibc version (semver, e.g., "2.35")
NEGELIR_COMMON_GLIBC_MIN_VERSION=2.35
# Phase 11 — GPU persistence + clocks + power cap settings
# Enable GPU persistence mode (nvidia-smi -pm 1) for reduced cold-start latency
NEGELIR_COMMON_GPU_ENABLE_PERSISTENCE_MODE=false
# Lock SM and memory clocks during benchmark runs for reproducibility (never in prod)
NEGELIR_COMMON_GPU_LOCK_CLOCKS=false
# Request specific power limit cap (watts) if operator wants to negotiate higher than current (0=no request)
NEGELIR_COMMON_GPU_REQUEST_POWER_LIMIT_W=0
# Phase 11.2 — GPU arbiter (mutual exclusion, preemption, placement)
# Lease TTL (seconds) for GPU arbiter Redis-backed locks. Auto-renewed every TTL/3.
NEGELIR_COMMON_GPU_ARBITER_LEASE_TTL_S=60
# Preemption grace period (milliseconds) for LLM-class loads to finish micro-batch.
NEGELIR_COMMON_GPU_ARBITER_PREEMPT_GRACE_MS=250
# Fragmentation headroom multiplier for placement decisions.
NEGELIR_COMMON_GPU_ALLOC_FRAGMENTATION_HEADROOM=0.1
# Fragmentation threshold (0.0-1.0): trigger defrag when occupied_vram/total_vram exceeds this.
NEGELIR_COMMON_GPU_ALLOC_DEFRAG_THRESHOLD=0.85
# Enable NVIDIA Multi-Process Service for light-weight inference co-tenancy.
NEGELIR_COMMON_CUDA_MPS_ENABLED=false
# Max concurrent MPS clients per GPU when enabled.
NEGELIR_COMMON_CUDA_MPS_MAX_CLIENTS=16
# Enable cold-start hedging: spawn GPU evaluation when CPU latency exceeds p95.
NEGELIR_COMMON_GPU_ARBITER_HEDGE_ENABLED=false
# Max concurrent hedge evaluations across all agents.
NEGELIR_COMMON_GPU_ARBITER_HEDGE_MAX_CONCURRENT=10
# Preemption cooldown (seconds): min wait before a preempted agent may re-claim the same GPU.
NEGELIR_COMMON_GPU_ARBITER_WINBACK_COOLDOWN_S=30
# Minimum lease hold time (milliseconds) to prevent brief realtime spikes from thrashing batch.
NEGELIR_COMMON_GPU_ARBITER_MIN_HOLD_MS=500
# Emergency panic CPU mode: set to true to force all agents onto CPU.
NEGELIR_COMMON_COMPUTE_PANIC_CPU=false
# Panic drain budget (seconds): time allowed for agents to drop GPU residency and restart on CPU.
NEGELIR_COMMON_COMPUTE_PANIC_DRAIN_S=30
# Weighted fair-share weights for GPU arbiter (§11.2 bullet 3): JSON dict of agent names to weights.
# Format (Phase 12+): {"sec_input_classifier": 1.0, "coder_llm": 2.0, "humanizer": 1.5}
# Tenant-aware weighting is a Phase 20 hook (currently no-op while tenant_quota_enabled=false).
NEGELIR_COMMON_GPU_ARBITER_WEIGHTS_JSON={}
# Phase 11.4 — GPU memory allocation tuning
# System memory reserved (MB) when allocating VRAM; prevents OOM from GPU-driver overhead.
NEGELIR_COMMON_GPU_SYSTEM_RESERVE_MB=128
# CUDA memory allocation config string (PyTorch PYTORCH_CUDA_ALLOC_CONF equivalent).
NEGELIR_COMMON_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb=256,garbage_collection_threshold:0.85
# Allow TF32 (Tensor Float 32) on Ampere+ GPUs for faster matrix ops (lower precision, higher throughput).
NEGELIR_COMMON_ALLOW_TF32=false
# NPU accelerator accuracy drop tolerance (%) before fallback to CPU; for Intel OpenVINO/AMD XDNA.
NEGELIR_COMMON_NPU_MAX_ACC_DROP_PCT=1.0
# Phase 11.3 — CPU compute governor (peer of the GPU arbiter)
# Count SMT siblings when allocating CPU threads (false by default for inference workloads).
NEGELIR_COMMON_CPU_GOVERNOR_USE_SMT=false
# Warn if CPU frequency scaling is in 'powersave' mode instead of 'performance' (impacts p95 latency).
NEGELIR_COMMON_CPU_GOVERNOR_WARN_POWERSAVE=true
# LLM backend for CPU-only inference (llama.cpp by default; never raw transformers on CPU).
NEGELIR_COMMON_CPU_LLM_BACKEND=llama.cpp
# Phase 11.5 — NPU support (Intel OpenVINO, AMD XDNA, Apple MPS)
# OpenVINO IR compiled-blob cache directory (tmpfs in dev, persistent in prod).
NEGELIR_COMMON_OPENVINO_BLOB_CACHE_DIR=/tmp/negelir_openvino_blobs
# NPU vendor: intel (default), amd (XDNA stretch goal), apple (MPS dev-only).
NEGELIR_COMMON_NPU_VENDOR=intel
# Allow Apple MPS backend on dev hosts (default false; never auto-selected in CI/prod).
NEGELIR_COMMON_ALLOW_MPS=false
# OpenVINO AsyncInferQueue depth per device (default 4).
NEGELIR_COMMON_OPENVINO_ASYNC_QUEUE_DEPTH=4
# Phase 11 — compute artifact cache for compiled engines/blobs
NEGELIR_COMMON_COMPUTE_ARTIFACT_CACHE_DIR=data/compute_artifacts
NEGELIR_COMMON_COMPUTE_ARTIFACT_CACHE_MAX_MB=10240
# REQUIRED — generate a strong value, e.g. `openssl rand -hex 32`
NEGELIR_COMMON_COMPUTE_ARTIFACT_CACHE_SECRET=replace_me_with_strong_secret

# ── Runtime Defaults ──
NEGELIR_COMMON_DEFAULT_LEAGUE_ID=super_lig
# Leave NEGELIR_COMMON_DEFAULT_SEASON empty to auto-derive from today's date
# ("YYYY-YYYY+1", July rollover). Set explicitly only to pin a season.
NEGELIR_COMMON_DEFAULT_SEASON=
# Phase 13.1 — League catalog load performance cap (milliseconds)
# Catalog with 50 rows must load in ≤ this value on cold container startup.
NEGELIR_COMMON_LEAGUE_CATALOG_LOAD_MAX_MS=50
# Phase 13.3.9 — Preset import performance cap (milliseconds)
# All presets must import (cold) in ≤ this value to stay under Phase 11 cold-start budget.
NEGELIR_COMMON_LEAGUE_PRESET_TOTAL_IMPORT_MAX_MS=300
# Phase 13.11 — Entity-extraction recall minimum for T2→T1 promotion gate
# Per LEAGUE_CATALOG.md §2.2, leagues must achieve ≥ this recall on a 50-query per-league
# test corpus to be promoted from T2 (development) to T1 (prod) tier.
NEGELIR_COMMON_NLP_PROMOTION_RECALL_MIN=0.92
# Phase 13.11 — Gazetteer compilation budget (milliseconds per league)
# Per §13.11.8, each league's gazetteer must compile in ≤ this time on cold start.
# Full 50-league recompile must complete in ≤ 1.5s (50 ms × 50 leagues ÷ parallelization).
NEGELIR_COMMON_GAZETTEER_COMPILE_MAX_MS=50
# Phase 13.4.5 — Fatigue window for international player availability (hours)
# A player who played for their national team within this window is flagged as fatigued.
NEGELIR_COMMON_FATIGUE_WINDOW_H=72
# Phase 13.4 — Identity cross-competition joins thresholds
# Minimum coverage of domestic-league anchors before cup competitions can ingest.
NEGELIR_COMMON_CUP_IDENTITY_COVERAGE_MIN=0.95
# Maximum false-splits (identity splits when should have merged) per week before alerting.
NEGELIR_COMMON_IDENTITY_FALSE_SPLIT_MAX_PER_WEEK=1
# Minimum Levenshtein/semantic similarity threshold for merging player/team identities across sources.
NEGELIR_COMMON_IDENTITY_MERGE_THRESHOLD=0.94
# Phase 13.5 — Calibration tolerance per competition format (multiplier on logloss)
# These determine how much worse a league's calibration can be than the baseline
# and still pass promotion gates. Format examples: round_robin, single_knockout, etc.
NEGELIR_COMMON_COMPETITION_CALIBRATION_TOLERANCE_ROUND_ROBIN=1.10
NEGELIR_COMMON_COMPETITION_CALIBRATION_TOLERANCE_SINGLE_KNOCKOUT=1.20
NEGELIR_COMMON_COMPETITION_CALIBRATION_TOLERANCE_TWO_LEG_KNOCKOUT=1.20
NEGELIR_COMMON_COMPETITION_CALIBRATION_TOLERANCE_GROUP_ROUND_ROBIN=1.15
NEGELIR_COMMON_COMPETITION_CALIBRATION_TOLERANCE_FINAL_ONLY=1.30
NEGELIR_COMMON_COMPETITION_CALIBRATION_TOLERANCE_MULTI_STAGE_QUALIFIER=1.25
# Phase 19.5 — International tournament support
# Home advantage multiplier for inter-confederation play-offs (WC qualifiers).
# Set to None (unset) for neutral home advantage (0.0), or a float value
# like 0.8 to enable home advantage in inter-confederation matches.
# NEGELIR_COMMON_WC_PLAYOFF_HOME_ADVANTAGE_PRIOR=
# Phase 19.8 — T3 observability
# Staleness alert threshold for T3 pipelines (hours, default 72).
NEGELIR_COMMON_T3_STALENESS_ALERT_HOURS=72
# Phase 19.6 — T3 resource governance & scrape-lane isolation
# Number of concurrent workers in T3 scrape lane (default 2; separate from T1/T2).
NEGELIR_COMMON_T3_SCRAPE_CONCURRENCY=2
# Rate limit in requests per second for T3 scrape lane (default 0.05 rps per source).
NEGELIR_COMMON_T3_SCRAPE_RATE_LIMIT_RPS=0.05
# Wall-clock seconds of scrape time budgeted per T3 league per day (default 10).
NEGELIR_COMMON_T3_SCRAPE_BUDGET_PER_LEAGUE_S=10
# Maximum CPU cores allocated per T3 league in predictor fan-out (default 0.25).
NEGELIR_COMMON_T3_PREDICTOR_MAX_CPU_CORES=0.25
# Hours to wait before auto-shelving a T3 league with zero source availability (default 48).
NEGELIR_COMMON_T3_SOURCE_GRACE_PERIOD_HOURS=48
# Estimated Redis memory per T3 league in kilobytes (default 512 KB).
NEGELIR_COMMON_T3_REDIS_MEMORY_PER_LEAGUE_KB=512
# CI width multiplier when a T3 league is missing data planes (default 1.3×).
NEGELIR_COMMON_T3_PARTIAL_COVERAGE_CI_WIDEN_FACTOR=1.3
# Minimum confidence for bootstrapped T3 predictions (default 0.45).
NEGELIR_COMMON_T3_BOOTSTRAP_CONFIDENCE_FLOOR=0.45
# Maximum concurrent onboarding operations (default 3).
NEGELIR_COMMON_T3_ONBOARDING_CONCURRENT=3
# Minimum calendar days of historical data required for source onboarding (default 548 = 2 seasons).
NEGELIR_COMMON_T3_HISTORICAL_MIN_DAYS=548
# Maximum milliseconds for a full catalog reload (default 500 ms; SLO enforced by CI).
NEGELIR_COMMON_CATALOG_RELOAD_SLO_MS=500
# Maximum number of leagues supported in catalog (default 500).
NEGELIR_COMMON_CATALOG_MAX_LEAGUES=500
# Phase 13.7 — Tier promotion gate thresholds
# Maximum age (hours) for a readiness report before T2→T1 promotion is blocked.
NEGELIR_COMMON_LEAGUE_READINESS_REPORT_MAX_AGE_H=168
# Minimum calendar days in beta (T2) before a league can promote to T1.
NEGELIR_COMMON_LEAGUE_BETA_MIN_DAYS=28
# Phase 13.9 — Performance & footprint caps
# Maximum resident memory for a fully-loaded 50-league catalog (includes competitions).
NEGELIR_COMMON_LEAGUE_CATALOG_MAX_RSS_MB=8
# Phase 13.10 — Per-league observability & demotion
# Maximum wall-clock days a league can stay in T2 before auto-demotion to T3.
NEGELIR_COMMON_LEAGUE_T2_MAX_DWELL_DAYS=180
# Minimum sustained breach window (hours) required for auto-demotion.
NEGELIR_COMMON_LEAGUE_DEMOTION_EVIDENCE_WINDOW_H=6
# Minimum calendar days between demotion events to prevent thrashing tier.
NEGELIR_COMMON_LEAGUE_DEMOTION_MIN_DAYS=14

# Phase 13.5 — Calibration backfill & per-format backtest harness
# Maximum number of competitions to backtest in parallel (0 = auto: vCPU count).
NEGELIR_SWARM_BACKTEST_CONCURRENCY_MAX=0
# Deterministic seed for reproducible backtest runs.
NEGELIR_SWARM_BACKTEST_SEED=42
# Maximum absolute calibration deviation for domestic-cup early rounds.
NEGELIR_COMMON_CUP_EARLY_ROUND_CALIBRATION_MAX_DEVIATION=0.12
# Maximum allowed absolute calibration deviation for leagues (triggers retraining).
NEGELIR_COMMON_LEAGUE_CALIBRATION_MAX_DEVIATION=0.08
# Maximum calibration plot drift allowed across era boundaries.
NEGELIR_COMMON_ERA_DRIFT_TOLERANCE=0.10
# Minimum accuracy floor for swarm backtests (CI gate); as decimal (0.01 = 1%).
NEGELIR_SWARM_BACKTEST_SWARM_FLOOR_PCT=0.01

NEGELIR_COMMON_MACKOLIK_GROUP_ID=1
NEGELIR_COMMON_MACKOLIK_LEAGUE_FILTER=Süper Lig

# ── Timeouts ──
NEGELIR_COMMON_SERVER_FETCH_TIMEOUT=10
NEGELIR_COMMON_SCRAPE_TRIGGER_TIMEOUT=30
NEGELIR_COMMON_HEALTH_CHECK_TIMEOUT=5
NEGELIR_COMMON_MACKOLIK_HTTP_TIMEOUT=15
NEGELIR_COMMON_SCRAPE_HTTP_TIMEOUT=15
NEGELIR_COMMON_FOOTBALLDATA_HTTP_TIMEOUT=10

# ── Scheduler ──
NEGELIR_DATASOURCE_SCHEDULE_DAILY_SCRAPE_HOUR=6
NEGELIR_DATASOURCE_SCHEDULE_DAILY_SCRAPE_MINUTE=0
NEGELIR_DATASOURCE_SCHEDULE_OUTCOME_CHECK_HOUR=22
NEGELIR_DATASOURCE_SCHEDULE_OUTCOME_CHECK_MINUTE=0
NEGELIR_DATASOURCE_SCHEDULE_RETRAIN_DAY=sun
NEGELIR_DATASOURCE_SCHEDULE_RETRAIN_HOUR=3
NEGELIR_DATASOURCE_SCHEDULE_HEARTBEAT_MINUTES=5

# ── Scraping ──
NEGELIR_DATASOURCE_REAL_DATA_RATE_LIMIT=1.0

# ── Self-Healing / Failover ──
NEGELIR_DATASOURCE_SOURCE_PRIORITY=source_a,source_b,source_c,source_d
NEGELIR_DATASOURCE_STALE_THRESHOLD_SECONDS=604800
NEGELIR_DATASOURCE_STALE_CONFIDENCE_PENALTY=0.5
NEGELIR_DATASOURCE_SOURCE_FAILURE_THRESHOLD=3

# ── Model / Training ──
NEGELIR_DATASOURCE_DRIFT_WINDOW=30
NEGELIR_DATASOURCE_DRIFT_FLOOR=0.35
NEGELIR_DATASOURCE_TRAINING_NOISE_PCT=0.005
NEGELIR_DATASOURCE_TRAINING_TEST_SPLIT=0.2
NEGELIR_DATASOURCE_TRAINING_SEED=42
NEGELIR_DATASOURCE_TRAINING_CROSS_SOURCE_AGREEMENT_MULTI=0.95
NEGELIR_DATASOURCE_MODEL_MAX_SIZE_MB=8.0
NEGELIR_DATASOURCE_TRAINING_SAMPLE_WEIGHTS=1.0,2.0,1.0

# ── NLP (Phase 10) ──
# Proofreader gate 3: length bounds (§10.9 bullet 2).
NEGELIR_SWARM_NLP_MIN_ANSWER_CHARS=20
NEGELIR_SWARM_NLP_MAX_ANSWER_CHARS=600
# §10.19 backpressure — when qa.intent.v1 queue depth exceeds this threshold,
# disable humanizer, widen cache TTL 2x, and emit nlp.alert.v1.
NEGELIR_SWARM_NLP_QUEUE_PRESSURE_THRESHOLD=100
# §10.19 backpressure — duration (seconds) to run in template-only mode after
# backpressure is triggered.
NEGELIR_SWARM_NLP_PRESSURE_HUMANIZE_OFF_S=60
# §10.19 sampled answer audit — 1-in-N sampling rate for offline quality review.
NEGELIR_SWARM_NLP_ANSWER_SAMPLE_INVERSE=1000
# §10.19 sampled answer audit — daily cap on captured answers.
NEGELIR_SWARM_NLP_ANSWER_SAMPLE_DAILY_CAP=5000
# §10.27.11 answer format negotiation default and forward-hook enum.
NEGELIR_SWARM_NLP_DEFAULT_ANSWER_FORMAT=plain
NEGELIR_SWARM_NLP_ANSWER_FORMATS=plain,markdown_safe,screen_reader,whatsapp_4096,sms_160,tts_neutral
NEGELIR_SWARM_NLP_ANSWER_FORMAT_ENABLED={"plain": true, "markdown_safe": true, "screen_reader": true, "whatsapp_4096": false, "sms_160": false, "tts_neutral": false}
# §10.25.10 tenant-specific compliance banlist reload interval.
NEGELIR_SWARM_NLP_COMPLIANCE_RELOAD_S=60
NEGELIR_SWARM_NLP_AUDIT_BUNDLE_RETENTION_DAYS=2555
NEGELIR_SWARM_NLP_INTENT_RETRAIN_MAX_REGRESSION=0.005
NEGELIR_SWARM_NLP_ERASE_SCAN_BATCH=500
NEGELIR_SWARM_NLP_TEMPLATE_GIT_SHA=
NEGELIR_SWARM_NLP_SYSTEM_CAPABILITY_TEMPLATE_PATH=
NEGELIR_SWARM_NLP_PIPELINE_VERSION=10.0.0
NEGELIR_SWARM_NLP_COMPATIBILITY_MATRIX_PATH=ai/nlp/_compat/compatibility_matrix.json
NEGELIR_SWARM_NLP_PROBER_INTERVAL_S=60
NEGELIR_SWARM_NLP_PROBER_CORPUS_SIZE=50
NEGELIR_SWARM_NLP_PROBER_HUMANIZER_DISABLED=true
# §10.32.14 eval corpus curation: per-quarter limit on rows added by the curator.
NEGELIR_SWARM_NLP_EVAL_CORPUS_PR_MAX_ADDED_ROWS_PER_QUARTER=500
# §10.32.14 reviewer sign-off gating for curated eval corpus batches.
NEGELIR_SWARM_NLP_EVAL_CORPUS_REVIEW_REQUIRED=true
NEGELIR_SERVER_API_PROBER_BUCKET_RPS=2
NEGELIR_SWARM_NLP_ZONEINFO_DIR=
# §10.23.6 optional pod-shipped zoneinfo directory for render timezone SHA pinning.
# Empty uses the system zoneinfo bundle.
# §10.21.9 cold-start boot budget (seconds). If exceeded, readiness stays 503.
NEGELIR_SWARM_NLP_BOOT_BUDGET_S=30
# §10.21.9 liveness grace after budget breach (seconds) before restart handoff.
NEGELIR_SWARM_NLP_BOOT_LIVENESS_GRACE_S=60
# §10.21.11 consensus smoke probe timeout (seconds).
NEGELIR_SWARM_NLP_BOOT_CONSENSUS_SMOKE_TIMEOUT_S=10
# §10.21.11 consensus smoke probe critical threshold (seconds).
NEGELIR_SWARM_NLP_BOOT_CONSENSUS_SMOKE_CRITICAL_S=60
# §10.21.11 consensus smoke sentinel match id for Phase 5 fast-path probe.
NEGELIR_SWARM_NLP_BOOT_CONSENSUS_SENTINEL_MATCH_ID=nlp:boot:canary
# §10.21 graceful SIGTERM drain budget (seconds).
NEGELIR_SWARM_NLP_SHUTDOWN_GRACE_S=20
# §10.33.3 normalize-space floor — collapse every Unicode Zs category to U+0020.
NEGELIR_SWARM_NLP_COLLAPSE_UNICODE_SPACES=true
# §10.33.3 emoji strip stage — remove symbol-other/modifier emoji after hints.
NEGELIR_SWARM_NLP_STRIP_EMOJI=true
# §10.33.3 structured-input refusal stage — reject JSON/YAML/XML/code-fence paste.
NEGELIR_SWARM_NLP_STRUCTURED_INPUT_REFUSAL_ENABLED=true
# §10.24.2 repeated-character collapse token-length cap.
NEGELIR_SWARM_NLP_REPEAT_COLLAPSE_MAX_LEN=64
NEGELIR_SWARM_NLP_REPEAT_COLLAPSE_MIN_FREQ=100
NEGELIR_SWARM_NLP_DIGIT_LETTER_FOLD_ENABLED=true
# §10.33 random case detection threshold (per-token mixed-case flip ratio).
NEGELIR_SWARM_NLP_RANDOM_CASE_THRESHOLD=0.30
# §10.34 mega-input detection: minimum raw-character length before last-paragraph
# extraction is considered for long multi-paragraph pastes.
NEGELIR_SWARM_NLP_MEGAINPUT_MIN_CHARS=1500
NEGELIR_SWARM_NLP_OCR_REPAIR_FORCE=false
NEGELIR_SWARM_NLP_PASTE_MAX_NEWLINES=4
# §10.34 numeric redundant restatement: collapse digit + number-word pairs.
NEGELIR_SWARM_NLP_NUMERIC_REDUNDANT_RESTATEMENT_ENABLED=true
# §10.34 emoji-to-concept promotion: route emoji+suffix inputs to typed entities.
NEGELIR_SWARM_NLP_EMOJI_TO_CONCEPT_ENABLED=true
# §10.34 single-emoji intent routing to closed Turkish clarification offer.
NEGELIR_SWARM_NLP_SINGLE_EMOJI_INTENT_ENABLED=true
# §10.24 time-of-day shorthand expansion (e.g., aks→akşam, gec→gece).
NEGELIR_SWARM_NLP_TIME_OF_DAY_SHORTHAND_ENABLED=true
NEGELIR_SWARM_NLP_NEGATION_ENABLED=true
NEGELIR_SWARM_NLP_COMPOUND_QUERY_ENABLED=true
NEGELIR_SWARM_NLP_EMOJI_HINT_ENABLED=true
NEGELIR_SWARM_NLP_HASHTAG_HANDLING_ENABLED=true
NEGELIR_SWARM_NLP_AT_MENTION_HANDLING_ENABLED=true
NEGELIR_SWARM_NLP_FRAGMENT_DETECTION_ENABLED=true
NEGELIR_SWARM_NLP_HTML_UNESCAPE_ENABLED=true
NEGELIR_SWARM_NLP_HARMONY_TOLERANT_STRIP_ENABLED=true
# §10.21.7 PII log filter — redact long unrecognized strings in logs.
NEGELIR_SWARM_NLP_LOG_MAX_UNREDACTED_STR_LEN=64
# L0 intent cache (§10.12).
# In-process LRU cache keyed on sha256(normalized_text|locale).
# Negative-caches meta.unsupported only; never caches predict.* intents.
NEGELIR_SWARM_NLP_INTENT_CACHE_MAX_ENTRIES=10000
NEGELIR_SWARM_NLP_INTENT_CACHE_TTL_S=300
NEGELIR_SWARM_NLP_INTENT_ENUM_V4_ENABLED=true
NEGELIR_SWARM_NLP_WH_PRIOR_LOG_ODDS_MAX=1.5
NEGELIR_SWARM_NLP_WH_PRIOR_DRIFT_ALERT_PP=2.0
NEGELIR_SWARM_NLP_IDIOM_MAX_PHRASE_LEN_TOKENS=5
NEGELIR_SWARM_NLP_IDIOM_AMBIGUOUS_EVENT_RATELIMIT_S=300
NEGELIR_SWARM_NLP_CONDITIONAL_MARKER_LOOKAHEAD_TOKENS=8
NEGELIR_SWARM_NLP_POLITENESS_MARKER_STRIP_ENABLED=true
NEGELIR_SWARM_NLP_POLITENESS_DISTRIBUTION_DRIFT_PP=10.0
NEGELIR_SWARM_NLP_SEARCH_OPERATOR_DETECTION_ENABLED=true
NEGELIR_SWARM_NLP_FOOTBALL_VOCAB_HINTS_ENABLED=true
NEGELIR_SWARM_NLP_ANAPHORA_LOOKBACK_TURNS=5
NEGELIR_SWARM_NLP_ANAPHORA_LOOKBACK_SECONDS=900
NEGELIR_SWARM_NLP_ANAPHORA_MIN_ANTECEDENT_CONFIDENCE=0.70
NEGELIR_SWARM_NLP_PRO_DROP_LOOKBACK_TURNS=3
NEGELIR_SWARM_NLP_PRO_DROP_MIN_IMPLICIT_SUBJECT_CONFIDENCE=0.65
NEGELIR_SWARM_NLP_PRO_DROP_DEFAULT_TEAM_CONFIDENCE_CAP=0.55
NEGELIR_SWARM_NLP_ANAPHORA_EVICTION_EVENT_RATELIMIT_S=60
NEGELIR_SWARM_NLP_REPEATED_QUERY_WINDOW_S=300
NEGELIR_SWARM_NLP_REPEATED_QUERY_THRESHOLD=3
NEGELIR_SWARM_NLP_REPEATED_QUERY_SUMMARY_THRESHOLD=5
NEGELIR_SWARM_NLP_REPEATED_QUERY_CACHE_MAX_AGE_S=60
NEGELIR_SWARM_NLP_SUMMARY_MAX_FIXTURES_HARD=20
NEGELIR_SWARM_NLP_VENUE_INFERRED_TEAM_CONFIDENCE_CAP=0.70
NEGELIR_SWARM_NLP_ENTITY_PRE_MATCH_MAX_STALE_S=300
NEGELIR_SWARM_NLP_ENTITY_LIVE_MAX_STALE_S=30
NEGELIR_SWARM_NLP_ENTITY_POST_MATCH_MAX_STALE_S=3600
NEGELIR_SWARM_NLP_BOOT_CORPUS_TOP1_ENTITY_DRIFT_MAX_ROWS=2
# §10.12 L1 answer cache (Phase 4 cache.v1 plane reuse)
NEGELIR_SWARM_NLP_ANSWER_CACHE_TTL_DATA_S=120
NEGELIR_SWARM_NLP_ANSWER_CACHE_TTL_PREDICT_S=60
NEGELIR_SWARM_NLP_L1_CACHE_HMAC_KEY_PATH=infra/nlp/nlp_l1_cache_hmac.key
NEGELIR_SWARM_QA_ANSWER_HMAC_KEY_PATH=infra/nlp/qa_answer_hmac.key
NEGELIR_SWARM_QA_ANSWER_HMAC_GRACE_S=86400
NEGELIR_SWARM_NLP_ANSWER_ENVELOPE_HMAC_REQUIRED=warn
NEGELIR_SWARM_NLP_EMPTY_INPUT_ANOMALY_THRESHOLD=0.3
NEGELIR_SWARM_NLP_EMPTY_INPUT_ANOMALY_WINDOW_S=300
NEGELIR_SWARM_NLP_ALL_CAPS_THRESHOLD=0.85
NEGELIR_SWARM_NLP_SHOUT_RATE_ALERT_THRESHOLD=0.5
NEGELIR_SWARM_NLP_SHOUT_RATE_ALERT_MIN_REQUESTS=20
NEGELIR_SWARM_NLP_SHOUT_RATE_ALERT_WINDOW_S=300
NEGELIR_SWARM_NLP_SHOUT_RATE_ALERT_COOLDOWN_S=600
NEGELIR_SWARM_NLP_L0_CACHE_TTL_S=300
NEGELIR_SWARM_NLP_L1_ANSWER_CACHE_TTL_S=600
# Phase 10.25 — NLP promotion gate recall floor (swarm-side threshold)
# Minimum entity-extraction recall required by the swarm during live operation.
# Separate from NEGELIR_COMMON_NLP_PROMOTION_RECALL_MIN (batch gate used in T2→T1).
NEGELIR_SWARM_NLP_PROMOTION_RECALL_MIN=0.92

# ── Telemetry ──
NEGELIR_COMMON_TELEMETRY_MAX_STREAM=50000
NEGELIR_COMMON_REDIS_SOCKET_TIMEOUT=2
# Phase 8.16.4 — cardinality-safe ack metrics debug gate.
# false (default, prod): emit only low-cardinality maint_ack_total{accepted_by, accepted}.
# true (dev / incident triage): also emit maint_ack_total_debug{kind, accepted_by, accepted}.
NEGELIR_COMMON_TELEMETRY_DEBUG_ENABLED=false
# Boot guard: refuse to enable debug mode if projected series > this ceiling.
NEGELIR_COMMON_TELEMETRY_DEBUG_MAX_SERIES=5000

# ── Swarm SDK (Phase 3) ──
# Bus implementation: "redis" (Redis Streams; default) or "memory" (in-process,
# tests only — picks the InMemoryBus, ignores Redis).
SWARM_BUS_KIND=redis
# Consumer-group prefix; final group name is "<prefix>:<agent_name>".
SWARM_CONSUMER_GROUP_PREFIX=swarm
# Heartbeat cadence; supervisor marks an instance stale after 3× this value.
SWARM_HEARTBEAT_SEC=5                                   # shared
# TTL on the agent_registry hash entry (seconds). Auto-evicted by Redis if the
# instance dies without deregistering. Should be > 3× SWARM_HEARTBEAT_SEC.
SWARM_REGISTRY_TTL_SEC=30
# Max messages an agent claims at once (per-instance backpressure cap).
SWARM_MAX_IN_FLIGHT=32
# Per-message retry budget before the message goes to <topic>.dlq.
SWARM_RETRY_BUDGET=3
# Hard cap on the dead-letter stream length (Redis MAXLEN ~).
SWARM_DLQ_MAX_LEN=10000
# Time after which a pending (claimed-but-not-acked) message is reclaimed by
# another consumer via XAUTOCLAIM. Should be > p99(handler latency).
SWARM_PENDING_CLAIM_SEC=60
# HTTP port where each agent exposes /metrics in Prometheus text format.
SWARM_METRICS_PORT=9100

# ── Phase 4: Worker agents (scrape → categorize → process → store) ──
# Cross-cutting deployment profile (mock|prod). `prod` flips fail-safe
# gates that refuse insecure configs outright (e.g. the §8.3 backup
# `fail_safe_no_encryption_in_prod` boot refusal). Keep `mock` in dev.
NEGELIR_COMMON_PROFILE=mock
# Categorizer confidence floor; below this → proof.flag, never scrape.classified.
NEGELIR_COMMON_CATEGORIZER_MIN_CONF=0.55
# On-disk path the categorizer loads its trained LinearSVC from (Phase 4.2.b).
NEGELIR_COMMON_CATEGORIZER_MODEL_PATH=data/models/categorizer_v1.joblib
# Cache TTLs (seconds). Records are larger and slower-moving than predictions.
NEGELIR_COMMON_CACHE_RECORD_TTL_SEC=600
NEGELIR_COMMON_CACHE_PREDICTION_TTL_SEC=300
# Telemetry agent's Prometheus exposer port (separate from per-agent SDK port).
NEGELIR_COMMON_TELEMETRY_METRICS_PORT=9101
# Bind address for the telemetry exposer. Defaults to loopback so an
# unauthenticated /metrics endpoint is not exposed on every interface.
# Override to 0.0.0.0 only when the network policy / firewall in front
# of the container actually restricts access.
NEGELIR_COMMON_TELEMETRY_METRICS_BIND=127.0.0.1
# Reactors drop events older than this (replay window upper bound).
NEGELIR_SWARM_REACTOR_MAX_EVENT_AGE_SEC=86400
# Cap on the per-reactor in-memory idempotency ledger (LRU eviction
# of oldest entries). Prevents unbounded memory growth on long-running
# swarms or backtest replays. Production should swap in the Postgres
# ledger; this knob only bounds the dev / tests / single-process path.
NEGELIR_SWARM_REACTOR_LEDGER_MAX_SIZE=100000

# ── Phase 5: Predictor swarm + consensus ──
# Consensus collection window: how long `consensus.v1` waits for `predict.vote`
# messages before fusing the votes it has, in milliseconds. Closes early once
# every healthy predictor (per agent_registry) has voted.
NEGELIR_SWARM_CONSENSUS_WINDOW_MS=750                                   
# Per-vote confidence floor: votes with confidence < this are dropped silently
# (the swarm simply has one fewer voter). Default 0.0 = filter disabled, so
# baseline predictors (e.g. Elo at ~0.32) still contribute. Raise once your
# roster's confidences are calibrated and meaningful (typically post Phase 6
# proofreader feedback). SWARM.md consensus algo step 2.
NEGELIR_SWARM_CONSENSUS_MIN_CONFIDENCE=0.0
# Minimum number of voting predictors before consensus is considered healthy.
# Fewer voters → `predict.final.degraded=true` + degraded_reason set.
NEGELIR_SWARM_CONSENSUS_MIN_VOTERS=3
# Rolling Brier-score window (matches) used to learn per-predictor weights.
NEGELIR_SWARM_CONSENSUS_BRIER_WINDOW=200
# Hard cap on consensus' in-flight pending-fusion set. Protects against
# unbounded growth if predictors permanently DLQ or `flush_expired` is not
# called by the runner. Overflow evicts oldest + emits proof.flag
# (kind=consensus_overflow).
NEGELIR_SWARM_CONSENSUS_MAX_PENDING=4096
# Suppression window (seconds) for repeat `consensus.overflow` proof.flag
# emissions. When the pending set is saturated every new vote triggers
# eviction; without suppression that floods proof.flag with the same
# signal. Set 0 to disable suppression.
NEGELIR_SWARM_CONSENSUS_OVERFLOW_FLAG_MIN_INTERVAL_SEC=10
# Opt-in for `pred.lgbm_market.v1`. Default off — requires odds-record coverage.
NEGELIR_SWARM_PREDICTOR_MARKET_FEATURES_ENABLED=false
# Per-predictor GPU VRAM ceiling (MB). Phase 11 enforcement; Phase 5 documents.
NEGELIR_SWARM_PREDICTOR_MAX_VRAM_MB=1024
# Trainer reactor debounce window per (predictor_id, league) seconds.
NEGELIR_SWARM_TRAINER_DEBOUNCE_SEC=300
# Backtest CI gate: swarm log-loss must beat best individual predictor by at
# least this fraction (e.g. 0.01 = 1% improvement) per (league, market).
NEGELIR_SWARM_BACKTEST_SWARM_FLOOR_PCT=0.01
# Backtest replay window in weeks. `make backtest WEEKS=N` overrides.
NEGELIR_SWARM_BACKTEST_WINDOW_WEEKS=12
# Minimum match count per (league, market) for the backtest gate to apply.
NEGELIR_SWARM_BACKTEST_MIN_N=20
# Phase 9 SLA budget: API request timeout ≥ consensus_window_ms + this overhead.
# Documented here; enforced by the API gateway in Phase 9.
NEGELIR_SERVER_API_CONSENSUS_OVERHEAD_MS=200                             
# Phase 9 §9.0 §3.3: total API request timeout must cover the full prediction
# path (consensus_window_ms + proofreader_quorum_window_ms + api_consensus_overhead_ms
# + api_transit_jitter_ms). Config validator rejects values below the sum.
# Default 2500 ms (≥ 750 + 200 + 200 + 100 = 1250 ms).
NEGELIR_SERVER_API_REQUEST_TIMEOUT_MS=2500                               
# Phase 9 §9.3 — transit jitter budget added to the timeout-budget inequality
# to absorb network/scheduling jitter between the API pod and bus/consensus.
# Must be ≥ 0. Default 100 ms.
NEGELIR_SERVER_API_TRANSIT_JITTER_MS=100                                 
# Phase 9 §9.1 — time discipline. Only "iso8601_utc" is accepted;
# validator rejects any other value. Placeholder for a future "rfc9557" flag.
NEGELIR_SERVER_API_TIME_FORMAT=iso8601_utc                               
# Phase 9 §9.1 — opaque cursor TTL in seconds (default 30 min).
# AES-GCM encrypted pagination cursors are rejected with 400 invalid_cursor
# after this many seconds. Rotated alongside JWT keys (§9.2).
NEGELIR_SERVER_API_CURSOR_TTL_S=1800                                     

# Phase 9 §9.1 — body-size cap (bcrypt-bomb / RAM-exhaustion defense, applied
# before handler dispatch via http.MaxBytesReader). Sub-caps must be ≤ the
# global cap; Validate() enforces this at startup.
# Global cap on every incoming request body (default 64 KB = 65536 bytes).
NEGELIR_SERVER_API_REQUEST_MAX_BYTES=65536                               
# /v1/qa body sub-cap (default 4 KB; tightened to reduce LLM prompt-injection surface).
NEGELIR_SWARM_QA_INPUT_MAX_BYTES=4096                                   
# /v1/auth/login body sub-cap (default 4 KB; blocks bcrypt-bomb payloads early).
NEGELIR_SERVER_AUTH_LOGIN_MAX_BYTES=4096

# Phase 9 §9.2 — bcrypt cost. OWASP 2024 floor is 12; valid range [10, 14].
# Startup probe hashes one test password at this cost; refuses boot if < 100 ms.
NEGELIR_SERVER_API_BCRYPT_COST=12                                        
# Phase 9 §9.2 — JWT RS256 key-store directory (private keys live here at mode 0400).
# DB (jwt_keys table, migration 014) is the source of truth; disk holds key material.
NEGELIR_SERVER_API_JWT_KEY_DIR=data/api/jwt_keys
# Phase 9 §9.2 — how often (seconds) each replica polls the keystore dir for new keys.
# The poll is an optimisation; DB lookup is the authoritative fallback on cache miss.
NEGELIR_SERVER_API_JWT_KEY_POLL_S=10                                     
# Phase 9 §9.2 — grace period (seconds) after a key is retired before its priv file is
# zeroized and removed. Must be >= api_access_ttl_s + 60 s. Default 960 s (900+60).
NEGELIR_SERVER_API_JWT_RETIRED_GRACE_S=960                               
# Phase 9 §9.14 — clock-skew tolerance for JWT exp/nbf validation (seconds).
# Tokens whose exp is in the past by at most this many seconds are still accepted,
# covering minor clock drift between issuer and verifier. OWASP: keep <= 60 s.
# Values > 300 s are rejected by Validate(). Default 30 s.
NEGELIR_SERVER_API_JWT_CLOCK_SKEW_S=30                                   
# Phase 9 §9.2 — token shape: access JWT TTL (seconds). Default 900 s (15 min).
NEGELIR_SERVER_API_ACCESS_TTL_S=900                                      
# Phase 9 §9.2 — token shape: refresh token TTL (seconds). Default 2592000 s (30 days).
NEGELIR_SERVER_API_REFRESH_TTL_S=2592000                                 
# Phase 9 §9.2 — token shape: replay grace window for single-use refresh tokens (seconds).
# Within this window a superseded refresh token is accepted once for idempotency.
# After the window a replay triggers 401 + sec.alert.v1{kind=refresh_token_replay}. Default 30 s.
NEGELIR_SERVER_API_REFRESH_REPLAY_GRACE_S=30                             
# Maximum JTIs in the access-token revocation deny-set (auth:rev:idx). Oldest entries
# are evicted (LRU) when the cap is exceeded. Alert fires at 80% via sec.alert.v1.
NEGELIR_SERVER_API_REVOCATION_SET_MAX=10000                              
# Phase 9 §9.2 — self-registration. When false (default), POST /v1/auth/register
# returns 403 forbidden. Set true to open registration (e.g. staging/onboarding).
NEGELIR_SERVER_API_SELF_REGISTRATION_ENABLED=false                       
# Per-/24 (IPv4) or /64 (IPv6) subnet cap on registrations per hour when
# self-registration is enabled. Prevents mass-account-spray. Default 20.
NEGELIR_SERVER_API_REGISTER_CAP_PER_SUBNET_PER_H=20                     
# Phase 9 §9.2 — mTLS to internal services.
# When true, the API dials Redis, Postgres, and the bus with a client cert from
# NEGELIR_SERVER_API_TLS_DIR, verified by the Phase 2 internal CA. Boot probe checks
# each connection before the public listener opens; hard boot refusal on failure.
# Set false for local dev (no certs required). Set true in staging/production.
NEGELIR_SERVER_API_MTLS_ENABLED=false
# Directory holding the API mTLS cert bundle (ca.crt, client_{redis,pg,bus}.{crt,key}).
# Private key files must be mode 0400. Default: data/api/tls
NEGELIR_SERVER_API_TLS_DIR=data/api/tls
# Phase 9 §9.3 — per-pod reply_to stream reaper interval (seconds).
# The API reaper sweeps orphaned api.reply.* Redis Streams left by requests
# that timed out or whose pod crashed. Streams are deleted when they are
# older than cfg.api_request_timeout_ms and still present. Default 60 s.
NEGELIR_SERVER_API_REPLY_REAPER_S=60                                     
# Phase 9 §9.3 — idempotency-key cache TTL (seconds). Completed idempotent
# requests are replayed from Redis cache for this duration when the client
# resends the same Idempotency-Key + body. Default 86400 s (24 h).
NEGELIR_SERVER_API_IDEMPOTENCY_TTL_S=86400                               
# Phase 9 §9.3 — inflight wait timeout (ms). Second request for the same
# Idempotency-Key while the first is processing blocks on a Redis pubsub
# channel for this duration before returning 425 too_early. Default 1500 ms.
NEGELIR_SERVER_API_IDEMPOTENCY_INFLIGHT_WAIT_MS=1500                     
# Phase 9 §9.9 — backpressure threshold for predict.request.v1.
# The §8.x scaler writes Redis key api:backpressure:on (TTL 30 s) when
# XLEN(predict.request.v1) exceeds this value. The API reads that flag to
# engage cache-only mode (GET passes to cache; POST /v1/qa → 425 too_early).
# The API never reads XLEN directly and never writes to the maint plane.
# Default 5000.
NEGELIR_SERVER_API_PREDICT_REQUEST_BACKLOG_HIGH=5000                     
# Phase 9 §9.9 — connection cap / concurrency semaphore.
# Maximum number of concurrently in-flight requests per API pod.
# ConcurrencyLimit middleware uses a buffered channel as a counting semaphore;
# overflow (all slots occupied) returns HTTP 503 immediately with X-Overflow: true.
# Default 5000.
NEGELIR_SERVER_API_MAX_CONCURRENT_REQUESTS=5000                          
# Phase 9 §9.9 — response-side backpressure (slow-client abort).
# When the handler has been waiting longer than this value (milliseconds) for
# the client's TCP send buffer to drain, the SlowClientAbort middleware sets
# status=499 client_disconnected and aborts the handler chain. This prevents
# goroutines from being blocked indefinitely on a slow or stalled client
# (DoS surface). The http.Server WriteTimeout (HTTP_WRITE_TIMEOUT_SEC) is the
# hard OS-level cutoff; this knob governs the semantic abort threshold.
# Default 5000 ms (5 s).
NEGELIR_SERVER_API_RESPONSE_WRITE_TIMEOUT_MS=5000                        
# Phase 9 §9.3 — stale-while-revalidate (SWR) cache knobs for the predictions endpoint.
# STALE_AFTER_S: age (seconds) above which a cache entry is served stale while an async
# predict.request refresh is triggered in the background. Default 30 s.
NEGELIR_SERVER_API_CACHE_STALE_AFTER_S=30                                
# MAX_AGE_S: age (seconds) above which a cache entry is treated as a cache miss (RPC
# issued). Must be > NEGELIR_SERVER_API_CACHE_STALE_AFTER_S. Default 300 s.
NEGELIR_SERVER_API_CACHE_MAX_AGE_S=300                                   
# SWR_INFLIGHT_MAX: pod-level cap on concurrent async SWR refresh goroutines.
# A Redis SETNX gate per (match_id, market_set) limits to 1 inflight per pair;
# this counter caps total goroutines across the pod. Default 64.
NEGELIR_SERVER_API_SWR_INFLIGHT_MAX=64                                   
# Phase 9 §9.7 — burst budget. Per-subject GCRA token-bucket capacity (max tokens
# accumulated while the client is idle). Cost-aware: /v1/qa costs 5 tokens,
# /v1/healthz costs 0 (per endpoint_costs.yaml). Default 60.
NEGELIR_SERVER_API_BURST_CAPACITY=60                                     
# Tokens added to each subject's bucket per second of idle time. Default 2.0.
NEGELIR_SERVER_API_BURST_REFILL_PER_S=2.0                                
# Phase 9 §9.7 — tier quota enforcement flag. Built-but-dormant until Phase 20.
# When false (the default) the TierQuota middleware is a no-op pass-through.
# Set true to enforce per-tier daily_request_cap from the tiers table.
NEGELIR_SERVER_API_TIER_ENFORCEMENT_ENABLED=false                        
# Phase 9 §9.2 — OIDC plug-point.
# These three vars are checked by auth.LoadProvider() at startup. When ALL are
# absent (the default) LoadProvider returns the NoopProvider and OIDC routes
# return 501 Not Implemented. Phase 20+ will wire a real provider here.
# FORBIDDEN in v1: bundling Google / Microsoft / GitHub SDKs (doctrine §9.2).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Phase 9 §9.15 / Phase 11 (compute) boundary — the API binary is built cpu_only;
# cgo CUDA paths are excluded at compile time via the //go:build cpu_only tag on
# cmd/api/main.go. The only valid value is "cpu_only". Phase 11 may extend this
# to "gpu_optional" under a feature flag.
NEGELIR_COMMON_COMPUTE_CLASS=cpu_only

# Phase 9 §9.8 — RED metrics (Prometheus). The /metrics endpoint is served on
# a dedicated internal-only port, NOT the public API port, to prevent accidental
# exposure. Validate() rejects this value if it collides with SERVER_PORT.
# Python AI pipeline (ai/common/config.py) also reads this key to avoid port
# collisions when both processes run on the same host. Default: 9091 (Go API).
NEGELIR_COMMON_TELEMETRY_METRICS_PORT=9091                               
# Phase 9 §9.8 — cardinality cap. The boot validator estimates worst-case series
# count for api_requests_total (routes x status(8) x method(3) x cache(4) x
# degraded(2)) and refuses to start if the estimate exceeds this value. Default
# 10000 (the 30-route spec example produces 5760, well under the cap).
NEGELIR_COMMON_TELEMETRY_MAX_SERIES=10000
# Phase 9 §9.8 — structured access log sampling. Percentage of 2xx responses
# written to the JSON access log on stderr. Range [0, 100]. 4xx/5xx are always
# logged regardless of this value. Default 10 (prod-safe); set 100 in dev/test.
NEGELIR_SERVER_API_LOG_SAMPLE_PCT=10                                     
# Phase 9 §9.8 — OTLP gRPC trace export. Format: "host:port" (no scheme).
# When empty (the default) the tracing subsystem is a no-op: no goroutines,
# no connections, no stdout dump. Set to the OTel Collector sidecar address
# when trace export is desired (e.g. "otelcol:4317").
NEGELIR_COMMON_TELEMETRY_OTLP_ENDPOINT=
# Phase 9 §9.8 — SLO burn-rate alert knobs (multi-window multi-burn-rate,
# Google SRE Workbook recipe). APISLOBurnWindowS is both the long evaluation
# window and the BurnRateMonitor check interval (seconds). The short window is
# BurnWindowS/12 (300 s at the default 3600 s). APISLOBurnThreshold is the
# error-budget-consumption multiple that triggers a warn alert via
# sec.alert.v1{kind=api_slo_burn}; critical fires at 3x the threshold (default 6.0).
NEGELIR_SERVER_API_SLO_BURN_WINDOW_S=3600                                
NEGELIR_SERVER_API_SLO_BURN_THRESHOLD=2.0                                
# Phase 9 §9.11 -- deprecation window (days). Minimum days between x-deprecated-on
# and the 410 Gone date (x-sunset-on, or derived from this value when absent).
# The DeprecationHeaders middleware uses this as fallback. Must be >= 1. Default 90.
NEGELIR_SERVER_API_DEPRECATION_WINDOW_DAYS=90                            
# Phase 9 §9.11 -- schema-version stamp. Injected into every JSON response as
# meta.schema_version by SchemaVersionMiddleware. Bumps additively with each
# server minor version per chart.json. Client SDKs key cache invalidation on
# this value. Must be >= 1. Default 1.
NEGELIR_SERVER_API_SCHEMA_VERSION=1                                      
# Phase 9 §9.12 — fixture window / allowed markets / trusted proxies.
# Maximum days ahead a fixture query may request. Default 14.
NEGELIR_SERVER_API_FIXTURE_WINDOW_MAX_DAYS=14                            
# Comma-separated market codes accepted by the API. Default: ms,au_2.5,btts,ah_home,modal_score.
NEGELIR_SERVER_API_ALLOWED_MARKETS=ms,au_2.5,btts,ah_home,modal_score   
# Comma-separated trusted reverse-proxy CIDRs/IPs. Empty = no trusted proxies.
NEGELIR_SERVER_API_TRUSTED_PROXIES=                                      

# Phase 9 §9.17.1 — Go runtime tuning knobs (refuse-to-start gates).
# GOMEMLIMIT: mebibytes to pass to debug.SetMemoryLimit. 0 = derive from
# cgroup memory.max at 80%. Refuse boot if cgroup unreadable AND value=0.
NEGELIR_SERVER_API_GO_MEM_LIMIT_MIB=0                                   
# GOGC: GC target percentage. Default 50 (Go default 100 is too lazy under
# JSON encode + Redis pipeline allocation pattern).
NEGELIR_SERVER_API_GO_GC_PERCENT=50                                     
# HTTP server timeout knobs (Slowloris / idle-fd defense).
# ReadHeaderTimeout: time to read the HTTP request header. Default 5 s.
NEGELIR_SERVER_API_READ_HEADER_TIMEOUT_MS=5000                          
# ReadTimeout: time to read the full request. Default 10 s.
NEGELIR_SERVER_API_READ_TIMEOUT_MS=10000                                
# WriteTimeout: time to write the full response. Must exceed
# api_request_timeout_ms + api_response_write_timeout_ms. Default 15 s.
NEGELIR_SERVER_API_WRITE_TIMEOUT_MS=15000                               
# IdleTimeout: keep-alive idle connection timeout. Default 60 s.
NEGELIR_SERVER_API_IDLE_TIMEOUT_MS=60000                                
# Graceful shutdown grace period (SIGTERM → server.Shutdown). Default 30 s.
NEGELIR_SERVER_API_SHUTDOWN_GRACE_S=30                                  
# In-mesh H2C listener port (in-cluster sidecar, behind mTLS). 0 = disabled.
NEGELIR_SERVER_API_IN_MESH_PORT=8082                                    

# Phase 9 §9.17.3 — Connection pool sizing.
# PostgreSQL pgxpool knobs (all Go-server-only; mirrored in ai/common/config.py
# and ai/common/defaults.yaml for the single-source-config doctrine).
# Maximum open PG connections per API pod. Default 25.
NEGELIR_SERVER_API_PG_POOL_MAX_CONNS=25                                 
# Read-replica URL (postgres://...). Empty = disabled (built but dormant).
NEGELIR_SERVER_API_PG_REPLICA_URL=                                      
# How often to check replica lag (seconds). Active only when replica URL is set.
NEGELIR_SERVER_API_PG_REPLICA_LAG_CHECK_S=10                            
# Max acceptable replica lag before falling back to primary (milliseconds).
NEGELIR_SERVER_API_PG_REPLICA_LAG_MAX_MS=500                            
# Redis cache client pool size (PoolTimeout=100ms, MinIdleConns=10). Default 50.
NEGELIR_SERVER_API_REDIS_CACHE_POOL_SIZE=50                             
# Redis bus client pool size (XREAD streams, ReadTimeout=request_timeout+500ms). Default 20.
NEGELIR_SERVER_API_REDIS_BUS_POOL_SIZE=20                               

# ── Phase 9 §9.17.4 — Resilience: circuit breakers, bulkheads, hedging, retry budgets ──
# Circuit breaker knobs (sony/gobreaker). One breaker per upstream: pg, redis_cache, redis_bus, swarm_rpc.
# Failure fraction (0.0–1.0) that trips the breaker. Default 0.5.
NEGELIR_SERVER_API_BREAKER_FAIL_RATIO=0.5                               
# Rolling window in seconds for counting requests. Default 10.
NEGELIR_SERVER_API_BREAKER_WINDOW_S=10                                  
# Minimum calls before the breaker may trip. Default 20.
NEGELIR_SERVER_API_BREAKER_MIN_REQUESTS=20                              
# Seconds the breaker stays open before admitting one probe. Default 15.
NEGELIR_SERVER_API_BREAKER_OPEN_S=15                                    
# Hedged RPC: delay (ms) after primary RPC before issuing a hedge request. Default 200.
NEGELIR_SERVER_API_HEDGE_AFTER_MS=200                                   
# Master switch for hedged cache-miss RPC. Default true.
NEGELIR_SERVER_API_HEDGING_ENABLED=true                                 
# Maximum percentage of RPCs that may be hedged. Default 10 (10%).
NEGELIR_SERVER_API_HEDGE_BUDGET_PCT=10                                  
# Retry budget token-bucket: tokens per second. Default 10.
NEGELIR_SERVER_API_RETRY_BUDGET_PER_S=10                                
# Retry budget burst capacity (max tokens). Default 50.
NEGELIR_SERVER_API_RETRY_BUDGET_CAPACITY=50                             
# Phase 9 §9.17.5 — target RPS for `make api.bench` (k6 constant-arrival-rate driver). Default 200.
NEGELIR_SERVER_API_BENCH_TARGET_RPS=200                                 

# ── Phase 9 §9.17.6 — In-process L0 LRU cache ──────────────────────────────
# Maximum number of entries in the per-pod L0 LRU cache. Default 10000.
NEGELIR_SERVER_API_L0_CACHE_MAX_ENTRIES=10000
# Soft byte-usage cap for the L0 cache. Default 67108864 (64 MiB).
NEGELIR_SERVER_API_L0_CACHE_MAX_BYTES=67108864
# Per-entry TTL cap (seconds). Effective TTL = min(L1 TTL, this). Default 5.
NEGELIR_SERVER_API_L0_MAX_TTL_S=5
# TTL for 404/410 negative-cache entries (seconds). Default 10.
NEGELIR_SERVER_API_NEGATIVE_CACHE_S=10                                  
# Max milliseconds a stampede-waiting goroutine blocks before falling through
# to a direct fetch. Default 200.
NEGELIR_SERVER_API_L0_REFRESH_MAX_WAIT_MS=200
# SLO target for keyspace-notification eviction lag (ms). Violations emit a
# sec.alert.v1 event. Default 500.
NEGELIR_SERVER_API_L0_INVALIDATION_LAG_MAX_MS=500

# ── Phase 9 §9.17.7 — Audit pipeline performance ───────────────────────────
# Max rows per Redis pipeline flush. Default 64.
NEGELIR_SERVER_API_AUDIT_BATCH_MAX=64                                    
# Max milliseconds to accumulate before flush. Default 10.
NEGELIR_SERVER_API_AUDIT_BATCH_MAX_MS=10                                 
# Bounded channel capacity for the audit shipper goroutine. Default 4096.
NEGELIR_SERVER_API_AUDIT_CHAN_CAP=4096                                   
# 2xx sample percentage when channel is >80% full for >5s. 4xx/5xx and
# sec-relevant events always bypass sampling. Default 10.
NEGELIR_SERVER_API_AUDIT_SAMPLE_PCT_UNDER_PRESSURE=10                   

# Phase 9 §9.17.8 — TCP_USER_TIMEOUT (Linux only).
# Sets TCP_USER_TIMEOUT on every accepted connection. 0 = kernel default.
# Default 20000 ms (20 s). Rotated via: make api.rotate-tls-session-key
NEGELIR_SERVER_API_TCP_USER_TIMEOUT_MS=20000                            

# Phase 9 §9.17.9 — Backpressure feedback loops.
NEGELIR_SERVER_API_ADAPTIVE_ERROR_RATE_THRESHOLD=0.02                   
NEGELIR_SERVER_API_ADAPTIVE_SHED_FACTOR=0.5                             
NEGELIR_SERVER_API_ADAPTIVE_SHED_DURATION_S=60                          
NEGELIR_SERVER_API_PRIORITY_TIER_FLOOR=0                                

# Phase 9 §9.17.10 — Observability for performance.
# pprof endpoint on the metrics port (:9091/debug/pprof/*) — NEVER on the
# public listener. Dev default: enabled. Prod default: disabled.
# Short-lived override: make api.pprof-enable POD=<name> (Redis TTL 1h).
NEGELIR_SERVER_API_PPROF_ENABLED_DEV=true                            
NEGELIR_SERVER_API_PPROF_ENABLED_PROD=false                          
# Fraction of requests sampled for allocation delta tracking (0=off, 1=all).
# Default 0.001 (1 in 1000). p99 > 50 KiB → sec.alert.v1{kind=api_alloc_regression}.
NEGELIR_SERVER_API_ALLOC_SAMPLE_RATE=0.001                           
# Base directory for continuous CPU profile files (<dir>/<hostname>/<utc>.pprof.gz).
NEGELIR_SERVER_API_PPROF_DIR=data/api/profiles                      


# The proofreader replica roster is *not* a config knob — it lives in
# `swarm.agents.proofreader.replicas.PROOFREADER_POLICY_CLASSES` (one
# entry per distinct check policy: sanity, plausibility, consistency).
# `cfg.proofreader_quorum` derives quorum (⌊N/2⌋+1) from len(roster)
# so the two cannot drift. Phase-6 audit F3-1 retired the standalone
# NEGELIR_SWARM_PROOFREADER_REPLICAS env knob — it was disconnected from the
# roster and silently broke quorum at any value other than 3.
# Horizontal fan-out moves to consumer-group sharding (Phase 14).
# How long the aggregator waits, after seeing the first verdict for a
# (request_id, prediction_id), before declaring "no quorum" and dropping
# the candidate. The API SLA budget includes this window via
# NEGELIR_SERVER_API_CONSENSUS_OVERHEAD_MS, which must be ≥ this value.
NEGELIR_SWARM_PROOFREADER_QUORUM_WINDOW_MS=200                          
# Phase-6 audit (F-9): LRU bound on the aggregator's `_pending` map.
# Without it, verdicts that never reach quorum (or arrive past the
# window) leak memory between flush ticks. Mirrors
# NEGELIR_SWARM_CONSENSUS_MAX_PENDING since the per-prediction shape is
# comparable.
NEGELIR_SWARM_PROOFREADER_AGGREGATOR_MAX_PENDING=4096
# Phase-6 audit (F-2): how often AgentRunner ticks `flush_expired`
# on aggregator-style agents (consensus, proofreader_aggregator) when
# no new message arrived to drive `handle()`. Without this knob,
# windows never expire and `no_quorum` candidates leak. 100 ms keeps
# tick jitter well under NEGELIR_SWARM_PROOFREADER_QUORUM_WINDOW_MS / 2.
NEGELIR_SWARM_FLUSH_INTERVAL_MS=100

# Per-replica check thresholds (§6.2). Each individual proofreader
# (sanity / plausibility / consistency) reads its own knob:
#
# - SANITY_EPS: how far market_outcomes may drift from summing to 1.0
#   before the sanity replica votes "reject". 0.01 absorbs float
#   rounding from consensus + calibration without masking real bugs.
# - PLAUSIBILITY_MAX_PROB: cap on any single outcome probability
#   above which the plausibility replica votes "warn" (operator-
#   visible yes-vote — counts toward quorum). 0.85 catches lopsided
#   derby calls without flagging legitimate one-sided fixtures.
# - GRID_CONSISTENCY_TOL: per-outcome tolerance between score_grid
#   marginals and market_outcomes. Beyond this the consistency
#   replica votes "reject" (the predictor produced two inconsistent
#   views of the same prediction).
NEGELIR_SWARM_PROOFREADER_SANITY_EPS=0.01
NEGELIR_SWARM_PROOFREADER_PLAUSIBILITY_MAX_PROB=0.85
NEGELIR_SWARM_PROOFREADER_GRID_CONSISTENCY_TOL=0.05

# Drift agent (§6.3). Maintains rolling Brier/log-loss windows per
# (predictor, league, market) and emits `maint.event.v1` with
# kind=retrain_request when the floor is breached or a KS-test on
# input features rejects stationarity.
#
# - WINDOW_SIZE: number of realized outcomes per rolling window. 50
#   balances "react fast to a regression" against "don't fire on a
#   5-game variance blip".
# - BRIER_CEILING: Brier (and log-loss) ceiling. 0.30 is the project's
#   documented "anything worse is dart-throwing-chimp" line. Lower
#   Brier = better, so the agent trips when the rolling mean *exceeds*
#   this value. Distinct from the legacy NEGELIR_DATASOURCE_DRIFT_FLOOR above
#   (which is an *accuracy* floor for ai/model/drift.py).
# - PVALUE: KS-test threshold; below this the feature distribution is
#   declared non-stationary and a retrain_request is emitted with
#   reason=feature_ks. 0.01 keeps false positives near 1%.
NEGELIR_DATASOURCE_DRIFT_WINDOW_SIZE=50
NEGELIR_DATASOURCE_DRIFT_BRIER_CEILING=0.30
NEGELIR_DATASOURCE_DRIFT_PVALUE=0.01
NEGELIR_DATASOURCE_DRIFT_MAX_PENDING=100000
NEGELIR_DATASOURCE_DRIFT_MAX_SETTLED=100000

# ── Phase 7 — Defense agents (sec.input.v1 / sec.scrape.v1 / sec.rate.v1) ──
# Foundation knobs (topics, payloads, JSON schemas, config). Agent logic
# follows in §7.1 / §7.2 / §7.3. The `test_python_defaults_match_env_example`
# gate enforces every value below matches `ai/common/config.py` byte-for-byte.
#
# sec.input.v1 (§7.1). MAX_LEN is **bytes after UTF-8 encoding**, NOT
# codepoints — the byte count stresses Redis & the classifier tokenizer.
# DEVICE accepts {auto,cpu,cuda,rocm,npu}; BATCH_ENABLED accepts
# {auto,true,false}.
NEGELIR_SERVER_SEC_INPUT_MAX_LEN=8192                                 
NEGELIR_SERVER_SEC_INPUT_GATEWAY_MAX_LATENCY_MS=10                     
NEGELIR_SERVER_SEC_INPUT_CLASSIFIER_MAX_LATENCY_MS=100
NEGELIR_SERVER_SEC_INPUT_CLASSIFIER_DEVICE=auto
NEGELIR_SERVER_SEC_INPUT_CLASSIFIER_PATH=
NEGELIR_SERVER_SEC_INPUT_CLASSIFIER_BATCH_ENABLED=auto
NEGELIR_SERVER_SEC_INPUT_CLASSIFIER_BATCH_SIZE=8
NEGELIR_SERVER_SEC_INPUT_CLASSIFIER_BATCH_WINDOW_MS=20
NEGELIR_SERVER_SEC_INPUT_CLASSIFIER_MAX_PENDING=256
NEGELIR_SERVER_SEC_INPUT_BREAKER_OPEN_S=30
NEGELIR_SERVER_SEC_INPUT_PATTERN_RELOAD_S=30                           
NEGELIR_SERVER_SEC_INPUT_ALLOWLIST_RELOAD_S=60                          # §8.7 pattern_allowlist read cache
NEGELIR_SERVER_SEC_INPUT_ALLOWLIST_HMAC_KEY_PATH=/var/lib/negelir/secrets/allowlist_hmac.key
NEGELIR_SERVER_SEC_INPUT_ALLOWLIST_HMAC_KEY_MAX_AGE_DAYS=365

# sec.quarantine.v1 + storage backpressure (§7.1 + §7.5). PAYLOAD_MAX_BYTES
# is the cap BEFORE base64 encoding; on-the-wire envelope is ~4/3 larger.
NEGELIR_SERVER_SEC_QUARANTINE_TTL_DAYS=30
NEGELIR_SERVER_SEC_QUARANTINE_PAYLOAD_MAX_BYTES=65536                  
NEGELIR_SERVER_SEC_QUARANTINE_PRODUCER_QUEUE_MAX=1000
NEGELIR_SERVER_SEC_QUARANTINE_STORAGE_LAG_ALERT_MS=5000

# sec.scrape.v1 (§7.2). Streaming-statistic baseline (Welford / P² /
# count-min sketch) — there is intentionally NO per-source raw-sample cap.
# SIMHASH_MAX_DISTANCE is in bits-out-of-64 (>=32 ≈ never trip).
NEGELIR_SERVER_SEC_SCRAPE_SIZE_DELTA_PCT=200.0
NEGELIR_SERVER_SEC_SCRAPE_INFLATE_RATIO_MAX=50.0
NEGELIR_SERVER_SEC_SCRAPE_WARMUP_SAMPLES=50
NEGELIR_SERVER_SEC_SCRAPE_BASELINE_FLUSH_S=300
NEGELIR_SERVER_SEC_SCRAPE_MAX_PENDING=4096
# F7.3: dedicated cap for the SecScrapeAgent content-addressed dedup
# map ((source, bytes_sha256) LRU). Distinct from MAX_PENDING (which
# bounds the future async-scoring queue). Default matches MAX_PENDING
# so behaviour is unchanged out of the box; tune independently when
# replay-window characteristics demand it.
NEGELIR_SERVER_SEC_SCRAPE_DEDUP_WINDOW=4096
NEGELIR_SERVER_SEC_SCRAPE_SIMHASH_MAX_DISTANCE=12
NEGELIR_SERVER_SEC_SCRAPE_DOM_FINGERPRINT_MAX_NODES=5000
# F7.4: bounded ring of recent per-source SimHash fingerprints. Drift
# trips when the MIN Hamming distance over the ring exceeds the
# threshold above — not the adjacent-pair distance. Tolerates
# legitimate A/B-test layout oscillation post-warmup at the cost of
# one transient false trip when a genuinely-new layout first lands.
NEGELIR_SERVER_SEC_SCRAPE_SIMHASH_RING_SIZE=8

# sec.rate.v1 (§7.3). Pre-auth caps protect /v1/auth/* against credential
# stuffing; post-auth caps are looser. IPv6 prefix /64 = end-site allocation
# boundary (a single IPv6 allocation cannot spray 2^64 unique buckets).
# TRUSTED_PROXIES is a comma-separated list of CIDRs; empty = trust no proxies.
NEGELIR_SERVER_SEC_RATE_PRE_AUTH_CAPACITY=30                           
NEGELIR_SERVER_SEC_RATE_PRE_AUTH_REFILL_PER_S=0.5                      
NEGELIR_SERVER_SEC_RATE_POST_AUTH_CAPACITY=600                         
NEGELIR_SERVER_SEC_RATE_POST_AUTH_REFILL_PER_S=5.0                     
NEGELIR_SERVER_SEC_RATE_BUCKET_IDLE_TTL_S=3600                         
NEGELIR_SERVER_SEC_RATE_MAX_SUBJECTS=100000
NEGELIR_SERVER_SEC_RATE_IPV4_PREFIX=32
NEGELIR_SERVER_SEC_RATE_IPV6_PREFIX=64
NEGELIR_SERVER_SEC_RATE_TRUSTED_PROXIES=                               
NEGELIR_SERVER_SEC_RATE_REDIS_TIMEOUT_MS=50                            
NEGELIR_SERVER_SEC_RATE_SECONDARY_CAPACITY=300                         
NEGELIR_SERVER_SEC_RATE_SECONDARY_REFILL_PER_S=5.0                     
NEGELIR_SERVER_SEC_RATE_DEFAULT_COST=1                                 
NEGELIR_SERVER_SEC_RATE_EVICTION_RATE_ALERT_PER_S=50.0
NEGELIR_SERVER_SEC_RATE_EVICTION_RATE_WINDOW_S=60

# Sliding-window burst detector (§7.3) — uses time.monotonic() in-process.
NEGELIR_SERVER_SEC_BURST_THRESHOLD=100
NEGELIR_SERVER_SEC_BURST_WINDOW_MS=60000
NEGELIR_SERVER_SEC_BURST_DEDUP_WINDOW=10000

# Denylist (Redis hash; sole writer = sec.rate.v1) — §7.3.
NEGELIR_SERVER_SEC_DENYLIST_TTL_S=3600
NEGELIR_SERVER_SEC_DENYLIST_ESCALATION_FACTOR=2.0
NEGELIR_SERVER_SEC_DENYLIST_MAX_ENTRIES=250000                         

# sec.alert.v1 envelope (§7.4). Generalized debounce TTL (per (kind,subject)
# tuple in Redis) avoids alert storms from repeated identical events.
# Critical-severity alerts bypass debounce by default (set ENABLED=true to
# subject critical alerts to debounce too).
NEGELIR_SERVER_SEC_ALERT_DEBOUNCE_TTL_S=60
NEGELIR_SERVER_SEC_ALERT_CRITICAL_DEBOUNCE_ENABLED=false
# F7.2: dedicated per-agent LRU cap for SecAlertDebouncer (kind,subject)
# buckets. Distinct from NEGELIR_SERVER_SEC_RATE_MAX_SUBJECTS (which sizes the
# rate agent's per-subject burst-window LRU). Lowering this knob during
# incident response will not affect the rate agent's subject capacity.
NEGELIR_SERVER_SEC_ALERT_DEBOUNCER_MAX_BUCKETS=4096

# qa.request.v1 — NLP-side dedup window (§7.5 binding). Two producers
# (Go gateway pass-through; sec.input.v1 post-classifier pass) emit the
# same request_id; NLP must dedup over this window.
NEGELIR_SWARM_QA_REQUEST_V1_DEDUP_WINDOW_S=300

# ── Phase 10 §10.0 — Turkish NLP pipeline (cross-phase contracts) ──────────
# §10.1 step 1: hard codepoint cap on raw user input (defense-in-depth).
# Codepoint-based so Turkish multi-byte chars are not double-counted.
# sec_input_max_len (bytes) is the floor.
NEGELIR_SWARM_NLP_INPUT_MAX_CODEPOINTS=512
# Dedup window: must be >= NEGELIR_SWARM_QA_REQUEST_V1_DEDUP_WINDOW_S(300) + 30.
# Boot validator refuses start on violation (Phase 10 §10.0 cross-phase contract).
NEGELIR_SWARM_NLP_REQUEST_DEDUP_WINDOW_S=330
# nlp_intake_workers: intake-stage parallelism for NLP pods.
#   Must be >=2 and <= 2 × os.cpu_count() to avoid oversubscription deadlock.
NEGELIR_SWARM_NLP_INTAKE_WORKERS=8
# Phase 10 §10.21.8 citation integrity: HMAC key file used to sign
# predict.approved.v1 citation payloads. Production mode: 0400.
NEGELIR_SWARM_PREDICT_CITATION_HMAC_KEY_PATH=/var/lib/negelir/secrets/predict_citation_hmac.key
# Phase 10 §10.21.8 citation key rotation dual-acceptance window (seconds).
# NLP accepts signatures from <key_path>.prev while current key file age <= this window.
NEGELIR_SWARM_PREDICT_CITATION_HMAC_KEY_GRACE_S=86400
# Phase 10 §10.21.8 consume-side signature verification mode.
# off=skip verification, warn=render+alert on invalid/missing, enforce=drop+timeout template.
NEGELIR_SWARM_NLP_PREDICT_CITATION_HMAC_REQUIRED=warn
# Phase 10 §10.29.12 prediction-id determinism verification mode.
# off=skip verification, warn=alert on invariant mismatch, enforce=drop+timeout template.
NEGELIR_SWARM_NLP_PREDICT_PREDICTION_ID_DETERMINISM_REQUIRED=warn
# Phase 10 §10.23.1 per-tenant intake fair-queue key.
# Values: tenant_id | account_id | ip_bucket. Default account_id.
NEGELIR_SWARM_NLP_FAIRNESS_KEY=account_id
# Per-key inflight intake-slot cap; over-cap keys queue behind their own slots.
NEGELIR_SWARM_NLP_PER_TENANT_INFLIGHT_MAX=8
# Cardinality cap for tracked fairness keys; oldest key is evicted (LRU).
NEGELIR_SWARM_NLP_FAIRNESS_MAX_TRACKED_KEYS=10000
# Sustained per-key intake-QPS threshold for observability-only abuse alerting.
NEGELIR_SWARM_NLP_TENANT_ABUSE_QPS_THRESHOLD=10
# Rolling window (seconds) used by per-key intake abuse detection.
NEGELIR_SWARM_NLP_TENANT_ABUSE_WINDOW_S=60
# Bus circuit breaker (Phase 10 §10.13): consecutive publish failures before
# transitioning to bus_degraded state and spooling to disk.  Range: 1–10. Default: 3.
NEGELIR_SWARM_NLP_BUS_FAILURE_CIRCUIT_THRESHOLD=3
# Max spool entries per NLP agent before dropping oldest (overflow cap).
# Range: 1–100000. Default: 1000.
NEGELIR_SWARM_NLP_SPOOL_MAX_ENTRIES=1000
# Per-agent spool directory root.  Agents create subdirs under this path.
# Each NLP agent writes {ms}-{msg_id}.envelope.json entries to its subdir.
# Default: "data/nlp/spool" (relative to repo root).
NEGELIR_SWARM_NLP_AGENT_SPOOL_DIR=data/nlp/spool
# Strip potentially sensitive text from qa.intent.v1 spool payloads.
# When true, spool entries replace payload.sanitized_text with
# payload.sanitized_text_sha256. Default: true.
NEGELIR_SWARM_NLP_SPOOL_PAYLOAD_PII_STRIP=true
# Timeout chain extending Phase 9 §9.17.4 deadline-propagation guard:
#   NEGELIR_SERVER_API_REQUEST_TIMEOUT_MS >= NLP_PIPELINE_TIMEOUT_MS + NLP_DISPATCH_OVERHEAD_MS
#   NLP_PIPELINE_TIMEOUT_MS >= CONSENSUS_WINDOW_MS + NLP_CONSENSUS_OVERHEAD_MS
#                              [+ NLP_HUMANIZER_MAX_LATENCY_MS when NLP_HUMANIZE=true]
# Boot validator refuses start on either violation.
NEGELIR_SWARM_NLP_PIPELINE_TIMEOUT_MS=1800
NEGELIR_SWARM_NLP_DISPATCH_OVERHEAD_MS=200
# §10.28 operator flame capture minimum overhead floor as % of budget.
NEGELIR_SWARM_NLP_FLAME_CAPTURE_OVERHEAD_FLOOR_PCT=5.0
NEGELIR_SWARM_NLP_CONSENSUS_OVERHEAD_MS=100
# Per-request NLP CPU budget for non-humanizer requests (Phase 10 §10.28).
NEGELIR_SWARM_NLP_PER_REQUEST_CPU_BUDGET_MS=200
# Per-request NLP CPU budget when the optional humanizer is active.
NEGELIR_SWARM_NLP_PER_REQUEST_CPU_BUDGET_WITH_HUMANIZER_MS=800
# Minimum allowed per-request CPU budget to avoid accidental zeroing.
NEGELIR_SWARM_NLP_PER_REQUEST_CPU_BUDGET_MIN_MS=50
# Per-request NLP RSS budget (Phase 10 §10.28).
NEGELIR_SWARM_NLP_PER_REQUEST_RSS_BUDGET_MB=128
NEGELIR_SWARM_NLP_PER_REQUEST_RSS_BUDGET_SWAP_GRACE_MB=64
# §10.35 kill-pattern arm capacity for operator emergency interventions.
NEGELIR_SWARM_NLP_KILL_PATTERN_ARM_MAX_CONCURRENT=8
# Lexicon rebuild concurrency/queue headroom (Phase 10 §10.28).
NEGELIR_SWARM_NLP_LEXICON_REBUILD_CONCURRENCY_MAX=2
NEGELIR_SWARM_NLP_LEXICON_REBUILD_QUEUE_MAX=8
NEGELIR_SWARM_NLP_LEXICON_REBUILD_RSS_RESERVATION_MB=200
NEGELIR_SWARM_NLP_LEAGUE_CATALOG_CONSONANT_STEMS_PATH=
# Budget for the optional ≤1B humanizer LLM (Phase 11 device-probed).
# Only counted in the pipeline inequality when NEGELIR_SWARM_NLP_HUMANIZE=true.
NEGELIR_SWARM_NLP_HUMANIZER_MAX_LATENCY_MS=600
# Circuit breaker open window (seconds) after humanizer latency breach.
# After breach → fall back to template, emit nlp.event.v1{kind=humanizer_disabled},
# open breaker for this duration (refuses humanize, emits breaker_open once).
NEGELIR_SWARM_NLP_HUMANIZER_BREAKER_OPEN_S=60
# Humanizer circuit breaker scope: "pod" (default, per-pod in-memory) or
# "cluster" (Redis-backed, cross-pod coordination). Phase 10 §10.21.4.
# Per-pod is the default; cluster-scope adds a Redis round-trip on every
# humanize call → only flip after measuring per-pod breaker open-rate above 5%
# (stampede-protection in dense replica deployments).
NEGELIR_SWARM_NLP_HUMANIZER_BREAKER_SCOPE=pod
# §10.23.1 per-tenant humanizer budget (token bucket keyed by fairness key).
# Over-budget requests degrade to template-only answer (no user-facing error).
NEGELIR_SWARM_NLP_PER_TENANT_HUMANIZER_BURST=4
NEGELIR_SWARM_NLP_PER_TENANT_HUMANIZER_REFILL_PER_S=2
NEGELIR_SWARM_NLP_HUMANIZER_REQUEST_RATE=0.6
NEGELIR_SWARM_NLP_HUMANIZER_BUDGET_REDIS_KEY_PREFIX=nlp:humanizer:budget:
# Enable optional humanizer LLM for answer polish (never a decision-maker).
# Default false: deterministic templates are both floor and ceiling.
NEGELIR_SWARM_NLP_HUMANIZE=false
NEGELIR_SWARM_NLP_ANSWER_STREAMING=disabled
NEGELIR_SWARM_NLP_STREAMING_PROOFREAD_CHUNK_CHARS=80
NEGELIR_SWARM_NLP_STREAMING_WRITE_TIMEOUT_MS=2000
NEGELIR_SWARM_NLP_OUTPUT_GRAMMAR_VALIDATOR_P99_MS=15
NEGELIR_SWARM_NLP_OUTPUT_GRAMMAR_VALIDATOR_KILLSWITCH_ENABLED=false
NEGELIR_SWARM_NLP_DECORATIVE_SET=⚽,🏆,🟢,🔴,🟡
# When false, all emoji are stripped from plain and markdown_safe NLP answers
# by default. `screen_reader` continues to strip emoji regardless.
NEGELIR_SWARM_NLP_ANSWER_DECORATIVE_EMOJI_ENABLED=false
# Decoding constraints for humanizer LLM (Phase 10 §10.8).
# Max output tokens (cap on generation length). Must be >= 1. Default 120.
NEGELIR_SWARM_NLP_HUMANIZER_MAX_NEW_TOKENS=120
# Upper bound on humanizer tokens allowed per request (Phase 10 §10.23.8).
NEGELIR_SWARM_NLP_MAX_HUMANIZER_TOKENS_PER_REQUEST=120
# Upper bound on humanizer tokens allowed per tenant per minute (Phase 10 §10.23.8).
NEGELIR_SWARM_NLP_MAX_HUMANIZER_TOKENS_PER_TENANT_PER_MIN=2400
# Flat JSON mapping tier id -> allowed humanizer tokens per tenant per minute
# when monetization is enabled. Default free-tier floor is the value above.
NEGELIR_SWARM_NLP_TIER_HUMANIZER_TOKENS_PER_MIN={}
# Preview-mode operator token budget per hour.
NEGELIR_SWARM_NLP_PREVIEW_TOKEN_BUDGET_PER_OPERATOR_PER_H=2400
NEGELIR_SWARM_NLP_PREVIEW_DIR=data/nlp/preview
NEGELIR_SWARM_NLP_AGE_GATING_ENABLED=false
NEGELIR_SWARM_NLP_DISCLOSURE_LOCALE_FALLBACK_CHAIN=tr-TR
NEGELIR_SWARM_NLP_CALIBRATION_HORIZON_STRICT=true
# Upper bound on humanizer tokens allowed per pod per hour (Phase 10 §10.23.8).
NEGELIR_SWARM_NLP_MAX_HUMANIZER_TOKENS_PER_POD_PER_HOUR=720000
# Cooldown duration after pod budget exhaustion (seconds).
NEGELIR_SWARM_NLP_HUMANIZER_POD_COOLDOWN_S=300
# Cooldown after a humanizer subprocess crash before restart.
NEGELIR_SWARM_NLP_HUMANIZER_RESPAWN_COOLDOWN_S=30
# Sampling temperature [0.0, 2.0]. Lower = more deterministic. Default 0.3.
NEGELIR_SWARM_NLP_HUMANIZER_TEMPERATURE=0.3
# Nucleus sampling threshold [0.0, 1.0]. Default 0.9.
NEGELIR_SWARM_NLP_HUMANIZER_TOP_P=0.9
# Repetition penalty [1.0, 2.0]. Higher = less repetition. Default 1.05.
NEGELIR_SWARM_NLP_HUMANIZER_REPETITION_PENALTY=1.05
# Drift guard: max ratio of edit distance to template length [0.0, 1.0].
# Over-cap → discard, fall back to template, emit nlp.alert.v1{kind=nlp_humanizer_drift}.
# Default 0.6 (LLM is rephrasing, not authoring).
NEGELIR_SWARM_NLP_HUMANIZER_MAX_EDIT_RATIO=0.6
# p95 latency threshold (ms) for `make nlp.bench` CI gate.
# Phase 10 §10.1 DoD: normalize_input on nlp_input_max_codepoints-length input.
NEGELIR_SWARM_NLP_BENCH_LATENCY_P95_THRESHOLD_MS=5
# Hot-reload poll interval (seconds) for lexicon YAML files (§10.2 Atomic swap).
# LexiconStore checks file mtimes at most once every this many seconds.
NEGELIR_SWARM_NLP_LEXICON_RELOAD_S=30
# Number of unresolved tokens to retain in the rolling hourly top-k list.
# PII-scrubbed long tokens are stored as sha8-prefixed placeholders.
NEGELIR_SWARM_NLP_UNRESOLVED_TOKEN_TOP_K=50
# Rolling window duration (seconds) for unresolved token top-k aggregation.
NEGELIR_SWARM_NLP_UNRESOLVED_TOKEN_ROLLING_WINDOW_S=3600
# Threshold for lexicon coverage drift alerts (p50 floor per intent class).
NEGELIR_SWARM_NLP_LEXICON_COVERAGE_P50_FLOOR=0.6
# Maximum lexicon age (days) before a stale-coverage alert is expected.
NEGELIR_SWARM_NLP_LEXICON_MAX_AGE_DAYS=14
# Maximum entries per lexicon file (§10.2 Cardinality cap).
# Over-cap → dictionary_overflow warn alert + refuse load.
NEGELIR_SWARM_NLP_LEXICON_MAX_ENTRIES_PER_FILE=50000
# Maximum aliases per canonical in the alias delta build pipeline (§10.25.6).
# Over-cap → make nlp.lexicon-build fails with a clear per-canonical error.
NEGELIR_SWARM_NLP_LEXICON_MAX_ALIASES_PER_CANONICAL=12
# Maximum alias hash bucket load during lexicon shadow load (§10.34).
# Over-cap → lexicon_collision_load_high error alert + refuse swap.
NEGELIR_SWARM_NLP_LEXICON_MAX_COLLISION_LOAD=8
# Hard cap on added rows per lexicon file in a PR diff.
# `make verify.nlp-lexicon-diff` fails if any lexicon file adds more rows.
NEGELIR_SWARM_NLP_LEXICON_PR_MAX_ADDED_ROWS_PER_FILE=200
# Advisory threshold for lexicon PR diff additions.
NEGELIR_SWARM_NLP_LEXICON_PR_SOFT_WARN_ADDED_ROWS_PER_FILE=50
# Minimum corpus appearances required for a delta alias to ship.
NEGELIR_SWARM_NLP_LEXICON_MIN_ALIAS_APPEARANCES=3
# Total process RSS budget for loaded lexicons (§10.2 Bounded memory).
# Over-budget after shadow load → dictionary_overflow error alert + refuse swap.
# Set to 0 to disable the check.
NEGELIR_SWARM_NLP_LEXICON_MAX_RSS_MB=128
# Maximum retired snapshots retained for in-flight requests (§10.21.2 Old-
# generation eviction contract).  When a lexicon swap occurs, the old dict
# is added to a deque; oldest generations beyond this cap are dropped.
NEGELIR_SWARM_NLP_LEXICON_MAX_OLD_GENERATIONS=2
# Gossip interval in seconds for publishing nlp.gossip.v1 from each NLP pod.
NEGELIR_SWARM_NLP_LEXICON_GOSSIP_INTERVAL_S=300
# Minimum number of consecutive rounds a single pod may diverge from the
# cluster modal tuple before a critical lexicon divergence alert fires.
NEGELIR_SWARM_NLP_LEXICON_DIVERGENCE_MIN_ROUNDS=2
# Auto-quarantine divergent pods when a lexicon divergence alert fires.
NEGELIR_SWARM_NLP_LEXICON_DIVERGENCE_AUTO_QUARANTINE=true
# Maximum distinct NLP gossip pod ids allowed in the rolling gossip window.
NEGELIR_SWARM_NLP_GOSSIP_MAX_PODS=50
# Swap policy for multi-file lexicon reloads (§10.21.3 Atomic swap policy).
# Values: "all_or_nothing" (default) or "per_file".  Under "all_or_nothing",
# when any file changes, ALL files are loaded into shadow and validated via
# cross-file referential validator; if validation passes, the whole snapshot
# swaps atomically; else REVERT shadow + emit nlp.alert.v1{kind=nlp_lexicon_atomic_swap_failed}.
NEGELIR_SWARM_NLP_LEXICON_SWAP_ATOMICITY=all_or_nothing
NEGELIR_SWARM_NLP_LEXICON_SWAP_GRACE_S=120
NEGELIR_SWARM_NLP_LEXICON_SWAP_MAX_LAG_S=600
NEGELIR_SWARM_NLP_COMPLAINT_TRACE_DIR=data/nlp/complaint_traces
NEGELIR_SWARM_NLP_COMPLAINT_TRACE_DEFAULT_WINDOW_H=24
NEGELIR_SWARM_NLP_ABUSE_WINDOW_H=168
NEGELIR_SWARM_NLP_ABUSE_DYM_ACCEPTANCE_ANOMALY_RATIO=4.0
NEGELIR_SWARM_NLP_ABUSE_STYLE_SHIFT_KL=0.6
NEGELIR_SWARM_NLP_ABUSE_SHADOW_CONCENTRATION_DISTINCT_BUCKETS_MIN=5
NEGELIR_SWARM_NLP_ABUSE_ACCOUNT_FARM_JACCARD_MIN=0.5
NEGELIR_SWARM_NLP_ABUSE_ACCOUNT_FARM_ACCOUNT_COUNT_MIN=100
NEGELIR_SWARM_NLP_INTENT_TRAIN_MAX_ROWS_PER_SUBJECT_BUCKET=500
NEGELIR_SWARM_NLP_QA_ANSWER_MIN_SUPPORTED_VERSION=1                             
# QA Answer sunset policy (Phase 10).
# Retire QA answers first published before this UTC timestamp (RFC3339 format).
NEGELIR_SWARM_NLP_QA_ANSWER_SUNSET_ON_UTC=
# Window in days for the sunset grace period (answers continue to serve for this window).
NEGELIR_SWARM_NLP_QA_ANSWER_SUNSET_WINDOW_DAYS=182
# Highest lexicon feed schema version this NLP build accepts.
# Higher feed schemas are refused during reload, prior generation remains live,
# and nlp.alert.v1{kind=nlp_lexicon_feed_schema_too_new, severity=warn} fires.
NEGELIR_SWARM_NLP_LEXICON_FEED_MAX_SUPPORTED_SCHEMA_VERSION=1
# Lexicon source mode. file = in-repo lexicons with SHA-only integrity.
# feed = HMAC-signed bundles verified before load.
NEGELIR_SWARM_NLP_LEXICON_SOURCE=file
# Safe-mode fallback boot path: fall back to baked-in lexicon when primary load fails.
NEGELIR_SWARM_NLP_SAFE_MODE_FALLBACK_ENABLED=true
# Path to the directory containing lexicon YAML files.
NEGELIR_SWARM_NLP_LEXICON_DIR=ai/nlp/lexicon
# Path to the HMAC key used for signed lexicon bundles.
NEGELIR_SWARM_NLP_LEXICON_FEED_HMAC_KEY_PATH=infra/nlp/lexicon_feed_hmac.key
# Dual-acceptance grace window for the prior HMAC key after rotation.
NEGELIR_SWARM_NLP_LEXICON_FEED_HMAC_KEY_GRACE_S=86400
# Verification policy for lexicon feed signatures: off | warn | enforce.
NEGELIR_SWARM_NLP_LEXICON_FEED_SIGNATURE_REQUIRED=warn
# RSS budget for CRF entity tagger model (§10.21.2 RSS ceiling).
# Estimated memory footprint for the python-crfsuite model at runtime.
NEGELIR_SWARM_NLP_CRF_MAX_RSS_MB=5
# RSS budget for SymSpell edit-distance index (§10.21.2 RSS ceiling).
# Estimated memory footprint for the typo-correction dictionary.
NEGELIR_SWARM_NLP_SYMSPELL_MAX_RSS_MB=100
# RSS budget for Jinja2 bytecode cache (§10.21.2 RSS ceiling).
# Estimated memory footprint for precompiled template bytecode.
NEGELIR_SWARM_NLP_JINJA_CACHE_MAX_RSS_MB=50
# RSS budget for Python interpreter overhead (§10.21.2 RSS ceiling).
# Baseline memory for Python runtime, standard library, and dependencies
# (numpy, fasttext, jinja2, etc.) before NLP components are loaded.
NEGELIR_SWARM_NLP_PYTHON_OVERHEAD_MB=200
# RSS budget for humanizer ONNX model (§10.21.2 RSS ceiling).
# Estimated memory footprint for transformer weights, KV cache, and buffers.
NEGELIR_SWARM_NLP_HUMANIZER_MAX_RSS_MB=1024
# Total RSS ceiling per NLP pod (§10.21.2 RSS ceiling).
# Boot validator sums all sub-knobs (lexicons + intent model + crf + symspell
# + jinja cache + python overhead + humanizer) and refuses start if it exceeds
# this cap.  Catches operator over-tuning a sub-knob.
NEGELIR_SWARM_NLP_POD_RSS_MAX_MB=2048
# Directory path for Jinja2 bytecode cache (§10.21.2 precompiled templates).
# FileSystemBytecodeCache stores precompiled template bytecode with pattern
# __nlp_%s.cache to avoid repeated AST compilation in hot path.
NEGELIR_SWARM_NLP_JINJA_BCC_DIR=data/cache/jinja_bcc
# Minimum substring length for §10.21.6 runtime guard (finalize callable).
# Jinja2 finalize checks rendered values for user-text substrings ≥ this length
# (case-insensitive via casefold).  Must be ≥ 3 to skip article noise.
NEGELIR_SWARM_NLP_TEMPLATE_FINALIZE_MIN_USER_TEXT_LEN=6
# Global Levenshtein cap for tokens of length ≥ 5 in the SymSpell typo-
# correction step (§10.3).  Must be 1 or 2.  Shorter tokens use a smaller
# per-token budget (len 3-4 → 1, len ≤ 2 → 0 / exact-only).
NEGELIR_SWARM_NLP_TYPO_MAX_EDIT_DISTANCE=2
# Maximum number of fuzzy (edit_distance > 0) lookups allowed per query
# (§10.3 Per-query budget).  When exceeded the pipeline short-circuits and
# returns a "Did you mean?" signal instead of guessing.  Must be ≥ 1.
NEGELIR_SWARM_NLP_TYPO_MAX_LOOKUPS_PER_QUERY=8
# TTL for inferred keyboard layout hints when request.keyboard_hint is absent
# or explicitly unknown. Cache keys are hashed from client_id to avoid leaking
# raw client identifiers in logs.
NEGELIR_SWARM_NLP_IME_LAYOUT_CACHE_S=3600
NEGELIR_SWARM_NLP_ASR_FILLER_STRIP_MAX=6
NEGELIR_SWARM_NLP_PREAMBLE_MAX_STRIP_TOKENS=8
# Enable leading preamble stripping before normalization. Default true.
NEGELIR_SWARM_NLP_PREAMBLE_STRIP_ENABLED=true
# Enable closed-table predictive overshoot correction for known mobile keyboard
# auto-complete substitutions. Default true.
NEGELIR_SWARM_NLP_PREDICTIVE_OVERSHOOT_ENABLED=true
# Maximum number of predictive overshoot repairs allowed per query.
NEGELIR_SWARM_NLP_PREDICTIVE_OVERSHOOT_MAX_PER_QUERY=2
# Enable consonant-alternation tolerance before typo correction.
NEGELIR_SWARM_NLP_CONSONANT_ALTERNATION_ENABLED=true
# Enable suffix assimilation folding in particle normalization.
NEGELIR_SWARM_NLP_ASSIMILATION_FOLD_ENABLED=true
# Enable whole-word reduplication collapse for emphatic adjectives.
NEGELIR_SWARM_NLP_REDUPLICATION_COLLAPSE_ENABLED=true
# Enable inline self-correction and stutter handling before typo correction.
NEGELIR_SWARM_NLP_INLINE_SELF_CORRECTION_ENABLED=true
# Enable no-space compound splitting for concatenated Turkish tokens.
NEGELIR_SWARM_NLP_COMPOUND_SPLIT_ENABLED=true
# Enable vowel-drop-before-suffix detection and repair for dropped high vowels.
NEGELIR_SWARM_NLP_VOWEL_DROP_BEFORE_SUFFIX_ENABLED=true
# Enable TR-specific PII redaction before the length cap and classifier.
NEGELIR_SWARM_NLP_TR_PII_REDACT_ENABLED=true
# Maximum token count eligible for telegraphic intent inference.
NEGELIR_SWARM_NLP_TELEGRAPHIC_MAX_TOKENS=4
# Minimum gazetteer confidence for telegraphic intent inference.
NEGELIR_SWARM_NLP_TELEGRAPHIC_MIN_ENTITY_CONFIDENCE=0.85
# Enable deterministic telegraphic intent inference before the classifier.
NEGELIR_SWARM_NLP_TELEGRAPHIC_INFERENCE_ENABLED=true
# Enable context-aware disambiguation of the ki particle.
NEGELIR_SWARM_NLP_KI_CONTEXT_DISAMBIGUATION=true
# Path to the TR normalize parity spec.
NEGELIR_SWARM_NLP_TR_NORMALIZE_SPEC_PATH=ai/common/text/tr_normalize_spec.json
# Spec validation mode: off|warn|enforce.
NEGELIR_SWARM_NLP_TR_NORMALIZE_SPEC_REQUIRED=enforce
# Enable loanword transliteration variant resolution in the lexicon build.
NEGELIR_SWARM_NLP_LOANWORD_VARIANTS_ENABLED=true
# Enable loanword plural-as-singular rewrite for loanwords like linkler->link.
NEGELIR_SWARM_NLP_LOANWORD_SINGULARISATION_ENABLED=true
# Maximum number of closed meta-question entries accepted by the Phase 10
# routing lexicon. Prevents runaway table growth in the route-before-classify
# path.
NEGELIR_SWARM_NLP_META_QUESTION_TABLE_MAX=500
# Enable pre-classifier routing of closed meta questions. Set false only for
# testing or emergency rollback.
NEGELIR_SWARM_NLP_META_QUESTION_ROUTING_ENABLED=true
# Minimum corpus frequency for voice soft-g restoration in the diacritic path.
NEGELIR_SWARM_NLP_DIACRITIC_SOFTG_MIN_FREQ=500
# nlp_morph_topk: number of Zemberek-style candidate parses to retain per token
# in the morphology stage (§10.26.1 top-K parse acceptance). Must be ≥ 1.
NEGELIR_SWARM_NLP_MORPH_TOPK=3
# nlp_morph_min_confidence: confidence floor for morphology candidates.
# Parses below this threshold are flagged as high ambiguity (§10.26.1).
NEGELIR_SWARM_NLP_MORPH_MIN_CONFIDENCE=0.55
# nlp_morph_context_radius: token radius for morphology context arbitration.
# Must be ≥ 0.
NEGELIR_SWARM_NLP_MORPH_CONTEXT_RADIUS=4
# nlp_morph_ambiguous_max_per_query: high-ambiguity token budget before
# fallback to did_you_mean (§10.26.1). Must be ≥ 1.
NEGELIR_SWARM_NLP_MORPH_AMBIGUOUS_MAX_PER_QUERY=4
# nlp_productive_peel_max_depth: how many consecutive productive suffixes
# are peeled before giving up (§10.32.8).
NEGELIR_SWARM_NLP_PRODUCTIVE_PEEL_MAX_DEPTH=3
# nlp_productive_peel_min_residue_resolution: if true, productive peeling is
#   accepted only when the remaining residue resolves to a canonical reference.
NEGELIR_SWARM_NLP_PRODUCTIVE_PEEL_MIN_RESIDUE_RESOLUTION=true
# Maximum number of splits allowed when no-space Turkish compounds are
# broken into known words (§10.28.3). Must be ≥ 1.
NEGELIR_SWARM_NLP_COMPOUND_SPLIT_MAX_SPLITS=4
# Total lexicon lookup budget for compound splitting inside a single query
# (§10.28.3). Must be ≥ 1 and kept below typo budget for per-query pressure.
NEGELIR_SWARM_NLP_COMPOUND_SPLIT_MAX_LOOKUPS_PER_QUERY=24
# Diacritic ambiguity tie-break ratio (§10.3 Ambiguity policy).
# When top-2 restoration candidates have frequencies within this ratio
# (top/second ≤ ratio), the token is preserved unchanged and flagged for
# the entity resolver to disambiguate via context.  Must be >= 1.0.
NEGELIR_SWARM_NLP_DIACRITIC_TIE_BREAK_RATIO=1.5
# Voice-specific diacritic aggressiveness (§10.3). Voice input may restore
# more aggressively because ASR under-emits diacritics on low-frequency tokens.
NEGELIR_SWARM_NLP_DIACRITIC_TIE_BREAK_RATIO_VOICE=2.5
# Hard-call restoration frequency floor (§10.22.1). Ambiguous entries whose
# top candidate frequency is >= this threshold restore to the top candidate
# even when the tie-break ratio would otherwise preserve ASCII. Must be >= 1.
NEGELIR_SWARM_NLP_DIACRITIC_HARD_CALL_MIN_FREQ=10000
# Maximum cumulative per-character restoration risk allowed per token
# (§10.22.1). If sum(risk weights for letter swaps) exceeds this value,
# the token remains ASCII even when restoration is unique. Must be >= 0.0.
NEGELIR_SWARM_NLP_DIACRITIC_MAX_RISK_PER_TOKEN=2.5
# Minimum confidence margin for restored-form gazetteer hits to override
# ASCII-pass hits when both match the same span but disagree on canonical
# entity (§10.22.1).  Must be >= 0.0.
NEGELIR_SWARM_NLP_ASCII_VS_RESTORED_MARGIN=0.2
# Per-request repair-density cap at the 95th percentile for clean-input
# quality monitoring (§10.22.13). Exceeding this value should surface
# operator-facing dashboard alerts in the NLP runbook.
NEGELIR_SWARM_NLP_REPAIR_DENSITY_P95_MAX=0.5
# Directory containing Phase 10 Turkish language rule tables consumed by
# the input normalizer and lexicon build pipeline.
NEGELIR_SWARM_NLP_LANG_TR_DIR=ai/nlp/lang_tr
# File-mtime poll interval for hot-reloading the Turkish language rule
# tables. Default 30 seconds.
NEGELIR_SWARM_NLP_LANG_TR_RELOAD_S=30
# Wall-clock deadline for the combined normalize+diacritic+typo stage
# (§10.3 Cost ceiling, Phase 9 §9.17.4 deadline propagation).  On timeout
# the pipeline falls through to the raw token sequence and emits
# nlp.event.v1{kind=normalize_timeout}.  Must be ≥ 1 ms.
NEGELIR_SWARM_NLP_NORMALIZE_STAGE_TIMEOUT_MS=20
# Total per-request p99 budget for the entire normalize chain (all passes,
# all gates, end-to-end; §10.34.2).  Used for CI regression gates; no hard
# enforcement at runtime but violated budgets are telemetry events.  Must be ≥ 5 ms.
NEGELIR_SWARM_NLP_NORMALIZE_TOTAL_BUDGET_P99_MS=12
# nlp_time_default_period: default time-of-day for ambiguous hours 1-11 when
# no explicit period keyword is present (§10.22.6).  Allowed: am|pm.
NEGELIR_SWARM_NLP_TIME_DEFAULT_PERIOD=am
# nlp_runtime_locale: runtime LC_CTYPE locale required by the NLP plane.
# Locks Turkish casefolding and rejects startup if the locale cannot be pinned.
NEGELIR_SWARM_NLP_RUNTIME_LOCALE=tr_TR.UTF-8
# nlp_render_timezone: render-time timezone for Turkish NLP answer clocks.
NEGELIR_SWARM_NLP_RENDER_TIMEZONE=Europe/Istanbul
# nlp_pod_id: unique per-NLP-pod identity salt used by the L0 intent cache
# key and other pod-local cache sharding metadata. Defaults to local for
# single-node development.
NEGELIR_SWARM_NLP_POD_ID=local
NEGELIR_SWARM_NLP_FORMAT_NUMBER_ROUNDING=bankers
# nlp_date_default_window_days: look-ahead window in days for year-omitted
# day/month expressions (§10.22.6).  Default is 180.
NEGELIR_SWARM_NLP_DATE_DEFAULT_WINDOW_DAYS=180
# nlp_holiday_lookup_horizon_days: lookup horizon in days for Turkish holiday
# resolution in ai/nlp/dates_tr.py. Queries beyond this horizon are treated
# as unsupported and fall through to prompt-level handling.
NEGELIR_SWARM_NLP_HOLIDAY_LOOKUP_HORIZON_DAYS=540
# §10.22.5 Composite-abbreviation separator pattern for dispatcher (§10.6).
# Token between two resolved team entities must match this regex to promote the
# pair to a match_lookup slot.  Default covers hyphen, en/em-dash, vs/vs., x, ×, /.
# Calibrated on fan-message corpus: covers > 99% of "Team A vs Team B" phrasings.
NEGELIR_SWARM_NLP_MATCH_SEPARATOR_PATTERN=^(-|–|—|vs\.?|x|×|/)$
# §10.22.7 word-bridge match parsing for dispatcher (§10.6).
# Token between two resolved team entities that matches one of these bridge
# words promotes the pair to a match_lookup slot.
NEGELIR_SWARM_NLP_MATCH_WORD_BRIDGES=ile,karşı,vs,vs.,ve
# §10.22.7 co-token adjacency parsing for dispatcher (§10.6).
# When two team entities appear in the same sentence and a co-token appears
# near them, the pair is promoted to a match_lookup slot.
NEGELIR_SWARM_NLP_MATCH_CO_TOKENS=maç,maçı,derbi,karşılaşma,fikstür,oyun
# §10.24.7 club-city disambiguation co-tokens for ambiguous bare club names.
NEGELIR_SWARM_NLP_CLUB_CO_TOKENS=maç,skor,kadro,fikstür,puan,forma,hocası,teknik
# §10.22.7 word-bridge match parsing radius — token distance from the team
# pair to the bridge or co-token. Default 4.
NEGELIR_SWARM_NLP_MATCH_ADJACENCY_RADIUS=4
# §10.24.7 club-city disambiguation radius — token distance from the club
# alias to the disambiguating co-token. Default 4.
NEGELIR_SWARM_NLP_CLUB_DISAMBIGUATION_RADIUS=4
# §10.24.12 team-nickname backtracking retries. Default 1.
NEGELIR_SWARM_NLP_BACKTRACK_MAX_ATTEMPTS=1
# §10.24.13 minimum normalized token count before the empty-input floor gate
# returns canned help. Default 1.
NEGELIR_SWARM_NLP_MIN_TOKENS=1
# §10.34 partial-input detection minimum prefix length. Default 3.
NEGELIR_SWARM_NLP_PARTIAL_INPUT_MIN_TOKEN_LEN=3
# §10.34 partial-input completion candidate limit. Default 3.
NEGELIR_SWARM_NLP_PARTIAL_INPUT_MAX_COMPLETIONS=3
# §10.22.7 date/time fixture binding radius — token distance from the
# matched team pair to a resolved date/time entity. Default 8.
NEGELIR_SWARM_NLP_FIXTURE_DATE_ADJACENCY_RADIUS=8
# Active league catalog season label used by lexicon build/runtime to
# determine which sponsor prefixes are current. Empty = no season filter.
NEGELIR_COMMON_LEAGUE_CATALOG_ACTIVE_SEASON=
# §10.4 fastText intent classifier model.
# INTENT_MODEL_PATH: path to the .bin model file (relative to repo root).
# INTENT_MODEL_SHA256: hex SHA256 of the model file, set by `make nlp.intent-pin`.
#   Empty = SHA check disabled (dev / pre-train only; must be set in production).
# INTENT_MODEL_MAX_SIZE_MB: hard cap on model disk size (DoD: ≤ 20 MB).
# INTENT_CALIBRATION_PATH: path to intent.tr.calibration.json (§10.4 Calibration).
#   Empty = auto-resolved as <model_dir>/intent.tr.calibration.json.
#   Set after calibration script runs on the held-out validation slice.
NEGELIR_SWARM_NLP_INTENT_MODEL_PATH=data/models/nlp/intent.tr.bin
NEGELIR_SWARM_NLP_INTENT_TRAIN_SHADOW_PATH=data/nlp/shadow_train.jsonl
NEGELIR_SWARM_NLP_INTENT_TRAIN_EVAL_MANIFEST_PATH=
NEGELIR_SWARM_NLP_INTENT_TRAINING_MANIFEST_DIR=data/nlp/training_manifests
NEGELIR_SWARM_NLP_INTENT_MODEL_SHA256=
NEGELIR_SWARM_NLP_INTENT_MODEL_MAX_SIZE_MB=20
NEGELIR_SWARM_NLP_INTENT_CALIBRATION_PATH=
# §10.23.2 NLP rollout and canary pod configuration.
NEGELIR_SWARM_NLP_CANARY_POD=0
NEGELIR_SWARM_NLP_INTENT_MODEL_CANARY_PCT=10
NEGELIR_SWARM_NLP_CANARY_ACCOUNT_BUCKET_SIZE=1000
NEGELIR_SWARM_NLP_INTENT_SHADOW_MODE=off
NEGELIR_SWARM_NLP_SHADOW_SAMPLE_RATE=0.01
NEGELIR_SWARM_NLP_CANARY_MIN_SHADOW_HOURS=72
NEGELIR_SWARM_NLP_CANARY_MAX_DISAGREEMENT_RATE=0.03
NEGELIR_SWARM_NLP_CANARY_MAX_CONFIDENCE_DRIFT=0.05
NEGELIR_SWARM_NLP_LEXICON_CANARY_MAX_DISAGREEMENT_PCT=0.02
NEGELIR_SWARM_NLP_LEXICON_CANARY_MAX_PER_FIELD_DISAGREEMENT_PCT=0.05
NEGELIR_SWARM_NLP_WEEKLY_EVAL_SAMPLE_SIZE=2000
NEGELIR_SWARM_NLP_WEEKLY_EVAL_SAMPLE_MAX_CHARS=200
NEGELIR_SWARM_NLP_WEEKLY_EVAL_MAX_ACCURACY_DROP=0.03
NEGELIR_SWARM_NLP_WEEKLY_EVAL_CONSECUTIVE_DROP_THRESHOLD=0.05
# §10.4 Abstention threshold: minimum calibrated confidence for a definite
# intent classification.  Below this floor the pipeline returns an
# IntentAbstention with top-3 suggestions for "Did you mean?" (§10.18
# evaluation harness pins this value).
NEGELIR_SWARM_NLP_MIN_INTENT_CONF=0.55
# §10.32.1 quotative firewall: minimum confidence for frame detection.
# When the frame is detected at or above this threshold, predict.* routing
# is overridden to a safer data/meta route.
NEGELIR_SWARM_NLP_QUOTATIVE_MIN_CONFIDENCE=0.70
# §10.32.4 dialect normalization per-dialect coverage floor on the evaluation harness.
NEGELIR_SWARM_NLP_DIALECT_CLASS_MIN_RECALL=0.80
# §10.32.2 aspectual stack parser depth cap.  Closed Turkish aspectual stack
# parses are limited to a shallow depth to protect against input DoS.
NEGELIR_SWARM_NLP_ASPECTUAL_STACK_MAX_DEPTH=3
# §10.4 Drift guard: rolling accuracy floor — when the rolling accuracy over
# the last DRIFT_WINDOW predictions drops below this value, IntentDriftGuard
# marks the classifier degraded and the agent emits nlp.event.v1
# {kind=intent_classifier_degraded} and routes to template-only fallback.
NEGELIR_SWARM_NLP_INTENT_ACCURACY_FLOOR=0.92
# §10.4 Drift guard: number of most-recent predictions in the rolling window.
NEGELIR_SWARM_NLP_INTENT_DRIFT_WINDOW=1000
# §10.18 Entity F1 floor: minimum F1 score required for entity extraction
# on the golden corpus (clean ∪ no_diacritics ∪ typos slice) for a release
# to pass CI gates.  Must be in (0, 1).  Default 0.90.
NEGELIR_SWARM_NLP_ENTITY_F1_FLOOR=0.90
# §10.18 Voice-eval intent accuracy floor: minimum intent accuracy required on
# the voice slice of the evaluation corpus. Default 0.85.
NEGELIR_SWARM_NLP_VOICE_EVAL_INTENT_ACCURACY_FLOOR=0.85
# §10.18 Voice-eval entity F1 floor: minimum entity F1 required on the voice
# slice of the evaluation corpus. Default 0.80.
NEGELIR_SWARM_NLP_VOICE_EVAL_ENTITY_F1_FLOOR=0.80
# §10.4 Versioning: human-readable semver for the deployed intent model file.
# Stamped on every qa.intent.v1 envelope as intent_model_version for post-hoc
# audit.  Set by `make nlp.intent-pin`; empty during pre-train / dev.
NEGELIR_SWARM_NLP_INTENT_MODEL_VERSION=
# §10.21.1 Numpy + fastText version pin: exact numpy version expected at runtime.
# Boot probe asserts numpy.__version__ matches this value; refuse start on drift
# (defends against ABI shifts that could change model behavior or re-serialize
# binaries differently across upgrades).  Empty = check disabled (dev only).
# Recorded in xops/versioning/chart.json py_exact_versions.numpy.
NEGELIR_SWARM_NLP_NUMPY_PIN=
# §10.21.1 Exact fasttext version expected at runtime. Boot probe asserts
# fasttext.__version__ matches; refuse start on drift.  Empty = check disabled.
# Recorded in xops/versioning/chart.json py_exact_versions.fasttext.
NEGELIR_SWARM_NLP_FASTTEXT_PIN=

# ── Phase 10 §10.5 — Entity extraction (gazetteer + CRF) ─────────────────
# Comma-separated ordered list of entity kinds for tie-breaking in the
# gazetteer conflict-resolution pass (§10.5 conflict resolution rule c).
# Teams are resolved first, then players, leagues, competitions, markets,
# then CRF-produced temporal/numeric kinds.
NEGELIR_SWARM_NLP_ENTITY_KIND_PRIORITY=team,player,league,competition,market,date,time,weekday,ordinal,money_amount,score
# Path to the trained python-crfsuite model file for BIO-tag temporal/numeric
# entity extraction (§10.5 CRF pass).  Empty = CRF pass disabled (gazetteer-
# only mode).  Set by `make nlp.entity-pin` alongside the SHA.
NEGELIR_SWARM_NLP_ENTITY_CRF_MODEL_PATH=
# Expected SHA256 hex digest of the CRF model file.  Empty = integrity check
# skipped (dev / pre-train mode).
NEGELIR_SWARM_NLP_ENTITY_CRF_MODEL_SHA256=
# Hard cap on the CRF model file size in MB (§10.5 "model ≤ 5 MB").
# CrfExtractor refuses to load a model larger than this value.
NEGELIR_SWARM_NLP_ENTITY_CRF_MODEL_MAX_SIZE_MB=5
# p95 latency gate for `make nlp.entity-bench` (milliseconds; Phase 10 §10.5).
NEGELIR_SWARM_NLP_ENTITY_BENCH_LATENCY_P95_THRESHOLD_MS=8
# Enable warm-touch mmap for CRF/Symspell/intent models at boot (§10.34.2).
# When enabled, models are pre-faulted into RAM via os.posix_madvise(MADV_WILLNEED).
NEGELIR_SWARM_NLP_MODEL_WARM_TOUCH_ENABLED=true
# Pod RSS memory budget in MB (used to compute page warm-touch cap; §10.34.2).


# ── Phase 10 §10.6 — Dispatcher slot-resolver ─────────────────────────────
# nlp_default_fixture_window_h: look-ahead window for disambiguation backoff
#   (hours).  When predict.* intent cannot resolve to a single fixture, the
#   dispatcher lists upcoming fixtures within this window.  Range: 1–720.
NEGELIR_SWARM_NLP_DEFAULT_FIXTURE_WINDOW_H=48
# nlp_summary_max_fixtures: max fixtures in summary.next_week / summary.matchday
#   fan-out.  Range: 1–100.
NEGELIR_SWARM_NLP_SUMMARY_MAX_FIXTURES=10
# nlp_skew_window_s: rolling window for classifier-extractor skew detection.
#   When the p95 skew exceeds the alert threshold over this window and at
#   least nlp_skew_alert_min_requests requests were seen, the dispatcher emits
#   nlp.alert.v1{kind=nlp_classifier_extractor_skew_high} for the intent.
NEGELIR_SWARM_NLP_SKEW_WINDOW_S=600
# nlp_skew_alert_p95: p95 skew threshold for the classifier-extractor skew alert.
#   Default = 0.4.
NEGELIR_SWARM_NLP_SKEW_ALERT_P95=0.4
# nlp_skew_alert_min_requests: minimum samples in the rolling window before the
#   skew alert is eligible to fire. Default = 100.
NEGELIR_SWARM_NLP_SKEW_ALERT_MIN_REQUESTS=100
# nlp_skew_alert_debounce_s: per-intent debounce window for skew alerts.
#   Default = 600.
NEGELIR_SWARM_NLP_SKEW_ALERT_DEBOUNCE_S=600
# nlp_fixture_state_lookup_timeout_ms: deadline for the fixture-state lookup
#   request emitted by nlp.dispatcher.v1. On timeout, dispatcher degrades to
#   UNKNOWN rather than assuming scheduled.
NEGELIR_SWARM_NLP_FIXTURE_STATE_LOOKUP_TIMEOUT_MS=250
# nlp_max_subqueries: max run-on / multi-question subqueries preserved from
#   a single Turkish voice input before deprecating to the first subquery only.
#   Range: 1–10.
NEGELIR_SWARM_NLP_MAX_SUBQUERIES=3
# nlp_summary_aggregation_timeout_ms: how long nlp.answer.v1 waits for all
#   predict.approved.v1 arrivals in a summary fan-out before emitting a
#   degraded answer.  Must be <= nlp_pipeline_timeout_ms.  Range: 1–300000.
NEGELIR_SWARM_NLP_SUMMARY_AGGREGATION_TIMEOUT_MS=1500
# nlp_summary_min_fixture_quorum: minimum fraction of fixtures that must
#   return before a summary can still be rendered.  Range: 0.0001–1.0.
NEGELIR_SWARM_NLP_SUMMARY_MIN_FIXTURE_QUORUM=0.6
# nlp_summary_fanout_timeout_ms: per-fixture fan-out timeout for summary
#   dispatch.  Range: 1–300000.
NEGELIR_SWARM_NLP_SUMMARY_FANOUT_TIMEOUT_MS=2500
# nlp_summary_calibration_mismatch_policy: handling when a summary fan-out
#   contains multiple calibration versions. "note" renders explicit TR
#   disclosure; "refuse" degrades summary to fixture links only.
#   Allowed: note|refuse.
NEGELIR_SWARM_NLP_SUMMARY_CALIBRATION_MISMATCH_POLICY=note
# nlp_active_learning_queue_max: maximum active-learning feedback rows
#   held in nlp.dispatcher.v1. Oldest entries are evicted when full.
#   Range: 1–100000. Default: 10000.
NEGELIR_SWARM_NLP_ACTIVE_LEARNING_QUEUE_MAX=10000
# nlp_dispatch_dedup_window_s: sliding dedup window for dispatcher idempotency
#   key (qa_correlation_id, intent, entity_hash).  Replayed qa.intent.v1
#   messages seen within this window are silently dropped (§10.6).  Must be
#   >= nlp_request_dedup_window_s.  Range: 1–86400.  Default: 600.
NEGELIR_SWARM_NLP_DISPATCH_DEDUP_WINDOW_S=600
NEGELIR_SWARM_NLP_CONVERSATION_MAX_TURNS=8
NEGELIR_SWARM_NLP_CONVERSATION_IDLE_TTL_S=180
NEGELIR_SWARM_NLP_CONVERSATION_REDIS_KEY_PREFIX=nlp:ctx:
NEGELIR_SWARM_NLP_CONVERSATION_ENABLED_TIER_FLOOR=0
NEGELIR_SWARM_NLP_CONVERSATION_INDEX_BACKEND=redis
# nlp_intent_tier_map: JSON object mapping intent -> tier_id_required label.
#   Dispatcher computes tier from intent only (independent of humanizer usage).
#   When unset, the built-in ai/common/nlp/intent_tier_map.json file provides
#   a default mapping for the Phase 10 closed intent enum.
#   Example: {"predict.match_outcome":"pro","summary.matchday":"pro"}
NEGELIR_SWARM_NLP_INTENT_TIER_MAP={}

# ── Phase 10 §10.7 — Answer generation / template rendering ──────────────
# Confidence band thresholds for the confidence_band Jinja2 filter/global.
# JSON list of [lower_inclusive, upper_exclusive, label] triples.  Labels
# must be Turkish.  First matching band wins.  Default 3-band table:
#   prob < 0.55 → "düşük", 0.55–0.75 → "orta", > 0.75 → "yüksek".
NEGELIR_SWARM_NLP_CONFIDENCE_BANDS=[[0.0,0.55,"düşük"],[0.55,0.75,"orta"],[0.75,1.01,"yüksek"]]

# Default locale for NLP templates and responses (§10.17).
# Format: IETF BCP 47 language tag (e.g., "tr-TR", "en-GB", "en-US").
# Template resolution: ai/nlp/templates/<intent>.<locale>.j2
# Per-request override via Phase 9 Accept-Language header (lossy-mapped to
# supported set). v1 ships tr-TR only; en-GB/en-US forward hook post-Phase-13a.
NEGELIR_SWARM_NLP_DEFAULT_LOCALE=tr-TR
# Phase 10 §10.22 locale fallback chain: ordered supported locales used to resolve
# language-only or unsupported tags.
NEGELIR_SWARM_NLP_LOCALE_FALLBACK_CHAIN=["tr-TR"]

# Phase 10 §10.21.1 — Hypothesis profile for NLP property-based tests.
# Max examples per test. Higher = better shrinking, slower CI. (1–10000)
NEGELIR_SWARM_NLP_HYPOTHESIS_MAX_EXAMPLES=1000

# Phase 10 §10.21.2 — Singleflight event-map sweeper (orphan cleanup).
# Sweeper poll interval (seconds): background thread wakes every this many
# seconds, drops orphaned events older than event_max_age_s, and emits
# nlp.event.v1{kind=singleflight_event_swept, count=N} (debounced). (1–3600)
NEGELIR_SWARM_NLP_SINGLEFLIGHT_SWEEP_INTERVAL_S=30
# Orphan threshold (seconds): events older than this age are dropped by the
# sweeper.  A crashed dispatcher may leave an event un-set forever; the
# sweeper reaps it. (1–3600)
NEGELIR_SWARM_NLP_SINGLEFLIGHT_EVENT_MAX_AGE_S=60
# Hard cap on the event map size: over-cap → new sf.do() calls are rejected
# with an exception + nlp.alert.v1{kind=nlp_singleflight_overflow, severity=warn}.
# Defends against unbounded growth from a wedged pipeline or abnormal query
# rate. (1–100000)
NEGELIR_SWARM_NLP_SINGLEFLIGHT_MAX_INFLIGHT=2048

# ── Phase 12 — Adversarial & chaos test suite ──────────────────────
# §12.2.3 — Growth bound & rotation
# Maximum rows added to adversarial corpora per calendar quarter. Prevents
# unbounded corpus growth; new families need explicit reviewer ack. (1–10000)
NEGELIR_INFRA_ADVERSARIAL_CORPUS_MAX_ADDED_ROWS_PER_QUARTER=500
# §12.3.3 — Fuzz harness time budgets
# Wall-clock budget (seconds) per nightly fuzz campaign (make fuzz.api,
# make fuzz.nlp, make fuzz.wire). Coverage-guided fuzzing per target. (30–3600)
NEGELIR_INFRA_FUZZ_NIGHTLY_BUDGET_S=600

# ── Phase 8 — Self-maintenance plane (ops console + maint.event/ack) ──
# §8.1 ops console baseline. The CLI lives at xops/opsctl/__main__.py
# and publishes maint.event.v1 → waits for maint.ack.v1 from each
# expected consumer (kind→consumer-set map: ai/swarm/agents/maint/
# _ack_routing.py). Bus-down replays land in OPSCTL_SPOOL_DIR and are
# drained by `make ops.spool-flush`. Empty AUDIT_PATH / SPOOL_DIR
# resolve to <DATA_DIR>/maint/opsctl_audit.csv and
# <DATA_DIR>/maint/opsctl_spool/ respectively.
NEGELIR_INFRA_OPSCTL_ACK_TIMEOUT_MS=5000
# Phase 8 §8.16.13 — local Redis Streams budget for `make swarm.demo.live`.
# Must stay lower than NEGELIR_INFRA_OPSCTL_ACK_TIMEOUT_MS.
NEGELIR_INFRA_OPSCTL_ACK_TIMEOUT_MS_LIVE_DEMO=1000
# Phase 10 §10.27 — max TTL for operator NLP kill patterns. Exceeding values
# are clamped by the NLP consumer when the event is processed.
NEGELIR_INFRA_OPSCTL_NLP_KILL_MAX_TTL_S=3600
# Phase 10 §10.32 — operator flame capture TTL. Expired arms are not eligible
# for capture and are evicted from Redis storage.
NEGELIR_INFRA_OPSCTL_FLAME_CAPTURE_TTL_H=24
# Phase 10 §10.32 — maximum number of active flame capture arms per hour.
# Prevents operator abuse or runaway listener saturation in a busy system.
NEGELIR_INFRA_OPSCTL_FLAME_CAPTURE_MAX_ARMED_PER_H=10
# Phase 9 §9.13 — base URL for `make swarm.demo.live` API smoke test.
# Override when the API runs on a non-default port or host locally.
NEGELIR_SERVER_API_DEMO_BASE_URL=http://localhost:8080
NEGELIR_INFRA_OPSCTL_SPOOL_MAX_ENTRIES=1024
# Critical agents: destructive ops console commands (scale=0, restart,
# maint-pause) require typed-token confirmation when their target is in
# this set. Comma-separated agent ids (whitespace-tolerant).
NEGELIR_INFRA_OPSCTL_CRITICAL_AGENTS=consensus.v1,sec.rate.v1,maint.backup.v1
NEGELIR_INFRA_OPSCTL_AUDIT_PATH=
NEGELIR_INFRA_OPSCTL_SPOOL_DIR=
# Re-entrancy lock dir (per (host, kind, target) advisory flock).
# Empty resolves to <DATA_DIR>/maint/opsctl_locks/. Stale lockfiles
# (no live holder, mtime older than ACK_TIMEOUT_MS × STALE_FACTOR)
# are reaped on the next acquire.
NEGELIR_INFRA_OPSCTL_LOCK_DIR=
NEGELIR_INFRA_OPSCTL_LOCK_STALE_FACTOR=2
# §8.16.2 spool-flush ack reconciler: alert horizon (hours) for
# audit rows with received_acks < expected_acks. Default 24h matches
# the operator-day cadence in `make ops.spool-reconcile`.
NEGELIR_INFRA_OPSCTL_SPOOL_ACK_MAX_WAIT_H=24
# §8.14.10 drain-budget per flush invocation: max envelopes drained in one run.
# 0 = unlimited. Default 100 bounds wall-clock cost against a wedged bus.
# Partial flushes emit kind=spool_flush_partial; re-run or set up a cron.
NEGELIR_INFRA_OPSCTL_SPOOL_FLUSH_MAX_PER_RUN=100
# maint.ack.v1 producer-side payload caps (consumers truncate at these
# limits + emit maint_ack_oversize debounced alert per §8.9 DoD).
NEGELIR_INFRA_MAINT_ACK_PAYLOAD_MAX_BYTES=4096
NEGELIR_INFRA_MAINT_ACK_REASON_MAX_BYTES=512
NEGELIR_INFRA_MAINT_ACK_DETAILS_MAX_BYTES=2048
# §8.14.4 Redis ACL + signed envelopes.
# ACL username opsctl must authenticate as (provisioned by §2 mock + Phase 14 K8s).
NEGELIR_INFRA_OPSCTL_REDIS_EXPECTED_USER=negelir_opsctl
# Runtime env hint (NOT a config knob — not read by ai/common/config.py):
# The negelir_opsctl ACL password goes into infra/redis/acl.conf at deploy time.
# In production inject via K8s Secret; never commit the real password here.
# In the §2 mock stack the password is negelir_opsctl_dev (rotate in prod).
# NEGELIR_INFRA_OPSCTL_REDIS_PASSWORD=<set-via-k8s-secret-not-this-file>
# Require HMAC-SHA256 op_signature on every published envelope (true in prod).
# Set to false in mock/test environments to skip signing.
NEGELIR_INFRA_OPSCTL_REQUIRE_SIGNATURE=true
# Path to the 32-byte operator key file (mode 0600).
# Empty resolves to ~/.negelir/opsctl_key. Generate with: make ops.bootstrap-key
NEGELIR_INFRA_OPSCTL_KEY_PATH=
# Path to operator registry JSON (key_id → email). Empty = infra/maint/opsctl_operators.json
NEGELIR_INFRA_OPSCTL_OPERATORS_FILE=
# Path to per-subcommand authz YAML. Empty = infra/maint/opsctl_authz.yaml
NEGELIR_INFRA_OPSCTL_AUTHZ_FILE=

# ── Phase 8 §8.15.4 — HMAC key lifecycle ───────────────────────────
# Grace period in seconds after revoked_at during which old keys still
# verify (to absorb in-flight requests). Default 60 s.
NEGELIR_INFRA_OPSCTL_KEY_REVOCATION_GRACE_S=60
# Maximum key age in days before rotation is flagged as overdue. Default 365 d.
NEGELIR_INFRA_OPSCTL_KEY_MAX_AGE_DAYS=365
# Additional grace period in days after max_age before auto-revoke fires. Default 30 d.
NEGELIR_INFRA_OPSCTL_KEY_REVOCATION_GRACE_DAYS=30
# How often (seconds) the consumer-side OperatorsCache reloads the operators
# file from disk (mtime-poll). Default 60 s.
NEGELIR_INFRA_OPSCTL_OPERATORS_RELOAD_S=60
# Path to kill-switch sentinel file. Touch this file to drop ALL operator
# envelopes immediately. Empty = infra/maint/opsctl_kill_switch.
NEGELIR_INFRA_OPSCTL_KILL_SWITCH_PATH=
# Kill-switch file max age in hours. If the sentinel is older than this,
# it is ignored (prevents stale kill-switches surviving after a restart).
NEGELIR_INFRA_OPSCTL_KILL_SWITCH_MAX_AGE_H=24
# Per-key HMAC rate limit (requests per minute). Excess triggers a debounced
# critical alert. 0 = unlimited. Default 30.
NEGELIR_INFRA_OPSCTL_KEY_RATE_LIMIT_PER_MIN=30

# ── Phase 8 §8.2 — `maint.scaler.v1` agent ─────────────────────────
# Decision window in ms. Anchored on a monotonic clock (Linux:
# CLOCK_BOOTTIME via auto). `boottime` and `monotonic` are explicit.
NEGELIR_INFRA_MAINT_SCALER_DECISION_WINDOW_MS=30000
NEGELIR_INFRA_MAINT_SCALER_CLOCK_SOURCE=auto
# Phase 8 §8.15.1 — suspend-detection probe threshold in seconds.
# The heartbeat agent computes (boottime_ns - monotonic_ns); a step-up
# exceeding this value within one heartbeat interval indicates a container
# suspend. Set to 0 to disable. Default 30 s.
NEGELIR_INFRA_MAINT_CLOCK_SUSPEND_ALERT_S=30
NEGELIR_INFRA_MAINT_SCALER_MAX_TARGETS=256
NEGELIR_INFRA_MAINT_SCALER_MAX_REPLICAS=16
# Phase 8 §8.16.1 — conservative-by-default ceiling applied to any
# registered agent missing from NEGELIR_INFRA_MAINT_SCALER_MAX_REPLICAS_OVERRIDES_CSV.
# 0 = disabled (legacy: fall back to NEGELIR_INFRA_MAINT_SCALER_MAX_REPLICAS, no alert).
# Set to >=2 to OPT IN to the conservative posture + one-shot alerts.
NEGELIR_INFRA_MAINT_SCALER_DEFAULT_MAX_REPLICAS=0
NEGELIR_INFRA_MAINT_SCALER_MIN_REPLICAS=1
# Queue depth that triggers scale-up; under scale-down for shrink.
NEGELIR_INFRA_MAINT_SCALER_SCALE_UP_QUEUE_DEPTH=50
NEGELIR_INFRA_MAINT_SCALER_SCALE_DOWN_QUEUE_DEPTH=5
NEGELIR_INFRA_MAINT_SCALER_SCALE_UP_HEAD_AGE_S=30
# Hysteresis: signal must persist for N windows before action;
# grace = N additional windows before reverting.
NEGELIR_INFRA_MAINT_SCALER_HYSTERESIS_WINDOWS=3
NEGELIR_INFRA_MAINT_SCALER_HYSTERESIS_GRACE=1
# Cap on scale_decisions emitted per window (rest become scale_throttled).
NEGELIR_INFRA_MAINT_SCALER_MAX_CHANGES_PER_WINDOW=4
# Operator pin TTL in seconds (manual_scale_pin).
NEGELIR_INFRA_MAINT_SCALER_MANUAL_PIN_TTL_S=1800
# Per-agent max_replicas overrides as `agent=N,agent2=M` (empty =
# every target uses NEGELIR_INFRA_MAINT_SCALER_MAX_REPLICAS).
NEGELIR_INFRA_MAINT_SCALER_MAX_REPLICAS_OVERRIDES_CSV=
# Replica count published when scaler reacts to a retrain_request.
NEGELIR_INFRA_MAINT_SCALER_WARMUP_REPLICAS=1
# Phase 8 §8.14.8 — comma-separated agent names that self-scale.
# The auto-scaler will NOT emit scale_decision for these targets;
# it emits scale_throttled{reason=self_scaling_target} instead.
# Default: trainer.v1 (the trainer manages its own replica count).
NEGELIR_INFRA_MAINT_SCALER_SELF_SCALING_TARGETS=trainer.v1
# Phase 8 §8.15.9 — JSON-encoded list of 5-field UTC cron expressions
# (minute hour dom month dow) marking known high-load periods during
# which the §8.3 backup agent inflates PG/IO signals. The auto-scaler
# suppresses load-driven decisions during active windows and emits
# scale_throttled{reason=noise_window_active}. Emergency decisions
# (vram_budget_exceeded, manual_pin) always fire. Empty list disables
# suppression. Default covers nightly backup window (03:00-05:59 UTC)
# and Sunday cold-verify (05:00 UTC, DOW=0).
NEGELIR_INFRA_MAINT_SCALER_NOISE_WINDOWS=["0 3-5 * * *","0 5 * * 0"]
# Runtime selector: ``none`` (default — pure observer, no runtime
# call), ``compose`` (docker compose --scale), ``k8s`` (Phase 14).
NEGELIR_INFRA_MAINT_RUNTIME=none
# Compose file used by ``ComposeController`` when MAINT_RUNTIME=compose.
NEGELIR_INFRA_MAINT_SCALER_COMPOSE_FILE=docker-compose.yml
# Subprocess timeout for any runtime call (compose / k8s patch).
NEGELIR_INFRA_MAINT_SCALER_RUNTIME_TIMEOUT_S=30
# Hard global cap across every target — defends against runaway
# auto-scale during a self-amplifying lag storm.
NEGELIR_INFRA_MAINT_SCALER_GLOBAL_MAX_REPLICAS=64
# Minimum interval between two scale_decision events for the SAME
# target across distinct decision windows. Inside this window a
# candidate decision is coalesced and emits scale_throttled.
NEGELIR_INFRA_MAINT_SCALER_MIN_DECISION_INTERVAL_S=90
# Headroom (MB) subtracted from total per-host VRAM before the
# scaler computes its budget — prevents pod packing that OOMs the
# host on a transient spike.
NEGELIR_INFRA_MAINT_SCALER_VRAM_HEADROOM_MB=1024
# Phase 8 §8.16.8 — VRAM-budget pessimism factor (fraction 0..1) for agents
# whose VRAM footprint is unknown. Scale-up refused when VRAM already committed
# exceeds this fraction of the device budget. 0.6 = 60% threshold.
NEGELIR_INFRA_MAINT_SCALER_VRAM_PESSIMISTIC_THRESHOLD_PCT=0.6
# Phase 8 §8.16.8 — CPU-class agent scale-up budget (fraction 0..1 of total
# detected cores per host). No-op in single-host compose mode; enforced under
# K8s (Phase 14). 0.8 = 80% of host cores may be consumed by cpu-class agents.
NEGELIR_INFRA_MAINT_SCALER_CPU_BUDGET_PCT=0.8
# Phase 8 §8.2 A1 — scale-down grace: smoothed signals must remain
# below the down-scale threshold for this many consecutive decision
# windows before a scale-down is emitted (0 disables the gate).
NEGELIR_INFRA_MAINT_SCALER_SCALE_DOWN_GRACE_WINDOWS=2
# Phase 8 §8.2 A1 — Welford rolling-sketch retention. Signals are
# smoothed over this many most-recent samples per (target, signal)
# pair. 0 → instantaneous decisions (legacy behaviour).
NEGELIR_INFRA_MAINT_SCALER_SIGNAL_WINDOW_SAMPLES=5
# Phase 8 §8.2 A2 — load-driven clamp formula:
#   desired_replicas = clamp(min, ceil(observed_load / target_load_per_replica), max)
# observed_load is the smoothed queue_depth. 0 reverts to the
# legacy ±1-step decision.
NEGELIR_INFRA_MAINT_SCALER_TARGET_LOAD_PER_REPLICA=50
# Phase 8 §8.2 A2 — cap on replicas added/removed per single
# decision window (defends against cold-start swings).
NEGELIR_INFRA_MAINT_SCALER_MAX_STEP_PER_WINDOW=1
# Phase 8 §8.2 — observability: histogram bucket boundaries (CSV of
# strictly-positive floats in seconds) for the
# ``maint_scaler_runtime_call_seconds`` histogram. Parser sorts
# ascending and de-duplicates. Default mirrors the prometheus
# 5ms..10s ladder which covers both the noop path (~µs) and a slow
# ``docker compose --scale`` (~seconds).
NEGELIR_INFRA_MAINT_SCALER_RUNTIME_HISTOGRAM_BUCKETS=0.005,0.01,0.025,0.05,0.1,0.25,0.5,1.0,2.5,5.0,10.0
# Bounded global decision history size (insertion-order LRU). Oldest
# scale_decision entries evicted when cap is hit. Default 1024 covers
# ~14h at the default 30s window cadence across a full target roster.
NEGELIR_INFRA_MAINT_SCALER_HISTORY_MAX=1024
# Phase 8 §8.9 — leader-lease duration (seconds) for maint-plane agents.
# A losing pod transitions to observer mode no later than this many seconds
# after its last successful K8s coordination-API renewal.  Mirrors
# leaseDurationSeconds on the coordination.k8s.io/v1.Lease (Phase 14).
NEGELIR_INFRA_MAINT_LEADER_LEASE_DURATION_S=15

# ── Phase 8 §8.4 — source-watcher summarizer graduation ───────────
# `true` only takes effect when a pinned model id is configured AND
# the startup probe below can reach the summarizer endpoint from the
# agent container.
NEGELIR_DATASOURCE_SOURCE_WATCHER_SUMMARIZER_ENABLED=false
# Pinned model identifier only; `*-latest` / `:latest` are refused.
NEGELIR_DATASOURCE_SOURCE_WATCHER_SUMMARIZER_MODEL_ID=
# Transport-level startup reachability probe target. LLM auth and the
# actual request/response adapter remain separate from this probe.
NEGELIR_DATASOURCE_SOURCE_WATCHER_SUMMARIZER_PROBE_URL=
NEGELIR_DATASOURCE_SOURCE_WATCHER_SUMMARIZER_PROBE_TIMEOUT_SEC=2.0
# Per-call cap clamps LLM request `max_tokens` for source-watcher
# narration so one bursty diff cannot consume the day budget.
NEGELIR_DATASOURCE_SOURCE_WATCHER_SUMMARIZER_MAX_TOKENS_PER_CALL=4096
# Daily cap on total summarizer tokens (UTC day boundary).
NEGELIR_DATASOURCE_SOURCE_WATCHER_SUMMARIZER_MAX_TOKENS_PER_DAY=50000
# Persisted token ledger (mode 0600, atomic temp+rename write).
NEGELIR_DATASOURCE_SOURCE_WATCHER_SUMMARIZER_LEDGER_PATH=data/maint/summarizer_ledger.json

# ── Phase 8 §8.5 — `maint.dlq.v1` supervisor ───────────────────────
NEGELIR_INFRA_MAINT_DLQ_PER_TOPIC_QUOTA=100
NEGELIR_INFRA_MAINT_DLQ_REPLAY_BACKOFF_S=60
NEGELIR_INFRA_MAINT_DLQ_BACKOFF_LRU=1024
NEGELIR_INFRA_MAINT_DLQ_REPLAY_ALLOW_OVERRIDES=
# CSV allow-list of replayable DLQ topics (each MUST end in '.dlq').
# Empty = allow every topic not in RECURSION_DENY_SET.
NEGELIR_INFRA_MAINT_DLQ_REPLAY_TOPICS_ALLOW_CSV=
# After this many operator replays for a single (topic, request_id)
# the supervisor escalates and refuses further replays.
NEGELIR_INFRA_MAINT_DLQ_VISIT_MAX=2
# Per-topic token-bucket cap on replay attempts per minute.
NEGELIR_INFRA_MAINT_DLQ_PER_TOPIC_MAX_PER_MIN=60
# LRU cap on the (topic, request_id) → visit_count map.
NEGELIR_INFRA_MAINT_DLQ_VISIT_LRU=4096
# Phase 8 §8.5 C1 — periodic-tick total replay budget across all
# active DLQ topics. Per-tick per-topic share is
# max(1, this // len(active_topics)) so a single hot topic cannot
# starve the rest.
NEGELIR_INFRA_MAINT_DLQ_MAX_REPLAYS_PER_TICK=50
# Phase 8 §8.5 C2 — poison-pattern detection. ≥ N distinct request_ids
# escalating on the same topic within W seconds freezes that topic and
# fires sec.alert.v1{kind=consumer_likely_broken}. Lift via ops.dlq-resume.
NEGELIR_INFRA_MAINT_DLQ_CONSUMER_BROKEN_THRESHOLD=5
NEGELIR_INFRA_MAINT_DLQ_CONSUMER_BROKEN_WINDOW_S=600
# Phase 8 §8.5 backlog-pressure damping. When a DLQ topic depth
# exceeds this, the supervisor emits a debounced
# sec.alert.v1{kind=dlq_backlog_high} and quarters that topic's
# per-tick replay budget until depth halves.
NEGELIR_INFRA_MAINT_DLQ_BACKLOG_ALERT=1000
# Phase 8 §8.9 DoD — bounded in-memory topic-state map cap (LRU
# insertion-order eviction). Pressure alert fires when an evicted
# entry is younger than REPLAY_BACKOFF_S × BACKOFF_FACTOR × 3.
NEGELIR_INFRA_MAINT_DLQ_STATE_MAX=100000
# Backoff multiplier used for cap-pressure evaluation window.
NEGELIR_INFRA_MAINT_DLQ_BACKOFF_FACTOR=2
# Phase 8 §8.9 DoD — per-topic per-second replay rate cap (enforced
# on both operator-driven and periodic-tick paths).
NEGELIR_INFRA_MAINT_DLQ_REPLAY_RPS=10

# ── Phase 8 §8.6 — `maint.schema.v1` sentinel ──────────────────────
# Per-topic sample rate (token bucket); burst is the bucket capacity.
NEGELIR_INFRA_MAINT_SCHEMA_SAMPLE_RATE_PER_S=5
NEGELIR_INFRA_MAINT_SCHEMA_BURST=10
NEGELIR_INFRA_MAINT_SCHEMA_DRIFT_DEBOUNCE_S=60
NEGELIR_INFRA_MAINT_SCHEMA_DRIFT_LRU=512
# Phase 8 §8.6 Detector B — cadence (seconds) for the PG-column-vs-
# migration drift crawl. Default 3600 (1h). Floor 60s.
NEGELIR_INFRA_MAINT_SCHEMA_PG_CHECK_INTERVAL_S=3600
# Phase 8 §8.6 binding boundary — auto-apply migrations is OUT OF
# SCOPE for v1 (humans only; or Phase 17 patcher under `migration`
# scope). This knob exists for forward compatibility; defaults to
# false. Setting it `true` logs a startup warning and emits a
# one-shot sec.alert.v1{kind=schema_auto_apply_misconfigured,
# severity=warn} — no auto-apply code path exists in v1.
NEGELIR_INFRA_MAINT_SCHEMA_AUTO_APPLY_ENABLED=false
# Phase 8 §8.14.7 — hard per-process cross-topic validation-rate cap.
# Over-budget validates are dropped and counted; a debounced
# sec.alert.v1{kind=maint_schema_sample_rate_too_high} fires when
# the drop-rate exceeds 10 % of attempted over a 60 s window.
# Safety ceiling is 500 — values above 500 refuse to start
# (fail_safe_validate_rps_cap_exceeded). Default 50 rps.
NEGELIR_INFRA_MAINT_SCHEMA_VALIDATE_MAX_RPS=50

# ── Phase 8 §8.7 + §8.8 — `maint.sec.v1` agent ─────────────────────
# Pattern allowlist active TTL (operator-confirmed FP suppressions).
NEGELIR_INFRA_MAINT_SEC_PATTERN_TTL_S=604800
NEGELIR_INFRA_MAINT_SEC_PATTERN_PROMOTE_THRESHOLD=1
# Days before an un-promoted pending row is pruned (bounds table growth).
NEGELIR_INFRA_MAINT_SEC_PATTERN_PENDING_TTL_DAYS=30
# Phase 8 DoD canonical name for the allowlist pending-row TTL (same
# semantic as MAINT_SEC_PATTERN_PENDING_TTL_DAYS; required by triangle test).
NEGELIR_INFRA_MAINT_SEC_ALLOWLIST_PENDING_TTL_DAYS=30
NEGELIR_INFRA_MAINT_SEC_REQUEST_LRU=2048
# Phase 8 §8.8 hysteresis — minimum seconds between two
# denylist_decimate_now runs (global; one zset, one signal). A
# second decimate inside the window acks accepted=true with
# reason="hysteresis_throttled".
NEGELIR_INFRA_MAINT_SEC_DECIMATE_MIN_INTERVAL_S=300

# ── Phase 8 §8.10 — broadcast pause / resume ───────────────────────
NEGELIR_INFRA_MAINT_PAUSE_DEFAULT_TTL_S=600
# Hard cap on operator-specified pause TTL. Agents truncate any request
# longer than this and emit maint_pause_ttl_capped. Default 86400s (24h).
NEGELIR_INFRA_MAINT_PAUSE_MAX_TTL_S=86400
NEGELIR_INFRA_MAINT_SILENCE_DEDUP_S=300
# Phase 8 §8.16 D2 — dead-mans-switch. If no maint.event.v1 has been
# observed for this many hours (after the warmup grace), emit a
# critical sec.alert.v1{kind=maint_silence_alert}. Self-DLQ alert
# threshold flips an agent into PauseState.self_isolated mode.
NEGELIR_INFRA_MAINT_SILENCE_ALERT_H=24
NEGELIR_INFRA_MAINT_SILENCE_WARMUP_S=3600
NEGELIR_INFRA_MAINT_SELF_DLQ_ALERT=100
# Growth-rate self-throttle (§8.11): agent halves its emit rate when its
# own DLQ depth grows by more than this many entries per minute. Lifts
# once growth is non-positive for MAINT_SELF_DLQ_THROTTLE_RECOVERY_S s.
NEGELIR_INFRA_MAINT_SELF_DLQ_GROWTH_ALERT=50
# Seconds of non-positive DLQ growth required before the per-agent
# self-throttle lifts (default 120 = 2 minutes).
NEGELIR_INFRA_MAINT_SELF_DLQ_THROTTLE_RECOVERY_S=120

# ── Phase 8 §8.11 — consumer-lag watchdog ──────────────────────────
# Tier-1 fires when median lag exceeds this threshold (ms) for the
# alert window.  Tier 2 = 15 000ms (hard-coded), Tier 3 = 60 000ms.
NEGELIR_INFRA_MAINT_PLANE_LAG_ALERT_MS=5000
NEGELIR_INFRA_MAINT_PLANE_LAG_ALERT_WINDOW_S=60
# Symmetric sec.alert.v1 consumer-lag watchdog (§8.16.11).
NEGELIR_SERVER_SEC_PLANE_LAG_ALERT_MS=5000
NEGELIR_SERVER_SEC_PLANE_LAG_ALERT_WINDOW_S=60
NEGELIR_INFRA_MAINT_PLANE_RECOVERY_WINDOW_S=120

# ── Phase 8 §8.9 — per-agent bus circuit-breaker ──────────────────
# Consecutive publish failures before the breaker opens (bus_degraded).
NEGELIR_INFRA_MAINT_BUS_FAIL_THRESHOLD=3
# Time window (seconds) within which the consecutive failures must occur
# for the breaker to open.  A failure outside this window resets the
# streak counter.  Default 30s per §8.11 spec.
NEGELIR_INFRA_MAINT_BUS_FAIL_WINDOW_S=30.0
# Per-agent spool cap (entries); new writes refused when cap reached.
NEGELIR_INFRA_MAINT_BUS_SPOOL_MAX_ENTRIES=1024
# Root directory for per-agent spool sub-directories.
NEGELIR_INFRA_MAINT_AGENT_SPOOL_DIR=data/maint/agent_spool
# Cap on entries per agent in its per-agent sub-spool. Distinct from
# MAINT_BUS_SPOOL_MAX_ENTRIES (bus circuit-breaker spool). New writes
# are refused when reached; oldest entries are NOT evicted.
NEGELIR_INFRA_MAINT_AGENT_SPOOL_MAX_ENTRIES=512

# ── Phase 8 §8.11 — three-tier backpressure ────────────────────────
# YELLOW: any one signal degraded → maint loops slow by FACTOR×.
# RED: hard ceiling on any one signal → maint loops halt entirely.
# Yellow MUST be < red on every dimension (validated at startup).
NEGELIR_INFRA_MAINT_BACKPRESSURE_YELLOW_FACTOR=4.0
NEGELIR_INFRA_MAINT_BACKPRESSURE_YELLOW_QUEUE_DEPTH=200
NEGELIR_INFRA_MAINT_BACKPRESSURE_YELLOW_HEAD_AGE_S=60
NEGELIR_INFRA_MAINT_BACKPRESSURE_YELLOW_STORAGE_PCT=75
NEGELIR_INFRA_MAINT_BACKPRESSURE_YELLOW_ERROR_RATE_PER_S=1
NEGELIR_INFRA_MAINT_BACKPRESSURE_RED_QUEUE_DEPTH=1000
NEGELIR_INFRA_MAINT_BACKPRESSURE_RED_HEAD_AGE_S=300
NEGELIR_INFRA_MAINT_BACKPRESSURE_RED_STORAGE_PCT=92
NEGELIR_INFRA_MAINT_BACKPRESSURE_RED_ERROR_RATE_PER_S=10

# Phase 8 §8.13.2 — cumulative `data/maint/` storage cap (MB).
# Sums every per-subdir spool/audit/ledger under data/maint/ once
# per heartbeat. 80% → warn alert (debounced 1h); 100% → error
# alert + spool writes refuse with exit code 6 (maint_storage_full).
# Single hysteresis band: writes resume only when usage drops
# below 70% (prevents thrash). 0 = disabled.
NEGELIR_INFRA_MAINT_STORAGE_TOTAL_MAX_MB=512

# Phase 8 §8.13.3 — spool entry max age (hours).
# Entries in both opsctl_spool and agent_spool older than this are
# pruned on every flush attempt and emit maint.event.v1 + sec.alert.v1.
# Default 168h = 7d. 0 = disabled.
NEGELIR_INFRA_MAINT_SPOOL_ENTRY_MAX_AGE_H=168

# Phase 8 §8.13.3 — minimum supported spool envelope schema_version.
# Spool entries with schema_version below this value are quarantined to
# .retired/ on flush (same path as entries with a retired kind). 1 =
# accept all current schema versions. Only bump on a breaking schema change.
NEGELIR_SWARM_MIN_SUPPORTED_SCHEMA_VERSION=1

# Phase 8 §8.15.3 — advisory-lock hold-time guard (ms).
# Wall-clock cap on how long a Postgres advisory lock taken via
# xops.maint.advisory_lock.BoundLock may stay acquired before the
# context manager fires a debounced sec.alert.v1{
# kind=maint_advisory_lock_held_long, severity=warn} on release.
# Generous default — 5s — bounds accidental long transactions
# inside the critical section. 0 disables.
NEGELIR_INFRA_MAINT_ADVISORY_LOCK_MAX_HOLD_MS=5000

# ── Phase 8 §8.15.7 — opsctl_audit.csv hash-chain HMAC ────────────
# Path to the 32-byte HMAC-SHA256 key file for the opsctl_audit.csv
# integrity chain (mode 0400, agent-process only).
# Empty → no chain (dev/test only — set in prod).
NEGELIR_COMMON_AUDIT_CHAIN_HMAC_KEY_PATH=/var/lib/negelir/secrets/audit_chain.key
# Max bytes of opsctl_audit.csv before rotation (default 10 MB).
NEGELIR_INFRA_OPSCTL_AUDIT_MAX_BYTES=10485760

# ── Phase 8 §8.14 — maint audit log ────────────────────────────────
# Base64-encoded HMAC-SHA256 secret for the §8.15.7 hash chain.
# Empty = generate per-process ephemeral key (test only — do NOT
# leave empty in prod).
NEGELIR_INFRA_MAINT_AUDIT_HMAC_KEY_B64=
NEGELIR_INFRA_MAINT_AUDIT_PARTITION_RETENTION_DAYS=365
# §8.15.5 — per-row hard cap for maint_audit_log payload JSONB (bytes).
# The §8.14.1 BEFORE INSERT trigger backstop truncates rows that exceed
# this to a sentinel dict.  Default 16384 (16 KB).
NEGELIR_INFRA_MAINT_AUDIT_ROW_MAX_BYTES=16384
# §8.15.5 — producer-side per-kind details budget (JSON dict, kind → bytes).
# Keys are maint.event.v1 kind strings; "default" is the fallback.
# Values must be ≤ NEGELIR_INFRA_MAINT_AUDIT_ROW_MAX_BYTES.
NEGELIR_INFRA_MAINT_AUDIT_PER_KIND_DETAILS_MAX_BYTES={"dlq_escalated": 8192, "schema_drift_detected": 4096, "backup_dump_file_corrupted": 8192, "default": 2048}

# ── Phase 8 §8.3 — backup agent ────────────────────────────────────
# 5-field UTC cron expression that fires the nightly backup state
# machine (dump → restore-verify → prune). Operator typos are
# refused at boot by `xops.backup.cron.parse_cron`. Default = nightly
# at 03:00 UTC. Wildcards / lists / ranges / steps supported; named
# months/days are NOT (use numeric form).
NEGELIR_INFRA_MAINT_BACKUP_CRON=0 3 * * *
# 5-field UTC cron expression that fires the weekly cold-verify pass
# on the oldest still-retained Sunday dump (catches silent storage
# rot / S3 lifecycle bugs / encryption-key loss). Default Sunday
# 05:00 UTC — runs after the nightly window. Cold-verify failures
# emit `kind=backup_cold_verify_failed` + `sec.alert.v1{kind=
# backup_verify_failed, severity=critical, scope=cold}` and DO NOT
# auto-prune the affected dump (operator decides).
NEGELIR_INFRA_MAINT_BACKUP_COLD_VERIFY_CRON=0 5 * * 0
# Where dump artefacts + audit.csv live. Created on demand.
NEGELIR_INFRA_MAINT_BACKUP_DIR=./data/backups
# Daily-grain retention. Older daily dumps are pruned; weekly
# dumps (Sunday) are kept for retention_weeks instead.
NEGELIR_INFRA_MAINT_BACKUP_RETENTION_DAYS=14
NEGELIR_INFRA_MAINT_BACKUP_RETENTION_WEEKS=4
# Safety floor — when true, every emit carries dry_run=true and NO
# destructive prune is executed (would_delete_count instead). Default
# false (safe for production). Set to `true` in dev/CI environments
# (e.g. via .env or docker-compose override) to prevent accidental
# destructive prune.
NEGELIR_INFRA_MAINT_BACKUP_DRY_RUN=false
# Disk-pressure guard — refuse to start a dump if free space <
# max(2*last_dump_size, min_free_gb*1GB).
NEGELIR_INFRA_MAINT_BACKUP_MIN_FREE_GB=5
# Catch-up: at most one make-up run if monotonic delta vs last
# successful fire exceeds this many hours.
NEGELIR_INFRA_MAINT_BACKUP_MAX_SKEW_H=36
# Refuse the destructive prune phase if the most recent successful
# dump is older than this many hours.
NEGELIR_INFRA_MAINT_BACKUP_AGE_ALERT_H=30
# Backwards wall-clock step bigger than this (seconds) → emit
# sec.alert.v1{kind=backup_clock_skew, severity=error} and skip this
# fire (refuse-to-start safety floor).
NEGELIR_INFRA_MAINT_BACKUP_CLOCK_STEP_BACK_ALERT_S=300
# Forward wall-clock leap (last_fire → now) bigger than this (hours)
# → operator-visibility warn marker on the next backup_started event
# (`forward_leap_h` extra). The catch-up policy still owns the missed
# window; this is purely the early-warning surface (`scope=forward`).
NEGELIR_INFRA_MAINT_BACKUP_CLOCK_STEP_FORWARD_ALERT_H=24
# pg_dump parallelism (-j flag); 1 disables parallel mode.
NEGELIR_INFRA_MAINT_BACKUP_PG_JOBS=2
# §8.14.3 supply-chain pin — minimum acceptable `age` binary semantic version
# (major.minor.patch). Boot guard refuses to run if the installed version is
# older than this value. Update alongside infra/maint/age_binary_provenance.txt.
NEGELIR_INFRA_MAINT_BACKUP_AGE_BINARY_VERSION=1.2.0
# DELETE batch size for the destructive prune phase. Bounded so a
# single cron run cannot hold a long-lived row-lock cascade.
# ROADMAP §8.16.3 binding (fail_safe_prune_order_invalid): boot validation
# in PruneOrderValidator asserts PRUNE_ORDER is a valid topological sort
# of the live PG FK graph — drift causes a refuse-to-start + critical alert.
NEGELIR_INFRA_MAINT_BACKUP_PRUNE_BATCH=10000
# Maximum milliseconds a single prune batch may hold a table lock (§8.9 DoD).
NEGELIR_INFRA_MAINT_BACKUP_PRUNE_MAX_LOCK_MS=500
# ROADMAP §8.3 TTL prune retention windows (calendar days). Schema
# snapshots accumulate from Phase 4 storage.v1; DLQ entries from the
# Phase 9 Postgres backend; opsctl_audit + maint_audit_log are
# operator trails (longest retention by design).
NEGELIR_INFRA_MAINT_SCHEMA_SNAPSHOT_RETENTION_DAYS=90
NEGELIR_SWARM_DLQ_PG_RETENTION_DAYS=14
NEGELIR_INFRA_MAINT_AUDIT_RETENTION_DAYS=365
# Per-kind retention overrides (JSON dict, kind → days). Default ships
# the ROADMAP §8.9 right-to-erasure requirement: pii_erased rows kept
# for 2555 days (7 years) as breach-evidence records.
NEGELIR_INFRA_MAINT_AUDIT_RETENTION_DAYS_OVERRIDES={"pii_erased": 2555}
# Live `pg_dump` DSN — empty disables the live driver (in-memory shim
# is used; production swarm bootstrap refuses to start without this).
NEGELIR_INFRA_MAINT_BACKUP_PG_DSN=
# Path to the `age` recipients file (one DR-class public key per line).
# Required when the live `LocalPgDumpExecutor` is wired.
NEGELIR_INFRA_MAINT_BACKUP_AGE_RECIPIENTS_FILE=
# Directory of versioned recipient public keys (`keys.vN.age.pub` +
# optional `keys.vN.recipients.txt`). Empty disables encryption-at-rest.
# When NEGELIR_COMMON_PROFILE=prod AND NEGELIR_INFRA_MAINT_RUNTIME!=none, an unset
# value here AND an unset NEGELIR_INFRA_MAINT_BACKUP_AGE_RECIPIENTS_FILE
# trips the `fail_safe_no_encryption_in_prod` boot refusal.
NEGELIR_INFRA_MAINT_BACKUP_ENCRYPTION_KEY_DIR=
# Minimum DR-class recipients required in each `keys.vN.recipients.txt`
# under NEGELIR_INFRA_MAINT_BACKUP_ENCRYPTION_KEY_DIR. Default `2` matches the
# ROADMAP §8.3 prod binding (single-recipient DR is a single point of
# disaster-recovery failure). Mock stacks may override to `1`.
NEGELIR_INFRA_MAINT_BACKUP_MIN_DR_RECIPIENTS=2
# Path to the `age` identity file used by the restore-verifier to
# decrypt dumps in the ephemeral scratch container.
NEGELIR_INFRA_MAINT_BACKUP_AGE_IDENTITY_FILE=
# Pinned Postgres image for the restore-verifier scratch container.
# Must NOT be `*-latest` (CLAUDE.md doctrine).
NEGELIR_INFRA_MAINT_BACKUP_VERIFY_PG_IMAGE=postgres:16-alpine
# §8.14.9 nice level for pg_dump subprocess (0=disabled; 10=default; bounded 0-19).
# Mock / dedicated-PG deployments can set 0 to skip niceing.
NEGELIR_INFRA_MAINT_BACKUP_PG_DUMP_NICE_LEVEL=10
# §8.14.9 ionice wrapping for pg_dump on Linux (best-effort I/O, lowest prio).
# Ignored on non-Linux. Set false in mock or test environments.
NEGELIR_INFRA_MAINT_BACKUP_PG_DUMP_IONICE=true
# Restore-verify mode (ROADMAP §8.3 escape hatch). One of `full`
# (default — full pg_restore + verify.sql suite) or `toc_only`
# (pg_restore --list only — validates dump TOC without restoring rows;
# for very-large-DB nightly windows). Weekly cold-verify always runs
# the full suite regardless. Any other value refuses the agent at
# boot.
NEGELIR_INFRA_MAINT_BACKUP_VERIFY_MODE=full
# ROADMAP §8.13.4 restore version-invariant: maximum schema-version gap
# (in_tree_max_version - manifest.max_version) before restore-verify refuses
# with backup_dump_too_old + sec.alert.v1{severity=error}. Default 5 covers
# ~quarterly migration cadence. Operator must escalate when gap exceeds this.
NEGELIR_INFRA_MAINT_BACKUP_MAX_VERSION_GAP=5
# PII-aware dump: comma-separated table.column entries excluded from
# the logical dump by default. Maps to pg_dump --exclude-table-data
# in the live executor. ROADMAP §8.9 DoD: raw_bytes_b64 excluded so
# quarantined payload bytes never land in the encrypted dump.
NEGELIR_INFRA_MAINT_BACKUP_PII_EXCLUDED_COLUMNS=quarantine_samples.raw_bytes_b64
# ROADMAP §8.3 crash-cleanup invariant: orphaned K8s Jobs + ephemeral
# PVCs under `negelir-maint-verify` that are older than this many hours
# are swept on the next agent boot and emit
# `maint.event.v1{kind=backup_verify_orphan_swept}`. Default 6h.
# The real SidecarVerifier (Phase 14) uses this for TTL filtering.
NEGELIR_INFRA_MAINT_BACKUP_VERIFY_ORPHAN_TTL_H=6.0
# Size (Gi) of the ephemeral PVC provisioned for the K8s restore-verify
# job. Must be >= 2× the expected pg_restore output size.
NEGELIR_INFRA_MAINT_BACKUP_PVC_SIZE_GB=10
# ROADMAP §8.9 binding (fail_safe_wrong_pg_role / fail_safe_superuser):
# the expected Postgres role name for the backup agent. Must match the role
# granted by migration 011 (negelir_backup); must NOT be a superuser.
NEGELIR_INFRA_MAINT_BACKUP_PG_ROLE=negelir_backup
# ROADMAP §8.13.6 binding (fail_safe_pg_secret_expired): hard cap on the
# backup-role PG password age in days. Agent refuses to start when age
# exceeds this value, forcing rotation. Default 120d = alert@100d + 20d grace.
NEGELIR_INFRA_MAINT_BACKUP_PG_SECRET_MAX_AGE_DAYS=120
# ROADMAP §8.9 two-class encryption: rotate the ephemeral verify-class
# recipient keypair each nightly dump. True (default) ensures each dump's
# verify key is distinct so a leaked verify key exposes at most one dump.
# False only for DR drills bypassing the SidecarVerifier (Phase 14).
NEGELIR_INFRA_MAINT_BACKUP_VERIFY_KEY_ROTATE_PER_DUMP=true
# ROADMAP §8.9 binding (fail_safe_pg_conn_limit_too_low): minimum Postgres
# role connection limit. 0 (default) = auto-derive as pg_jobs + 1 (N parallel
# pg_dump workers + 1 coordinator). Set a higher explicit value to reserve
# additional headroom for the application connection pool.
NEGELIR_INFRA_MAINT_BACKUP_PG_CONN_LIMIT=0
# ROADMAP §8.12 off-host replication (S3-compatible offsite backup target).
# Set OFFSITE_TARGET=s3 plus ENDPOINT+BUCKET to activate. Default "none" = disabled.
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_TARGET=none
# S3-compatible endpoint URL. Leave empty for AWS-default region routing.
# Example: http://minio.local:9000 (local minio), https://s3.eu-central-1.amazonaws.com
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_ENDPOINT=
# Destination bucket name.
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_BUCKET=
# Minimum encrypted dump size (MB) to trigger S3 multipart upload. 0 = single-part.
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_MULTIPART_THRESHOLD_MB=64
# Bandwidth cap (KB/s) for offsite uploads. 0 = unlimited (default).
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_BW_KBPS=0
# Upload timeout per nightly fire window (hours). Exceeded → backup_offsite_failed.
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_UPLOAD_TIMEOUT_H=6
# S3 Object Lock (WORM) retention period in days. 0 = no WORM lock (default for dev/mock).
# Set to 30+ in prod to prevent accidental object deletion or overwrite.
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_OBJECT_LOCK_DAYS=0
# Emit backup_offsite_age_alert when the last successful offsite upload is older than
# this many hours. 0 = watchdog disabled. Default 48h (2 missed nightly windows).
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_AGE_ALERT_H=48
# On-object retention in days for the remote bucket (GFS-light).
# Default: 90 d (prod) / 7 d (mock/dev) — set via NEGELIR_COMMON_PROFILE-aware default in config.py.
# Override here to tune the window; must be >= object_lock_days for pruning to ever fire.
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_RETENTION_DAYS=7
# S3 access key ID (public credential; the secret is referenced below).
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_ACCESS_KEY_ID=
# File-path reference to the S3 secret access key. In K8s use a secretKeyRef
# volume-mount path (0400); in Compose/dev use a plain file path. NEVER the literal value.
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_SECRET_ACCESS_KEY_SECRET_REF=
# AWS / S3-compatible region for SigV4 signing. Use "auto" for R2, B2, MinIO.
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_S3_REGION=us-east-1
# Phase 8 §8.15.10 Fix B — offsite credential hot-reload interval (seconds).
# The FileSecretProvider background thread polls the key-id + key-secret files at
# this interval for mtime changes (atomic credential rotation without restart).
# Set to 0 to disable polling (credentials loaded once at startup).
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_CRED_RELOAD_S=60
# Maximum credential age (days) before a rotation-required warning is emitted.
# 0 = age-check disabled.
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_CREDENTIAL_MAX_AGE_DAYS=90
# Grace period (days) on top of max_age before upload is blocked.
# 0 = grace-check disabled.
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_CREDENTIAL_GRACE_DAYS=30
# Phase 8 §8.16.5 — multipart upload-id TTL.
# Max age (hours) of .offsite_state.json before treating the persisted upload_id
# as expired without probing AWS. Default 18 h (headroom under AWS 24 h default).
# 0 = always probe (no time-based short-circuit).
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_STATE_MAX_AGE_H=18
# Minimum acceptable AbortIncompleteMultipartUpload.DaysAfterInitiation.
# If the bucket's lifecycle rule is more aggressive, emits backup_offsite_lifecycle_too_aggressive.
# Default 2 days. 0 = lifecycle check disabled.
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_LIFECYCLE_MIN_DAYS=2
# Phase 8 §8.16.6 — Object-Lock / WORM boot-time preflight probe.
# How often (hours) the preflight probe repeats. 0 = boot-only (no recurring probe).
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_PREFLIGHT_INTERVAL_H=24
# When false the agent skips the bucket Object-Lock check (mock / non-prod only).
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_OBJECT_LOCK_REQUIRED=true
# Fail-safe gates for the WORM preflight — set to false only in non-prod environments.
NEGELIR_INFRA_FAIL_SAFE_OFFSITE_OBJECT_LOCK_DISABLED=true
NEGELIR_INFRA_FAIL_SAFE_OFFSITE_RETENTION_NOT_APPLIED=true
NEGELIR_INFRA_FAIL_SAFE_OFFSITE_LOCK_NOT_ENFORCED=true
# RsyncSshTarget: SSH host for the DR replica (user@host or bare host).
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_RSYNC_HOST=
# RsyncSshTarget: absolute destination path on the remote SSH host.
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_RSYNC_DEST_PATH=
# RsyncSshTarget: path to known_hosts file for strict host-key checking.
# Leave empty to fall back to the agent's ~/.ssh/known_hosts.
NEGELIR_INFRA_MAINT_BACKUP_OFFSITE_RSYNC_SSH_KNOWN_HOSTS=

# Phase 8 §8.12 — DR-drill cadence gauge.
# Path to the append-only CSV recording quarterly DR-drill outcomes.
NEGELIR_INFRA_MAINT_BACKUP_DR_DRILL_CSV=data/backups/dr_drills.csv
# Days before the cadence-overdue alert fires (one quarter ≈ 91 d; default 100).
NEGELIR_INFRA_MAINT_BACKUP_DR_DRILL_ALERT_DAYS=100
# Phase 8 §8.15.10 Fix A — restore-verify concurrency cap.
# Seconds the nightly restore-verify waits to acquire the advisory lock before
# yielding (emitting a verify_concurrency_blocked sec.alert.v1). Cold-verify
# always yields on first contention (never waits). 0 = wait forever (not
# recommended for production).
NEGELIR_INFRA_MAINT_BACKUP_VERIFY_LOCK_TIMEOUT_S=1800
# Phase 8 §8.15.10 Fix C — restore-verify forensic capture maximum file size.
# Bytes. When the serialised forensic JSON exceeds this limit the largest text
# field (pg_restore_stderr first, then pg_restore_stdout) is tail-truncated to
# fit. 0 = no limit (development shortcut only).
NEGELIR_INFRA_MAINT_BACKUP_FORENSIC_MAX_BYTES=262144

# Phase 8 §8.13.1 — model-artifact backup discipline.
# Hours within which the trainer can re-derive a byte-equivalent artifact from
# the Postgres calibration/outcome rows referenced in the lineage sidecar.
NEGELIR_INFRA_MAINT_BACKUP_MODEL_REPRODUCIBILITY_WINDOW_H=24
# Retention days for model tarballs in the offsite bucket.  Shorter than the PG
# retention because models are reproducible from the referenced Postgres rows.
NEGELIR_INFRA_MAINT_BACKUP_MODEL_OFFSITE_RETENTION_DAYS=30
# Debounce window (hours) for the post-hoc audit alert
# sec.alert.v1{kind=backup_model_lineage_missing} per predictor_id.  Re-alerts
# at most once per window when a predictor's artifacts are persistently
# sidecar-free.  Set to 0 in tests to disable debounce.
NEGELIR_INFRA_MAINT_BACKUP_MODEL_LINEAGE_MISSING_DEBOUNCE_H=24

# (test-only flag, intentionally not a runtime knob: NEGELIR_BUS_INTEGRATION=1
#  enables the Redis-backed parity tests under
#  ai/swarm/sdk/tests/test_bus_redis_integration.py)

# ── Bootstrap (real-data scrape gate before training) ──
# Minimum cached real matches required by `make bootstrap` / proofreader before
# training is allowed to proceed. Raise this once a league has full season data.
BOOTSTRAP_MIN_MATCHES=100

# ── Phase 3: Full-System Training Pipeline thresholds ──
# Min matches the trainer is willing to start on (vs BOOTSTRAP_MIN_MATCHES,
# which gates the data ingest step).
NEGELIR_DATASOURCE_TRAINING_MIN_MATCHES=100
# Pass/fail thresholds for `make train-full` verdict (model accuracy, holdout
# accuracy, quarantine fraction ceiling, holdout coverage).
NEGELIR_DATASOURCE_THRESHOLD_MODEL_ACC=0.50
NEGELIR_DATASOURCE_THRESHOLD_HOLDOUT_ACC=0.50
NEGELIR_DATASOURCE_THRESHOLD_QUARANTINE_MAX=0.10
NEGELIR_DATASOURCE_THRESHOLD_MIN_HOLDOUT_MATCHES=5
# Walk-forward holdout window (matchweeks reserved before training).
NEGELIR_DATASOURCE_VERIFICATION_WINDOW_WEEKS=4
# Where TrainingPipeline writes per-run reports + history.jsonl.
NEGELIR_DATASOURCE_REPORT_DIR=/data/reports

# ── Feature-vector firewall (roadmap §5.6.2) ──
# Optional JSON override for the feature-range clamp map used by the inference
# validator. Leave blank to use the built-in defaults from ai/common/defaults.yaml.
# Example: {"elo":[-500,3500],"sentiment":[-1,1]}
NEGELIR_DATASOURCE_FEATURE_RANGES_JSON=



# ── Mackolik Season IDs (Trendyol Süper Lig via arsiv.mackolik.com) ──
# Format: SEASON_LABEL=ID (used by fallback scraper)
MACKOLIK_SEASON_2025_2026=70381
MACKOLIK_SEASON_2024_2025=67287
MACKOLIK_SEASON_2023_2024=62682
MACKOLIK_SEASON_2022_2023=59539
MACKOLIK_SEASON_2021_2022=55775

# ── openfootball: Available Turkish Süper Lig season directories ──
# Comma-separated: season_dir:label pairs
OPENFOOTBALL_SEASONS=2018-19:2018-19,2019-20:2019-20,2020-21:2020-21,2024-25:2024-25,2025-26:2025-26

# ── football-data.co.uk: Season directory codes → labels ──
FOOTBALLDATA_UK_SEASONS=2526:2025-26,2425:2024-25,2324:2023-24,2223:2022-23,2122:2021-22,2021:2020-21,1920:2019-20,1819:2018-19

# ── Phase 12: Fault-injection & Chaos Testing (§12.4–§12.5) ──
# Enable in-process fault injection seam (DANGER: test-only).
# The FaultInjector is gated by this knob and an AST guard to prevent
# accidental production activation. Chaos targets refuse to run unless
# NEGELIR_INFRA_CHAOS_COMPOSE_PROFILE is active in docker-compose.
NEGELIR_INFRA_FAULT_INJECTION_ENABLED=false
# Compose profile name that enables chaos targets (Toxiproxy, Pumba, etc.)
NEGELIR_INFRA_CHAOS_COMPOSE_PROFILE=chaos

# ── Phase 12 §12.6 — Bus & Network Chaos Parameters ──
# Duration (seconds) to drop Redis mid-stream in chaos.redis-flap (1–60)
NEGELIR_INFRA_CHAOS_REDIS_FLAP_S=5
# Added latency (milliseconds) injected by Toxiproxy in chaos.network-slow (10–5000)
NEGELIR_INFRA_CHAOS_NET_ADDED_LATENCY_MS=500
# Fraction of envelopes to corrupt in chaos.bus-corrupt (0.001–0.1, i.e., 0.1%–10%)
NEGELIR_INFRA_CHAOS_BUS_CORRUPT_FRACTION=0.01

# ── Phase 12 §12.7 — Resource Exhaustion & Performance Parameters ──
# Timeout (seconds) for adversarial CPU-saturate input (30–300)
NEGELIR_INFRA_CHAOS_CPU_ADVERSARIAL_TIMEOUT_S=60
# Load regression tolerance for latency budgets (1.05–2.0, i.e., 5%–100% overage).
# A measured latency > baseline × this multiplier fails the gate.
NEGELIR_INFRA_LOAD_REGRESSION_TOLERANCE=1.10
# Phase 12 §12.7.2 noise-aware comparison: number of standard deviations to allow
# when comparing current load test results against baseline (1.5–3.0).
# Threshold = baseline_mean + (stdev_multiplier × baseline_stdev)
NEGELIR_INFRA_LOAD_BASELINE_STDEV_MULTIPLIER=2.0
# Phase 12 §12.7.2 hard-floor fallback: absolute minimum acceptable threshold in ms
# when noisy runners produce very small baseline stdev (50–1000 ms).
# Final threshold = max(computed, hard_floor).
NEGELIR_INFRA_LOAD_BASELINE_HARD_FLOOR_MS=500
# Directory where load test baselines are stored (JSON per surface/percentile).
# Format: <surface>_<percentile>.json (e.g., api_p99.json, nlp_p95.json)
NEGELIR_INFRA_LOAD_BASELINE_DIR=docs/reports/load-baselines

# ── Phase 12 §12.8 — Soak & Endurance Parameters ──
# Maximum allowed resource drift (RSS, FD count, key cardinality) during soak (0.5–5.0 %)
NEGELIR_INFRA_SOAK_RESOURCE_DRIFT_PCT=2.0
# Freshness requirement for the latest soak report (1–60 days). Stale reports
# block release gate but not PR/fast lanes per §12.13 lane discipline.
NEGELIR_INFRA_SOAK_REPORT_MAX_AGE_DAYS=30
# Duration (seconds) of nightly short soaks per scenario (600–3600, i.e., 10min–1h)
NEGELIR_INFRA_SOAK_NIGHTLY_DURATION_S=3600

# ── Phase 12 §12.11 — Disaster Recovery & Restoration ──
# Maximum wall-clock minutes to restore from backup (SLA gate).
NEGELIR_INFRA_DR_RESTORE_MAX_MIN=30

# ── Phase 12 §12.12 — Coverage & Mutation Testing ──
# Minimum mutation score (0.0–1.0) for security/integrity code (Tier-1).
# Mutations above this score are considered "killed" (test caught the change).
NEGELIR_INFRA_COVERAGE_MUTATION_MIN_SCORE=0.80
# Wall-clock budget (seconds) for nightly mutation testing campaign.
# Mutation is time-boxed to prevent long CI runs (phase 12 §12.12.4).
NEGELIR_INFRA_COVERAGE_MUTATION_BUDGET_S=1800
# Maximum `# pragma: no cover` / `//coverage:ignore` per module (anti-gaming).
# Exceeding this requires explicit reviewer ack + justification.
NEGELIR_INFRA_COVERAGE_PRAGMA_MAX_PER_MODULE=5

# ── Legacy (deprecated, 90-day alias window): ──
# The following env vars are in a deprecation window per Phase 18.7 ledger #28.
# They will be removed after the 90-day window expires (config fallback to NEGELIR_* equivalents).
# New configurations should use NEGELIR_<COMPONENT>_ prefixes instead.

# PostgreSQL connection (Python + Go server share these)
POSTGRES_HOST=postgres                                  # shared
POSTGRES_PORT=5432                                      # shared
POSTGRES_DB=negelir                                     # shared
POSTGRES_USER=negelir                                   # shared
# REQUIRED — generate a strong value, e.g. `openssl rand -hex 32`
POSTGRES_PASSWORD=replace_me_with_strong_secret         # shared

# Redis connection (Python + Go server share these)
REDIS_HOST=redis                                        # shared
REDIS_PORT=6379                                         # shared

# Go Server configuration (local dev only)
SERVER_URL=http://server:8080
SERVER_PORT=8080
DATABASE_URL=
REDIS_URL=
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT_SEC=5
DB_PING_TIMEOUT_SEC=5
DB_RETRY_DELAY_SEC=3
REDIS_RETRY_DELAY_SEC=2
HTTP_READ_TIMEOUT_SEC=10
HTTP_WRITE_TIMEOUT_SEC=30
HTTP_HANDLER_TIMEOUT_SEC=25
HTTP_SHUTDOWN_TIMEOUT_SEC=5
CACHE_MATCHES_TTL_SEC=300
CACHE_TEAMS_TTL_SEC=600

# Python runtime knobs (pre-date NEGELIR_ prefix)
AI_DEVICE=auto
AI_LOG_LEVEL=DEBUG

# Scraping configuration
SCRAPE_RATE_LIMIT_SECONDS=2
SCRAPE_USER_AGENT=Xops/0.1 (Football Analysis Research)
SCRAPE_RESPECT_ROBOTS_TXT=true
SCRAPE_PROFILE=mock
SCRAPE_HTTP_MAX_RETRIES=3

# Scraping: Primary Sources (in priority order)
SCRAPE_SOURCE_1=https://www.mackolik.com
SCRAPE_SOURCE_2=https://www.nesine.com
SCRAPE_SOURCE_3=https://www.tff.org
SCRAPE_SOURCE_4=https://raw.githubusercontent.com/openfootball/football.json/master
SCRAPE_SOURCE_5=https://www.football-data.co.uk/mmz4281
SCRAPE_SOURCE_FALLBACK=https://arsiv.mackolik.com
SCRAPE_SOURCE_EXTRA=

# ── Phase 12 §12.13 — CI Lanes & Flake Policy ──
# Days before a quarantined flaky test must be fixed or deleted.
# Quarantine is a hospital, not a graveyard (§12.13.2).
NEGELIR_INFRA_CI_FLAKE_QUARANTINE_MAX_DAYS=14
# Flake rate threshold (0.0–1.0) over rolling window. Tests crossing
# this rate are auto-quarantined (default 1% = 0.01).
NEGELIR_INFRA_CI_FLAKE_RATE_THRESHOLD=0.01

# ── Phase 18 §18.2 — Isolation Job Timeout ──
# Isolation job timeout in seconds. A build that fails at isolation
# short-circuits the rest of the pipeline within this limit.
NEGELIR_INFRA_CI_ISOLATION_MAX_SECONDS=60

# ── Phase 12 §12.14 — Chaos Observability & Resilience ──
# MTTD/MTTR budget (milliseconds) for detection/recovery. Scenarios exceeding
# this fail the resilience gate even if they eventually recover.
NEGELIR_INFRA_CHAOS_MTTD_BUDGET_MS=2000
# MTTR budget (milliseconds) for system recovery (used per-scenario baseline).
NEGELIR_INFRA_CHAOS_MTTR_BUDGET_MS=5000
# Trend regression threshold (percentage) vs last-green baseline. Scorecard
# regressions beyond this % block the release gate (§12.14.2).
NEGELIR_INFRA_CHAOS_TREND_REGRESSION_PCT=10.0

# ── Phase 16 — Emitter & Feed Contract ──
# Payload size cap per Record (bytes). Records exceeding this are truncated
# with truncated_at_bytes envelope field set and proof.flag{kind=record_oversize} raised.
NEGELIR_DATASOURCE_EMITTER_MAX_PAYLOAD_BYTES=65536
# Management port for emitter HTTP endpoints (e.g., GET /schemas for schema discovery).
# FeedReader uses this to verify schema consistency on startup (ledger #19).
NEGELIR_DATASOURCE_EMITTER_MANAGEMENT_PORT=9101
# Per-source fairness floor (%) — bursty sources throttled to at least this % of
# write capacity when quieter sources have pending writes (ledger #8, default 5%).
NEGELIR_DATASOURCE_EMITTER_PER_SOURCE_FLOOR_PCT=5.0
# Token bucket burst factor for per-source fairness; allows sources to accumulate
# up to burst_factor * floor_pct capacity (ledger #8, default 4x).
NEGELIR_DATASOURCE_EMITTER_SOURCE_BURST_FACTOR=4.0
# Token bucket window (seconds) over which source fairness is measured (default 1s).
NEGELIR_DATASOURCE_EMITTER_SOURCE_BURST_WINDOW_S=1.0
# Clock skew alert threshold (milliseconds); exceeding this emits sec.alert.v1 (default 500ms).
NEGELIR_DATASOURCE_EMITTER_CLOCK_SKEW_ALERT_MS=500.0
# Use CLOCK_TAI (International Atomic Time) for captured_at if available (default true).
# Falls back to CLOCK_REALTIME if TAI unavailable on the system.
NEGELIR_DATASOURCE_EMITTER_USE_CLOCK_TAI=true
# Fsync mode for durability: "always" (every write), "batch" (every N ms), "off" (test only).
# Default "always" for production (ledger #14).
NEGELIR_DATASOURCE_EMITTER_FSYNC_MODE=always
# Batch fsync interval (milliseconds) when fsync_mode=batch (default 100ms).
NEGELIR_DATASOURCE_EMITTER_FSYNC_BATCH_MS=100
# Compression codec for NDJSON (zstd|gzip|off; default zstd).
NEGELIR_DATASOURCE_EMITTER_COMPRESSION_CODEC=zstd
# Compression level (1-22 for zstd; default 9 for balance).
NEGELIR_DATASOURCE_EMITTER_COMPRESSION_LEVEL=9
# Per-record CRC32C checksum trailer for torn-write detection (ledger #10, default on).
NEGELIR_DATASOURCE_EMITTER_RECORD_CRC=on
# Disk usage warning threshold (%, default 80). >= warn → sec.alert.v1{kind=feeds_disk_warn}
NEGELIR_DATASOURCE_EMITTER_DISK_USAGE_WARN_PCT=80
# Disk usage block threshold (%, default 95). >= block → writer pauses, proof.flag{kind=feeds_disk_blocked}
NEGELIR_DATASOURCE_EMITTER_DISK_USAGE_BLOCK_PCT=95
# Intra-day compaction threshold (bytes, default 256 MiB). When hot file exceeds this, rotate to part-NN.
NEGELIR_DATASOURCE_EMITTER_INTRADAY_COMPACT_BYTES=268435456

# Manifest update frequency (seconds, default 30). How often to persist manifest metrics (bullet 9).
NEGELIR_DATASOURCE_EMITTER_MANIFEST_UPDATE_INTERVAL_S=30

# Manifest max age before alarm (ms, default 30000). Alert if manifest > this old.
NEGELIR_DATASOURCE_EMITTER_MANIFEST_MAX_AGE_MS=30000
# Phase 16.5 — Emitter snapshot (immutable historical states) configuration
# Maximum parquet partition file size (bytes, default 128 MiB); triggers rollover when exceeded.
NEGELIR_DATASOURCE_EMITTER_PARQUET_MAX_PART_BYTES=134217728
# Grace period (minutes) after snapshot boundary before snapshot becomes frozen (default 10 min).
NEGELIR_DATASOURCE_EMITTER_SNAPSHOT_GRACE_MINUTES=10
# Snapshot writer concurrency (threads); parallelizes snapshot production per source (default 4).
NEGELIR_DATASOURCE_EMITTER_SNAPSHOT_WRITER_THREADS=4
# Bloom filter false-positive rate cap for snapshot indexes; higher = smaller indexes, slower queries (default 0.01).
NEGELIR_DATASOURCE_EMITTER_SNAPSHOT_BLOOM_FPR_MAX=0.01
# Snapshot mode: 'full' (absolute state) or 'delta' (changes from prior snapshot, default 'delta').
NEGELIR_DATASOURCE_EMITTER_SNAPSHOT_MODE=delta
# Snapshot compaction window (hours); older snapshots eligible for merge to reduce file count (default 24h).
NEGELIR_DATASOURCE_EMITTER_SNAPSHOT_COMPACTION_HOURS=24

# ── Phase 16.4 — FeedReader configuration ──
# Tombstone LRU size for stream() when apply_tombstones=True.
# Tracks (stable_id) → tombstoned state with bounded memory (default 50k).
NEGELIR_DATASOURCE_FEED_READER_TOMBSTONE_LRU_SIZE=50000
# Dedup LRU size for stream() when using FeedReader.dedup().
# Bounded LRU keyed by sha256(stable_id || captured_at) (default 100k).
NEGELIR_DATASOURCE_FEED_READER_DEDUP_LRU_SIZE=100000

# Phase 16.4 — Bounded-memory streaming + projection/predicate pushdown (ledger #23)
# Per-call resident memory hard cap for snapshot() in MiB (default 512).
NEGELIR_DATASOURCE_FEED_READER_PER_CALL_MAX_RESIDENT_MB=512
# Batch size for iter_snapshot() streaming yields (default 4096 rows).
NEGELIR_DATASOURCE_FEED_READER_BATCH_ROWS=4096

# ─────────────────────────────────────────────────────────────────────────────
# Phase 21 — Enrichment Data Planes (Planes 6–9 + derived views)
# ─────────────────────────────────────────────────────────────────────────────

# Feature-flag gates for each enrichment plane and derived view
ENRICHMENT_ROSTER_ENABLED=true
ENRICHMENT_HEALTH_ENABLED=true
ENRICHMENT_OFFICIALS_ENABLED=true
ENRICHMENT_ENVIRONMENT_ENABLED=true
ENRICHMENT_MARKET_MOVEMENT_ENABLED=true
ENRICHMENT_FIXTURE_CONGESTION_ENABLED=true
ENRICHMENT_CARD_CONTEXT_ENABLED=true
ENRICHMENT_NARRATIVE_PRESSURE_ENABLED=true

# Plane 6 — Roster-state (transfers, contracts, suspensions) tunables
# Cohesion penalty decay curve over first 4 appearances (4 comma-separated floats, one per appearance)
ENRICHMENT_COHESION_PENALTY_CURVE=0.15,0.10,0.05,0.02
# Departure shock coefficient for top-quartile players leaving within 14 days
ENRICHMENT_DEPARTURE_SHOCK=0.05
# Roster plane staleness alert threshold (seconds; default 24h = 86400)
ENRICHMENT_ROSTER_STALE_S=86400
# Cron expression for roster scrape cadence (daily during windows, weekly off-window)
ENRICHMENT_ROSTER_CRON=0 4 * * 1-5

# Plane 7 — Health (injuries, availability) tunables
# Health plane staleness alert threshold (seconds; default 12h = 43200)
ENRICHMENT_HEALTH_STALE_S=43200
# Doubtful-ratio threshold above which proofreader widens CIs (§21.2)
ENRICHMENT_HEALTH_CI_WIDEN_THRESHOLD=0.30

# Plane 8 — Officials (referee assignments & rolling stats) tunables
# Officials plane staleness alert threshold (seconds; default 2h = 7200)
ENRICHMENT_OFFICIALS_STALE_S=7200
# Referee home-bias correction clamp (fraction of win rate that can be attributed to home bias)
ENRICHMENT_REFEREE_HOME_BIAS_CLAMP=0.15
# Rolling-stats window: max number of previous matches to include in referee avg calculation
ENRICHMENT_REFEREE_WINDOW_MATCHES=50
# Max referee rolling-stats recomputes per batch cycle
ENRICHMENT_REFEREE_BATCH_MAX=50

# Plane 9 — Environment (weather, pitch) tunables
# Environment plane staleness alert threshold (seconds; default 6h = 21600)
ENRICHMENT_ENVIRONMENT_STALE_S=21600
# Max age of weather forecast before falling back to actual or emitting warning (hours)
ENRICHMENT_WEATHER_FORECAST_MAX_AGE_H=6
# Wind speed threshold above which xG is reduced (kph)
ENRICHMENT_WIND_THRESHOLD_KPH=40.0
# Precipitation threshold above which shooting accuracy is reduced (mm/hr)
ENRICHMENT_RAIN_THRESHOLD_MM=5.0
# Penalty for passing-style teams on worn/muddy/frozen pitches
ENRICHMENT_SURFACE_STYLE_PENALTY=0.04

# Derived view 1 — Market-movement tunables
# Drift threshold above which the "high_drift_flag" is set (fraction of total probability)
ENRICHMENT_DRIFT_HIGH_THRESHOLD=0.10

# Derived view 2 — Fixture-congestion and environmental coupling
# XG decay coefficient for fixture congestion (calibrated per §21.11)
ENRICHMENT_CONGESTION_XG_DECAY=0.065

# Derived view 4 — Narrative-pressure (editorial sentiment over 72h pre-KO)
# Minimum number of articles required to compute sentiment score (below threshold = no alert)
ENRICHMENT_NARRATIVE_MIN_ARTICLES=3
# NLP intent confidence floor for injury_lookup intent (higher than baseline 0.60 for safety)
NLP_INJURY_LOOKUP_CONFIDENCE_THRESHOLD=0.70

# Cross-plane and storage tunables
# Redis cache TTL for roster/health/officials plane features (seconds; default 5 min = 300)
ENRICHMENT_CACHE_TTL_S=300
# Redis cache TTL for environment plane features (shorter for hourly weather changes)
ENRICHMENT_ENV_CACHE_TTL_S=60

# Circuit-breaker settings for per-plane fault isolation (§21.19)
# Consecutive failures before per-plane circuit breaker opens
ENRICHMENT_CIRCUIT_FAILURE_THRESHOLD=5
# Window in which failures are counted (seconds)
ENRICHMENT_CIRCUIT_WINDOW_S=60
# Breaker cooldown before entering half-open state (seconds)
ENRICHMENT_CIRCUIT_COOLDOWN_S=300

# Derived-view reactor settings
# Event coalescing window for derived-view reactors (§21.5)
ENRICHMENT_DERIVED_VIEW_COALESCE_MS=250
# Hourly dedup window for weather forecast inserts (to prevent hourly duplicates)
ENRICHMENT_WEATHER_DEDUP_WINDOW_S=3600

# Storage-agent enrichment writer pool settings
# Max connections in the enrichment writer pool
DB_POOL_MAX_ENRICHMENT=5
# Enrichment feed backpressure threshold (receive buffer depth at which writer pauses)
ENRICHMENT_FEED_BACKPRESSURE_THRESHOLD=10000
# Base delay in ms for exponential back-off when feed buffer is full
ENRICHMENT_FEED_BACKPRESSURE_RETRY_BASE_MS=200
# Max back-off retries before routing in-flight write to DLQ
ENRICHMENT_FEED_BACKPRESSURE_MAX_RETRIES=5

# Enrichment scraper settings
# HTTP request timeout for each enrichment source extractor (seconds)
ENRICHMENT_SCRAPER_TIMEOUT_S=30
# Per-request HTTP retry count before marking cycle as failed
ENRICHMENT_SCRAPER_RETRY_MAX=3
# Base exponential back-off delay between per-request retries (milliseconds)
ENRICHMENT_SCRAPER_RETRY_BACKOFF_MS=500

# External data sources and paths
# Weather API URL — **REQUIRED** (no hardcoded default; operator must set this)
WEATHER_API_URL=
# JSON file listing international break windows per confederation
ENRICHMENT_CONFEDERATION_CALENDAR_PATH=data/confederation_calendars.json
# Fallback mean values file (written by `make calibration.enrichment`)
ENRICHMENT_FALLBACK_VALUES_PATH=data/enrichment_fallback_values.json
# Flag file written by retrain gate when all four planes reach 1.0.0
ENRICHMENT_RETRAIN_FLAG_PATH=data/enrichment_retrain_needed.flag

# Calibration and backfill settings
# Random seed for enrichment calibration holdout harness (for reproducibility)
ENRICHMENT_CALIBRATION_SEED=42
# Backfill mode: when true, disables coalescing and bus emission for derived-view reactors
ENRICHMENT_BACKFILL_MODE=false

# Derived-view reactor monitoring and staleness detection (§21.27, §21.29)
# Redis TTL for derived-view reactor heartbeat keys (seconds)
ENRICHMENT_REACTOR_HEARTBEAT_TTL_S=60
# How often the reactor watchdog checks heartbeat keys (seconds)
ENRICHMENT_REACTOR_WATCHDOG_INTERVAL_S=30
# Consecutive missed heartbeats before watchdog emits escalation
ENRICHMENT_REACTOR_STALL_ESCALATION_COUNT=3
# Go API enrichment-health endpoint per-plane stale threshold (seconds)
ENRICHMENT_HEALTH_STALE_THRESHOLD_S=3600
# Cross-plane consistency checker interval (seconds)
ENRICHMENT_CONSISTENCY_CHECK_INTERVAL_S=3600
# Promotion logloss delta threshold for market-tier gating
ENRICHMENT_PROMOTION_LOGLOSS_DELTA=0.005

# ── Paths ──
DATA_DIR=/data
MODEL_DIR=/data/models
