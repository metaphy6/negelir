# ─────────────────────────────────────────────────────────────────────────────
# Negelir — environment variable template (LOCAL DEV)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to xops/env/.env (or run `make env`) and adjust as
# needed. Compose loads it via `env_file:` per service AND via
# `--env-file xops/env/.env` (auto-injected by xops/makefile/_common.py)
# for its own ${VAR} substitution. The Python config layer reads each
# variable below with `os.getenv(...)` defaults that match the values
# shown here.
#
# Naming convention
# -----------------
#   NEGELIR_*       AI / scraper / scheduler / training knobs (ai/common/config.py)
#   SCRAPE_*        Scraper sources & HTTP behaviour (cross-cutting)
#   POSTGRES_*      Postgres connection (Python + Go server share these)
#   REDIS_*         Redis connection (Python + Go server share these)
#   MACKOLIK_*      Mackolik archive season IDs (data layer constants)
#   OPENFOOTBALL_*  openfootball season list (data layer)
#   FOOTBALLDATA_*  football-data.co.uk season codes (data layer)
#   AI_*            Python runtime knobs that pre-date the NEGELIR_ prefix
#                   and stayed for backward compatibility
#   DB_*, HTTP_*,   Go server only (read in server/cmd/main.go); listed here
#   CACHE_*,        so docker-compose has a single source of truth
#   SERVER_*
#
# Precedence (highest → lowest):
#   1. exported shell env var
#   2. .env file (loaded by docker-compose / direnv) at xops/env/.env
#   3. hardcoded default in ai/common/config.py
#   4. canonical reference: ai/common/defaults.yaml
#
# `tests/test_config_sync.py` enforces that every NEGELIR_* / SCRAPE_* key
# documented here is actually consumed by the Python config layer, and vice
# versa. Add new env vars in BOTH places.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (local dev only) ──
# `# shared` keys are read by BOTH Python (ai/common/config.py) and
# Go (server/internal/config/config.go). Sync test enforces parity.
POSTGRES_HOST=postgres                                  # shared
POSTGRES_PORT=5432                                      # shared
POSTGRES_DB=negelir                                     # shared
POSTGRES_USER=negelir                                   # shared
# REQUIRED — generate a strong value, e.g. `openssl rand -hex 32`
POSTGRES_PASSWORD=replace_me_with_strong_secret         # shared

# ── Redis (local dev only) ──
REDIS_HOST=redis                                        # shared
REDIS_PORT=6379                                         # shared

# ── Go Server (local dev only) ──
SERVER_URL=http://server:8080
SERVER_PORT=8080
DATABASE_URL=
REDIS_URL=
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT_SEC=5
DB_PING_TIMEOUT_SEC=5
DB_RETRY_DELAY_SEC=3
REDIS_RETRY_DELAY_SEC=2
HTTP_READ_TIMEOUT_SEC=10
HTTP_WRITE_TIMEOUT_SEC=30
# Per-handler compute cap (must be < HTTP_WRITE_TIMEOUT_SEC). Pre-Phase-6
# audit round-3 G2: prevents a runaway handler from monopolising a pgx
# connection past the client's TCP-level timeout.
HTTP_HANDLER_TIMEOUT_SEC=25
HTTP_SHUTDOWN_TIMEOUT_SEC=5
CACHE_MATCHES_TTL_SEC=300
CACHE_TEAMS_TTL_SEC=600

# ── AI ──
AI_DEVICE=auto
AI_LOG_LEVEL=DEBUG
# Set NEGELIR_STRICT=1 to make Config.validate() reject any unknown env key
# matching reserved prefixes (NEGELIR_*, SCRAPE_*, SWARM_*). Off by default.
NEGELIR_STRICT=0

# ── Runtime Defaults ──
NEGELIR_DEFAULT_LEAGUE_ID=super_lig
# Leave NEGELIR_DEFAULT_SEASON empty to auto-derive from today's date
# ("YYYY-YYYY+1", July rollover). Set explicitly only to pin a season.
NEGELIR_DEFAULT_SEASON=
NEGELIR_MACKOLIK_GROUP_ID=1
NEGELIR_MACKOLIK_LEAGUE_FILTER=Süper Lig

# ── Timeouts ──
NEGELIR_SERVER_FETCH_TIMEOUT=10
NEGELIR_SCRAPE_TRIGGER_TIMEOUT=30
NEGELIR_HEALTH_CHECK_TIMEOUT=5
NEGELIR_MACKOLIK_HTTP_TIMEOUT=15
NEGELIR_SCRAPE_HTTP_TIMEOUT=15
NEGELIR_FOOTBALLDATA_HTTP_TIMEOUT=10

# ── Scheduler ──
NEGELIR_SCHEDULE_DAILY_SCRAPE_HOUR=6
NEGELIR_SCHEDULE_DAILY_SCRAPE_MINUTE=0
NEGELIR_SCHEDULE_OUTCOME_CHECK_HOUR=22
NEGELIR_SCHEDULE_OUTCOME_CHECK_MINUTE=0
NEGELIR_SCHEDULE_RETRAIN_DAY=sun
NEGELIR_SCHEDULE_RETRAIN_HOUR=3
NEGELIR_SCHEDULE_HEARTBEAT_MINUTES=5

# ── Scraping ──
SCRAPE_RATE_LIMIT_SECONDS=2
NEGELIR_REAL_DATA_RATE_LIMIT=1.0
SCRAPE_USER_AGENT=Xops/0.1 (Football Analysis Research)
SCRAPE_RESPECT_ROBOTS_TXT=true

# ── Self-Healing / Failover ──
NEGELIR_SOURCE_PRIORITY=source_a,source_b,source_c,source_d
NEGELIR_STALE_THRESHOLD_SECONDS=604800
NEGELIR_STALE_CONFIDENCE_PENALTY=0.5
NEGELIR_SOURCE_FAILURE_THRESHOLD=3

# ── Model / Training ──
NEGELIR_DRIFT_WINDOW=30
NEGELIR_DRIFT_FLOOR=0.35
NEGELIR_TRAINING_NOISE_PCT=0.005
NEGELIR_TRAINING_TEST_SPLIT=0.2
NEGELIR_TRAINING_SEED=42
NEGELIR_TRAINING_CROSS_SOURCE_AGREEMENT_MULTI=0.95
NEGELIR_MODEL_MAX_SIZE_MB=8.0
NEGELIR_TRAINING_SAMPLE_WEIGHTS=1.0,2.0,1.0

# ── NLP (Phase 10) ──
# Proofreader gate 3: length bounds (§10.9 bullet 2).
NEGELIR_NLP_MIN_ANSWER_CHARS=20
NEGELIR_NLP_MAX_ANSWER_CHARS=600
# §10.19 backpressure — when qa.intent.v1 queue depth exceeds this threshold,
# disable humanizer, widen cache TTL 2x, and emit nlp.alert.v1.
NEGELIR_NLP_QUEUE_PRESSURE_THRESHOLD=100
# §10.19 backpressure — duration (seconds) to run in template-only mode after
# backpressure is triggered.
NEGELIR_NLP_PRESSURE_HUMANIZE_OFF_S=60
# §10.19 sampled answer audit — 1-in-N sampling rate for offline quality review.
NEGELIR_NLP_ANSWER_SAMPLE_INVERSE=1000
# §10.19 sampled answer audit — daily cap on captured answers.
NEGELIR_NLP_ANSWER_SAMPLE_DAILY_CAP=5000
# §10.21.7 PII log filter — redact long unrecognized strings in logs.
NEGELIR_NLP_LOG_MAX_UNREDACTED_STR_LEN=64
# L0 intent cache (§10.12).
# In-process LRU cache keyed on sha256(normalized_text|locale).
# Negative-caches meta.unsupported only; never caches predict.* intents.
NEGELIR_NLP_INTENT_CACHE_MAX_ENTRIES=10000
NEGELIR_NLP_INTENT_CACHE_TTL_S=300
# §10.12 L1 answer cache (Phase 4 cache.v1 plane reuse)
NEGELIR_NLP_ANSWER_CACHE_TTL_DATA_S=120
NEGELIR_NLP_ANSWER_CACHE_TTL_PREDICT_S=60

# ── Telemetry ──
NEGELIR_TELEMETRY_MAX_STREAM=50000
NEGELIR_REDIS_SOCKET_TIMEOUT=2
# Phase 8.16.4 — cardinality-safe ack metrics debug gate.
# false (default, prod): emit only low-cardinality maint_ack_total{accepted_by, accepted}.
# true (dev / incident triage): also emit maint_ack_total_debug{kind, accepted_by, accepted}.
NEGELIR_TELEMETRY_DEBUG_ENABLED=false
# Boot guard: refuse to enable debug mode if projected series > this ceiling.
NEGELIR_TELEMETRY_DEBUG_MAX_SERIES=5000

# ── Swarm SDK (Phase 3) ──
# Bus implementation: "redis" (Redis Streams; default) or "memory" (in-process,
# tests only — picks the InMemoryBus, ignores Redis).
SWARM_BUS_KIND=redis
# Consumer-group prefix; final group name is "<prefix>:<agent_name>".
SWARM_CONSUMER_GROUP_PREFIX=swarm
# Heartbeat cadence; supervisor marks an instance stale after 3× this value.
SWARM_HEARTBEAT_SEC=5  # shared
# TTL on the agent_registry hash entry (seconds). Auto-evicted by Redis if the
# instance dies without deregistering. Should be > 3× SWARM_HEARTBEAT_SEC.
SWARM_REGISTRY_TTL_SEC=30
# Max messages an agent claims at once (per-instance backpressure cap).
SWARM_MAX_IN_FLIGHT=32
# Per-message retry budget before the message goes to <topic>.dlq.
SWARM_RETRY_BUDGET=3
# Hard cap on the dead-letter stream length (Redis MAXLEN ~).
SWARM_DLQ_MAX_LEN=10000
# Time after which a pending (claimed-but-not-acked) message is reclaimed by
# another consumer via XAUTOCLAIM. Should be > p99(handler latency).
SWARM_PENDING_CLAIM_SEC=60
# HTTP port where each agent exposes /metrics in Prometheus text format.
SWARM_METRICS_PORT=9100

# ── Phase 4: Worker agents (scrape → categorize → process → store) ──
# Resolves scraper targets to mock vhosts (mock) or real upstreams (real).
# Tests + dev MUST stay on `mock`; only production sets `real`.
SCRAPE_PROFILE=mock
# Cross-cutting deployment profile (mock|prod). `prod` flips fail-safe
# gates that refuse insecure configs outright (e.g. the §8.3 backup
# `fail_safe_no_encryption_in_prod` boot refusal). Keep `mock` in dev.
NEGELIR_PROFILE=mock
# Hard cap on per-fetch retries before a `scrape.request` lands in the DLQ.
SCRAPE_HTTP_MAX_RETRIES=3
# Categorizer confidence floor; below this → proof.flag, never scrape.classified.
NEGELIR_CATEGORIZER_MIN_CONF=0.55
# On-disk path the categorizer loads its trained LinearSVC from (Phase 4.2.b).
NEGELIR_CATEGORIZER_MODEL_PATH=data/models/categorizer_v1.joblib
# Cache TTLs (seconds). Records are larger and slower-moving than predictions.
NEGELIR_CACHE_RECORD_TTL_SEC=600
NEGELIR_CACHE_PREDICTION_TTL_SEC=300
# Telemetry agent's Prometheus exposer port (separate from per-agent SDK port).
NEGELIR_TELEMETRY_METRICS_PORT=9101
# Bind address for the telemetry exposer. Defaults to loopback so an
# unauthenticated /metrics endpoint is not exposed on every interface.
# Override to 0.0.0.0 only when the network policy / firewall in front
# of the container actually restricts access.
NEGELIR_TELEMETRY_METRICS_BIND=127.0.0.1
# Reactors drop events older than this (replay window upper bound).
NEGELIR_REACTOR_MAX_EVENT_AGE_SEC=86400
# Cap on the per-reactor in-memory idempotency ledger (LRU eviction
# of oldest entries). Prevents unbounded memory growth on long-running
# swarms or backtest replays. Production should swap in the Postgres
# ledger; this knob only bounds the dev / tests / single-process path.
NEGELIR_REACTOR_LEDGER_MAX_SIZE=100000

# ── Phase 5: Predictor swarm + consensus ──
# Consensus collection window: how long `consensus.v1` waits for `predict.vote`
# messages before fusing the votes it has, in milliseconds. Closes early once
# every healthy predictor (per agent_registry) has voted.
NEGELIR_CONSENSUS_WINDOW_MS=750                                    # shared
# Per-vote confidence floor: votes with confidence < this are dropped silently
# (the swarm simply has one fewer voter). Default 0.0 = filter disabled, so
# baseline predictors (e.g. Elo at ~0.32) still contribute. Raise once your
# roster's confidences are calibrated and meaningful (typically post Phase 6
# proofreader feedback). SWARM.md consensus algo step 2.
NEGELIR_CONSENSUS_MIN_CONFIDENCE=0.0
# Minimum number of voting predictors before consensus is considered healthy.
# Fewer voters → `predict.final.degraded=true` + degraded_reason set.
NEGELIR_CONSENSUS_MIN_VOTERS=3
# Rolling Brier-score window (matches) used to learn per-predictor weights.
NEGELIR_CONSENSUS_BRIER_WINDOW=200
# Hard cap on consensus' in-flight pending-fusion set. Protects against
# unbounded growth if predictors permanently DLQ or `flush_expired` is not
# called by the runner. Overflow evicts oldest + emits proof.flag
# (kind=consensus_overflow).
NEGELIR_CONSENSUS_MAX_PENDING=4096
# Suppression window (seconds) for repeat `consensus.overflow` proof.flag
# emissions. When the pending set is saturated every new vote triggers
# eviction; without suppression that floods proof.flag with the same
# signal. Set 0 to disable suppression.
NEGELIR_CONSENSUS_OVERFLOW_FLAG_MIN_INTERVAL_SEC=10
# Opt-in for `pred.lgbm_market.v1`. Default off — requires odds-record coverage.
NEGELIR_PREDICTOR_MARKET_FEATURES_ENABLED=false
# Per-predictor GPU VRAM ceiling (MB). Phase 11 enforcement; Phase 5 documents.
NEGELIR_PREDICTOR_MAX_VRAM_MB=1024
# Trainer reactor debounce window per (predictor_id, league) seconds.
NEGELIR_TRAINER_DEBOUNCE_SEC=300
# Backtest CI gate: swarm log-loss must beat best individual predictor by at
# least this fraction (e.g. 0.01 = 1% improvement) per (league, market).
NEGELIR_BACKTEST_SWARM_FLOOR_PCT=0.01
# Backtest replay window in weeks. `make backtest WEEKS=N` overrides.
NEGELIR_BACKTEST_WINDOW_WEEKS=12
# Minimum match count per (league, market) for the backtest gate to apply.
NEGELIR_BACKTEST_MIN_N=20
# Phase 9 SLA budget: API request timeout ≥ consensus_window_ms + this overhead.
# Documented here; enforced by the API gateway in Phase 9.
NEGELIR_API_CONSENSUS_OVERHEAD_MS=200                              # shared
# Phase 9 §9.0 §3.3: total API request timeout must cover the full prediction
# path (consensus_window_ms + proofreader_quorum_window_ms + api_consensus_overhead_ms
# + api_transit_jitter_ms). Config validator rejects values below the sum.
# Default 2500 ms (≥ 750 + 200 + 200 + 100 = 1250 ms).
NEGELIR_API_REQUEST_TIMEOUT_MS=2500                                # shared
# Phase 9 §9.3 — transit jitter budget added to the timeout-budget inequality
# to absorb network/scheduling jitter between the API pod and bus/consensus.
# Must be ≥ 0. Default 100 ms.
NEGELIR_API_TRANSIT_JITTER_MS=100                                  # shared
# Phase 9 §9.1 — time discipline. Only "iso8601_utc" is accepted;
# validator rejects any other value. Placeholder for a future "rfc9557" flag.
NEGELIR_API_TIME_FORMAT=iso8601_utc                                # shared
# Phase 9 §9.1 — opaque cursor TTL in seconds (default 30 min).
# AES-GCM encrypted pagination cursors are rejected with 400 invalid_cursor
# after this many seconds. Rotated alongside JWT keys (§9.2).
NEGELIR_API_CURSOR_TTL_S=1800                                      # shared

# Phase 9 §9.1 — body-size cap (bcrypt-bomb / RAM-exhaustion defense, applied
# before handler dispatch via http.MaxBytesReader). Sub-caps must be ≤ the
# global cap; Validate() enforces this at startup.
# Global cap on every incoming request body (default 64 KB = 65536 bytes).
NEGELIR_API_REQUEST_MAX_BYTES=65536                                # shared
# /v1/qa body sub-cap (default 4 KB; tightened to reduce LLM prompt-injection surface).
NEGELIR_QA_INPUT_MAX_BYTES=4096                                    # shared
# /v1/auth/login body sub-cap (default 4 KB; blocks bcrypt-bomb payloads early).
NEGELIR_AUTH_LOGIN_MAX_BYTES=4096

# Phase 9 §9.2 — bcrypt cost. OWASP 2024 floor is 12; valid range [10, 14].
# Startup probe hashes one test password at this cost; refuses boot if < 100 ms.
NEGELIR_API_BCRYPT_COST=12                                         # shared
# Phase 9 §9.2 — JWT RS256 key-store directory (private keys live here at mode 0400).
# DB (jwt_keys table, migration 014) is the source of truth; disk holds key material.
NEGELIR_API_JWT_KEY_DIR=data/api/jwt_keys
# Phase 9 §9.2 — how often (seconds) each replica polls the keystore dir for new keys.
# The poll is an optimisation; DB lookup is the authoritative fallback on cache miss.
NEGELIR_API_JWT_KEY_POLL_S=10                                      # shared
# Phase 9 §9.2 — grace period (seconds) after a key is retired before its priv file is
# zeroized and removed. Must be >= api_access_ttl_s + 60 s. Default 960 s (900+60).
NEGELIR_API_JWT_RETIRED_GRACE_S=960                                # shared
# Phase 9 §9.14 — clock-skew tolerance for JWT exp/nbf validation (seconds).
# Tokens whose exp is in the past by at most this many seconds are still accepted,
# covering minor clock drift between issuer and verifier. OWASP: keep <= 60 s.
# Values > 300 s are rejected by Validate(). Default 30 s.
NEGELIR_API_JWT_CLOCK_SKEW_S=30                                    # shared
# Phase 9 §9.2 — token shape: access JWT TTL (seconds). Default 900 s (15 min).
NEGELIR_API_ACCESS_TTL_S=900                                       # shared
# Phase 9 §9.2 — token shape: refresh token TTL (seconds). Default 2592000 s (30 days).
NEGELIR_API_REFRESH_TTL_S=2592000                                  # shared
# Phase 9 §9.2 — token shape: replay grace window for single-use refresh tokens (seconds).
# Within this window a superseded refresh token is accepted once for idempotency.
# After the window a replay triggers 401 + sec.alert.v1{kind=refresh_token_replay}. Default 30 s.
NEGELIR_API_REFRESH_REPLAY_GRACE_S=30                              # shared
# Maximum JTIs in the access-token revocation deny-set (auth:rev:idx). Oldest entries
# are evicted (LRU) when the cap is exceeded. Alert fires at 80% via sec.alert.v1.
NEGELIR_API_REVOCATION_SET_MAX=10000                               # shared
# Phase 9 §9.2 — self-registration. When false (default), POST /v1/auth/register
# returns 403 forbidden. Set true to open registration (e.g. staging/onboarding).
NEGELIR_API_SELF_REGISTRATION_ENABLED=false                        # shared
# Per-/24 (IPv4) or /64 (IPv6) subnet cap on registrations per hour when
# self-registration is enabled. Prevents mass-account-spray. Default 20.
NEGELIR_API_REGISTER_CAP_PER_SUBNET_PER_H=20                      # shared
# Phase 9 §9.2 — mTLS to internal services.
# When true, the API dials Redis, Postgres, and the bus with a client cert from
# NEGELIR_API_TLS_DIR, verified by the Phase 2 internal CA. Boot probe checks
# each connection before the public listener opens; hard boot refusal on failure.
# Set false for local dev (no certs required). Set true in staging/production.
NEGELIR_API_MTLS_ENABLED=false
# Directory holding the API mTLS cert bundle (ca.crt, client_{redis,pg,bus}.{crt,key}).
# Private key files must be mode 0400. Default: data/api/tls
NEGELIR_API_TLS_DIR=data/api/tls
# Phase 9 §9.3 — per-pod reply_to stream reaper interval (seconds).
# The API reaper sweeps orphaned api.reply.* Redis Streams left by requests
# that timed out or whose pod crashed. Streams are deleted when they are
# older than cfg.api_request_timeout_ms and still present. Default 60 s.
NEGELIR_API_REPLY_REAPER_S=60                                      # shared
# Phase 9 §9.3 — idempotency-key cache TTL (seconds). Completed idempotent
# requests are replayed from Redis cache for this duration when the client
# resends the same Idempotency-Key + body. Default 86400 s (24 h).
NEGELIR_API_IDEMPOTENCY_TTL_S=86400                                # shared
# Phase 9 §9.3 — inflight wait timeout (ms). Second request for the same
# Idempotency-Key while the first is processing blocks on a Redis pubsub
# channel for this duration before returning 425 too_early. Default 1500 ms.
NEGELIR_API_IDEMPOTENCY_INFLIGHT_WAIT_MS=1500                      # shared
# Phase 9 §9.9 — backpressure threshold for predict.request.v1.
# The §8.x scaler writes Redis key api:backpressure:on (TTL 30 s) when
# XLEN(predict.request.v1) exceeds this value. The API reads that flag to
# engage cache-only mode (GET passes to cache; POST /v1/qa → 425 too_early).
# The API never reads XLEN directly and never writes to the maint plane.
# Default 5000.
NEGELIR_API_PREDICT_REQUEST_BACKLOG_HIGH=5000                      # shared
# Phase 9 §9.9 — connection cap / concurrency semaphore.
# Maximum number of concurrently in-flight requests per API pod.
# ConcurrencyLimit middleware uses a buffered channel as a counting semaphore;
# overflow (all slots occupied) returns HTTP 503 immediately with X-Overflow: true.
# Default 5000.
NEGELIR_API_MAX_CONCURRENT_REQUESTS=5000                           # shared
# Phase 9 §9.9 — response-side backpressure (slow-client abort).
# When the handler has been waiting longer than this value (milliseconds) for
# the client's TCP send buffer to drain, the SlowClientAbort middleware sets
# status=499 client_disconnected and aborts the handler chain. This prevents
# goroutines from being blocked indefinitely on a slow or stalled client
# (DoS surface). The http.Server WriteTimeout (HTTP_WRITE_TIMEOUT_SEC) is the
# hard OS-level cutoff; this knob governs the semantic abort threshold.
# Default 5000 ms (5 s).
NEGELIR_API_RESPONSE_WRITE_TIMEOUT_MS=5000                         # shared
# Phase 9 §9.3 — stale-while-revalidate (SWR) cache knobs for the predictions endpoint.
# STALE_AFTER_S: age (seconds) above which a cache entry is served stale while an async
# predict.request refresh is triggered in the background. Default 30 s.
NEGELIR_API_CACHE_STALE_AFTER_S=30                                 # shared
# MAX_AGE_S: age (seconds) above which a cache entry is treated as a cache miss (RPC
# issued). Must be > NEGELIR_API_CACHE_STALE_AFTER_S. Default 300 s.
NEGELIR_API_CACHE_MAX_AGE_S=300                                    # shared
# SWR_INFLIGHT_MAX: pod-level cap on concurrent async SWR refresh goroutines.
# A Redis SETNX gate per (match_id, market_set) limits to 1 inflight per pair;
# this counter caps total goroutines across the pod. Default 64.
NEGELIR_API_SWR_INFLIGHT_MAX=64                                    # shared
# Phase 9 §9.7 — burst budget. Per-subject GCRA token-bucket capacity (max tokens
# accumulated while the client is idle). Cost-aware: /v1/qa costs 5 tokens,
# /v1/healthz costs 0 (per endpoint_costs.yaml). Default 60.
NEGELIR_API_BURST_CAPACITY=60                                      # shared
# Tokens added to each subject's bucket per second of idle time. Default 2.0.
NEGELIR_API_BURST_REFILL_PER_S=2.0                                 # shared
# Phase 9 §9.7 — tier quota enforcement flag. Built-but-dormant until Phase 20.
# When false (the default) the TierQuota middleware is a no-op pass-through.
# Set true to enforce per-tier daily_request_cap from the tiers table.
NEGELIR_API_TIER_ENFORCEMENT_ENABLED=false                         # shared
# Phase 9 §9.2 — OIDC plug-point.
# These three vars are checked by auth.LoadProvider() at startup. When ALL are
# absent (the default) LoadProvider returns the NoopProvider and OIDC routes
# return 501 Not Implemented. Phase 20+ will wire a real provider here.
# FORBIDDEN in v1: bundling Google / Microsoft / GitHub SDKs (doctrine §9.2).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Phase 9 §9.15 / Phase 11 (compute) boundary — the API binary is built cpu_only;
# cgo CUDA paths are excluded at compile time via the //go:build cpu_only tag on
# cmd/api/main.go. The only valid value is "cpu_only". Phase 11 may extend this
# to "gpu_optional" under a feature flag.
NEGELIR_COMPUTE_CLASS=cpu_only

# Phase 9 §9.8 — RED metrics (Prometheus). The /metrics endpoint is served on
# a dedicated internal-only port, NOT the public API port, to prevent accidental
# exposure. Validate() rejects this value if it collides with SERVER_PORT.
# Python AI pipeline (ai/common/config.py) also reads this key to avoid port
# collisions when both processes run on the same host. Default: 9091 (Go API).
NEGELIR_TELEMETRY_METRICS_PORT=9091                                # shared
# Phase 9 §9.8 — cardinality cap. The boot validator estimates worst-case series
# count for api_requests_total (routes x status(8) x method(3) x cache(4) x
# degraded(2)) and refuses to start if the estimate exceeds this value. Default
# 10000 (the 30-route spec example produces 5760, well under the cap).
NEGELIR_TELEMETRY_MAX_SERIES=10000
# Phase 9 §9.8 — structured access log sampling. Percentage of 2xx responses
# written to the JSON access log on stderr. Range [0, 100]. 4xx/5xx are always
# logged regardless of this value. Default 10 (prod-safe); set 100 in dev/test.
NEGELIR_API_LOG_SAMPLE_PCT=10                                      # shared
# Phase 9 §9.8 — OTLP gRPC trace export. Format: "host:port" (no scheme).
# When empty (the default) the tracing subsystem is a no-op: no goroutines,
# no connections, no stdout dump. Set to the OTel Collector sidecar address
# when trace export is desired (e.g. "otelcol:4317").
NEGELIR_TELEMETRY_OTLP_ENDPOINT=
# Phase 9 §9.8 — SLO burn-rate alert knobs (multi-window multi-burn-rate,
# Google SRE Workbook recipe). APISLOBurnWindowS is both the long evaluation
# window and the BurnRateMonitor check interval (seconds). The short window is
# BurnWindowS/12 (300 s at the default 3600 s). APISLOBurnThreshold is the
# error-budget-consumption multiple that triggers a warn alert via
# sec.alert.v1{kind=api_slo_burn}; critical fires at 3x the threshold (default 6.0).
NEGELIR_API_SLO_BURN_WINDOW_S=3600                                 # shared
NEGELIR_API_SLO_BURN_THRESHOLD=2.0                                 # shared
# Phase 9 §9.11 -- deprecation window (days). Minimum days between x-deprecated-on
# and the 410 Gone date (x-sunset-on, or derived from this value when absent).
# The DeprecationHeaders middleware uses this as fallback. Must be >= 1. Default 90.
NEGELIR_API_DEPRECATION_WINDOW_DAYS=90                             # shared
# Phase 9 §9.11 -- schema-version stamp. Injected into every JSON response as
# meta.schema_version by SchemaVersionMiddleware. Bumps additively with each
# server minor version per chart.json. Client SDKs key cache invalidation on
# this value. Must be >= 1. Default 1.
NEGELIR_API_SCHEMA_VERSION=1                                       # shared
# Phase 9 §9.12 — fixture window / allowed markets / trusted proxies.
# Maximum days ahead a fixture query may request. Default 14.
NEGELIR_API_FIXTURE_WINDOW_MAX_DAYS=14                             # shared
# Comma-separated market codes accepted by the API. Default: ms,au_2.5,btts,ah_home,modal_score.
NEGELIR_API_ALLOWED_MARKETS=ms,au_2.5,btts,ah_home,modal_score    # shared
# Comma-separated trusted reverse-proxy CIDRs/IPs. Empty = no trusted proxies.
NEGELIR_API_TRUSTED_PROXIES=                                       # shared

# Phase 9 §9.17.1 — Go runtime tuning knobs (refuse-to-start gates).
# GOMEMLIMIT: mebibytes to pass to debug.SetMemoryLimit. 0 = derive from
# cgroup memory.max at 80%. Refuse boot if cgroup unreadable AND value=0.
NEGELIR_API_GO_MEM_LIMIT_MIB=0                                    # shared
# GOGC: GC target percentage. Default 50 (Go default 100 is too lazy under
# JSON encode + Redis pipeline allocation pattern).
NEGELIR_API_GO_GC_PERCENT=50                                      # shared
# HTTP server timeout knobs (Slowloris / idle-fd defense).
# ReadHeaderTimeout: time to read the HTTP request header. Default 5 s.
NEGELIR_API_READ_HEADER_TIMEOUT_MS=5000                           # shared
# ReadTimeout: time to read the full request. Default 10 s.
NEGELIR_API_READ_TIMEOUT_MS=10000                                 # shared
# WriteTimeout: time to write the full response. Must exceed
# api_request_timeout_ms + api_response_write_timeout_ms. Default 15 s.
NEGELIR_API_WRITE_TIMEOUT_MS=15000                                # shared
# IdleTimeout: keep-alive idle connection timeout. Default 60 s.
NEGELIR_API_IDLE_TIMEOUT_MS=60000                                 # shared
# Graceful shutdown grace period (SIGTERM → server.Shutdown). Default 30 s.
NEGELIR_API_SHUTDOWN_GRACE_S=30                                   # shared
# In-mesh H2C listener port (in-cluster sidecar, behind mTLS). 0 = disabled.
NEGELIR_API_IN_MESH_PORT=8082                                     # shared

# Phase 9 §9.17.3 — Connection pool sizing.
# PostgreSQL pgxpool knobs (all Go-server-only; mirrored in ai/common/config.py
# and ai/common/defaults.yaml for the single-source-config doctrine).
# Maximum open PG connections per API pod. Default 25.
NEGELIR_API_PG_POOL_MAX_CONNS=25                                  # shared
# Read-replica URL (postgres://...). Empty = disabled (built but dormant).
NEGELIR_API_PG_REPLICA_URL=                                       # shared
# How often to check replica lag (seconds). Active only when replica URL is set.
NEGELIR_API_PG_REPLICA_LAG_CHECK_S=10                             # shared
# Max acceptable replica lag before falling back to primary (milliseconds).
NEGELIR_API_PG_REPLICA_LAG_MAX_MS=500                             # shared
# Redis cache client pool size (PoolTimeout=100ms, MinIdleConns=10). Default 50.
NEGELIR_API_REDIS_CACHE_POOL_SIZE=50                              # shared
# Redis bus client pool size (XREAD streams, ReadTimeout=request_timeout+500ms). Default 20.
NEGELIR_API_REDIS_BUS_POOL_SIZE=20                                # shared

# ── Phase 9 §9.17.4 — Resilience: circuit breakers, bulkheads, hedging, retry budgets ──
# Circuit breaker knobs (sony/gobreaker). One breaker per upstream: pg, redis_cache, redis_bus, swarm_rpc.
# Failure fraction (0.0–1.0) that trips the breaker. Default 0.5.
NEGELIR_API_BREAKER_FAIL_RATIO=0.5                                # shared
# Rolling window in seconds for counting requests. Default 10.
NEGELIR_API_BREAKER_WINDOW_S=10                                   # shared
# Minimum calls before the breaker may trip. Default 20.
NEGELIR_API_BREAKER_MIN_REQUESTS=20                               # shared
# Seconds the breaker stays open before admitting one probe. Default 15.
NEGELIR_API_BREAKER_OPEN_S=15                                     # shared
# Hedged RPC: delay (ms) after primary RPC before issuing a hedge request. Default 200.
NEGELIR_API_HEDGE_AFTER_MS=200                                    # shared
# Master switch for hedged cache-miss RPC. Default true.
NEGELIR_API_HEDGING_ENABLED=true                                  # shared
# Maximum percentage of RPCs that may be hedged. Default 10 (10%).
NEGELIR_API_HEDGE_BUDGET_PCT=10                                   # shared
# Retry budget token-bucket: tokens per second. Default 10.
NEGELIR_API_RETRY_BUDGET_PER_S=10                                 # shared
# Retry budget burst capacity (max tokens). Default 50.
NEGELIR_API_RETRY_BUDGET_CAPACITY=50                              # shared
# Phase 9 §9.17.5 — target RPS for `make api.bench` (k6 constant-arrival-rate driver). Default 200.
NEGELIR_API_BENCH_TARGET_RPS=200                                  # shared

# ── Phase 9 §9.17.6 — In-process L0 LRU cache ──────────────────────────────
# Maximum number of entries in the per-pod L0 LRU cache. Default 10000.
NEGELIR_API_L0_CACHE_MAX_ENTRIES=10000                            # shared
# Soft byte-usage cap for the L0 cache. Default 67108864 (64 MiB).
NEGELIR_API_L0_CACHE_MAX_BYTES=67108864                           # shared
# Per-entry TTL cap (seconds). Effective TTL = min(L1 TTL, this). Default 5.
NEGELIR_API_L0_MAX_TTL_S=5                                        # shared
# TTL for 404/410 negative-cache entries (seconds). Default 10.
NEGELIR_API_NEGATIVE_CACHE_S=10                                   # shared
# Max milliseconds a stampede-waiting goroutine blocks before falling through
# to a direct fetch. Default 200.
NEGELIR_API_L0_REFRESH_MAX_WAIT_MS=200                            # shared
# SLO target for keyspace-notification eviction lag (ms). Violations emit a
# sec.alert.v1 event. Default 500.
NEGELIR_API_L0_INVALIDATION_LAG_MAX_MS=500                        # shared

# ── Phase 9 §9.17.7 — Audit pipeline performance ───────────────────────────
# Max rows per Redis pipeline flush. Default 64.
NEGELIR_API_AUDIT_BATCH_MAX=64                                     # shared
# Max milliseconds to accumulate before flush. Default 10.
NEGELIR_API_AUDIT_BATCH_MAX_MS=10                                  # shared
# Bounded channel capacity for the audit shipper goroutine. Default 4096.
NEGELIR_API_AUDIT_CHAN_CAP=4096                                    # shared
# 2xx sample percentage when channel is >80% full for >5s. 4xx/5xx and
# sec-relevant events always bypass sampling. Default 10.
NEGELIR_API_AUDIT_SAMPLE_PCT_UNDER_PRESSURE=10                    # shared

# Phase 9 §9.17.8 — TCP_USER_TIMEOUT (Linux only).
# Sets TCP_USER_TIMEOUT on every accepted connection. 0 = kernel default.
# Default 20000 ms (20 s). Rotated via: make api.rotate-tls-session-key
NEGELIR_API_TCP_USER_TIMEOUT_MS=20000                             # shared

# Phase 9 §9.17.9 — Backpressure feedback loops.
NEGELIR_API_ADAPTIVE_ERROR_RATE_THRESHOLD=0.02                    # shared
NEGELIR_API_ADAPTIVE_SHED_FACTOR=0.5                              # shared
NEGELIR_API_ADAPTIVE_SHED_DURATION_S=60                           # shared
NEGELIR_API_PRIORITY_TIER_FLOOR=0                                 # shared

# Phase 9 §9.17.10 — Observability for performance.
# pprof endpoint on the metrics port (:9091/debug/pprof/*) — NEVER on the
# public listener. Dev default: enabled. Prod default: disabled.
# Short-lived override: make api.pprof-enable POD=<name> (Redis TTL 1h).
NEGELIR_API_PPROF_ENABLED_DEV=true                             # shared
NEGELIR_API_PPROF_ENABLED_PROD=false                           # shared
# Fraction of requests sampled for allocation delta tracking (0=off, 1=all).
# Default 0.001 (1 in 1000). p99 > 50 KiB → sec.alert.v1{kind=api_alloc_regression}.
NEGELIR_API_ALLOC_SAMPLE_RATE=0.001                            # shared
# Base directory for continuous CPU profile files (<dir>/<hostname>/<utc>.pprof.gz).
NEGELIR_API_PPROF_DIR=data/api/profiles                       # shared


# The proofreader replica roster is *not* a config knob — it lives in
# `swarm.agents.proofreader.replicas.PROOFREADER_POLICY_CLASSES` (one
# entry per distinct check policy: sanity, plausibility, consistency).
# `cfg.proofreader_quorum` derives quorum (⌊N/2⌋+1) from len(roster)
# so the two cannot drift. Phase-6 audit F3-1 retired the standalone
# NEGELIR_PROOFREADER_REPLICAS env knob — it was disconnected from the
# roster and silently broke quorum at any value other than 3.
# Horizontal fan-out moves to consumer-group sharding (Phase 14).
# How long the aggregator waits, after seeing the first verdict for a
# (request_id, prediction_id), before declaring "no quorum" and dropping
# the candidate. The API SLA budget includes this window via
# NEGELIR_API_CONSENSUS_OVERHEAD_MS, which must be ≥ this value.
NEGELIR_PROOFREADER_QUORUM_WINDOW_MS=200                           # shared
# Phase-6 audit (F-9): LRU bound on the aggregator's `_pending` map.
# Without it, verdicts that never reach quorum (or arrive past the
# window) leak memory between flush ticks. Mirrors
# NEGELIR_CONSENSUS_MAX_PENDING since the per-prediction shape is
# comparable.
NEGELIR_PROOFREADER_AGGREGATOR_MAX_PENDING=4096
# Phase-6 audit (F-2): how often AgentRunner ticks `flush_expired`
# on aggregator-style agents (consensus, proofreader_aggregator) when
# no new message arrived to drive `handle()`. Without this knob,
# windows never expire and `no_quorum` candidates leak. 100 ms keeps
# tick jitter well under NEGELIR_PROOFREADER_QUORUM_WINDOW_MS / 2.
NEGELIR_SWARM_FLUSH_INTERVAL_MS=100

# Per-replica check thresholds (§6.2). Each individual proofreader
# (sanity / plausibility / consistency) reads its own knob:
#
# - SANITY_EPS: how far market_outcomes may drift from summing to 1.0
#   before the sanity replica votes "reject". 0.01 absorbs float
#   rounding from consensus + calibration without masking real bugs.
# - PLAUSIBILITY_MAX_PROB: cap on any single outcome probability
#   above which the plausibility replica votes "warn" (operator-
#   visible yes-vote — counts toward quorum). 0.85 catches lopsided
#   derby calls without flagging legitimate one-sided fixtures.
# - GRID_CONSISTENCY_TOL: per-outcome tolerance between score_grid
#   marginals and market_outcomes. Beyond this the consistency
#   replica votes "reject" (the predictor produced two inconsistent
#   views of the same prediction).
NEGELIR_PROOFREADER_SANITY_EPS=0.01
NEGELIR_PROOFREADER_PLAUSIBILITY_MAX_PROB=0.85
NEGELIR_PROOFREADER_GRID_CONSISTENCY_TOL=0.05

# Drift agent (§6.3). Maintains rolling Brier/log-loss windows per
# (predictor, league, market) and emits `maint.event.v1` with
# kind=retrain_request when the floor is breached or a KS-test on
# input features rejects stationarity.
#
# - WINDOW_SIZE: number of realized outcomes per rolling window. 50
#   balances "react fast to a regression" against "don't fire on a
#   5-game variance blip".
# - BRIER_CEILING: Brier (and log-loss) ceiling. 0.30 is the project's
#   documented "anything worse is dart-throwing-chimp" line. Lower
#   Brier = better, so the agent trips when the rolling mean *exceeds*
#   this value. Distinct from the legacy NEGELIR_DRIFT_FLOOR above
#   (which is an *accuracy* floor for ai/model/drift.py).
# - PVALUE: KS-test threshold; below this the feature distribution is
#   declared non-stationary and a retrain_request is emitted with
#   reason=feature_ks. 0.01 keeps false positives near 1%.
NEGELIR_DRIFT_WINDOW_SIZE=50
NEGELIR_DRIFT_BRIER_CEILING=0.30
NEGELIR_DRIFT_PVALUE=0.01
NEGELIR_DRIFT_MAX_PENDING=100000
NEGELIR_DRIFT_MAX_SETTLED=100000

# ── Phase 7 — Defense agents (sec.input.v1 / sec.scrape.v1 / sec.rate.v1) ──
# Foundation knobs (topics, payloads, JSON schemas, config). Agent logic
# follows in §7.1 / §7.2 / §7.3. The `test_python_defaults_match_env_example`
# gate enforces every value below matches `ai/common/config.py` byte-for-byte.
#
# sec.input.v1 (§7.1). MAX_LEN is **bytes after UTF-8 encoding**, NOT
# codepoints — the byte count stresses Redis & the classifier tokenizer.
# DEVICE accepts {auto,cpu,cuda,rocm,npu}; BATCH_ENABLED accepts
# {auto,true,false}.
NEGELIR_SEC_INPUT_MAX_LEN=8192                                  # shared
NEGELIR_SEC_INPUT_GATEWAY_MAX_LATENCY_MS=10                      # shared
NEGELIR_SEC_INPUT_CLASSIFIER_MAX_LATENCY_MS=100
NEGELIR_SEC_INPUT_CLASSIFIER_DEVICE=auto
NEGELIR_SEC_INPUT_CLASSIFIER_PATH=
NEGELIR_SEC_INPUT_CLASSIFIER_BATCH_ENABLED=auto
NEGELIR_SEC_INPUT_CLASSIFIER_BATCH_SIZE=8
NEGELIR_SEC_INPUT_CLASSIFIER_BATCH_WINDOW_MS=20
NEGELIR_SEC_INPUT_CLASSIFIER_MAX_PENDING=256
NEGELIR_SEC_INPUT_BREAKER_OPEN_S=30
NEGELIR_SEC_INPUT_PATTERN_RELOAD_S=30                            # shared
NEGELIR_SEC_INPUT_ALLOWLIST_RELOAD_S=60                          # §8.7 pattern_allowlist read cache
NEGELIR_SEC_INPUT_ALLOWLIST_HMAC_KEY_PATH=/var/lib/negelir/secrets/allowlist_hmac.key
NEGELIR_SEC_INPUT_ALLOWLIST_HMAC_KEY_MAX_AGE_DAYS=365

# sec.quarantine.v1 + storage backpressure (§7.1 + §7.5). PAYLOAD_MAX_BYTES
# is the cap BEFORE base64 encoding; on-the-wire envelope is ~4/3 larger.
NEGELIR_SEC_QUARANTINE_TTL_DAYS=30
NEGELIR_SEC_QUARANTINE_PAYLOAD_MAX_BYTES=65536                   # shared
NEGELIR_SEC_QUARANTINE_PRODUCER_QUEUE_MAX=1000
NEGELIR_SEC_QUARANTINE_STORAGE_LAG_ALERT_MS=5000

# sec.scrape.v1 (§7.2). Streaming-statistic baseline (Welford / P² /
# count-min sketch) — there is intentionally NO per-source raw-sample cap.
# SIMHASH_MAX_DISTANCE is in bits-out-of-64 (>=32 ≈ never trip).
NEGELIR_SEC_SCRAPE_SIZE_DELTA_PCT=200.0
NEGELIR_SEC_SCRAPE_INFLATE_RATIO_MAX=50.0
NEGELIR_SEC_SCRAPE_WARMUP_SAMPLES=50
NEGELIR_SEC_SCRAPE_BASELINE_FLUSH_S=300
NEGELIR_SEC_SCRAPE_MAX_PENDING=4096
# F7.3: dedicated cap for the SecScrapeAgent content-addressed dedup
# map ((source, bytes_sha256) LRU). Distinct from MAX_PENDING (which
# bounds the future async-scoring queue). Default matches MAX_PENDING
# so behaviour is unchanged out of the box; tune independently when
# replay-window characteristics demand it.
NEGELIR_SEC_SCRAPE_DEDUP_WINDOW=4096
NEGELIR_SEC_SCRAPE_SIMHASH_MAX_DISTANCE=12
NEGELIR_SEC_SCRAPE_DOM_FINGERPRINT_MAX_NODES=5000
# F7.4: bounded ring of recent per-source SimHash fingerprints. Drift
# trips when the MIN Hamming distance over the ring exceeds the
# threshold above — not the adjacent-pair distance. Tolerates
# legitimate A/B-test layout oscillation post-warmup at the cost of
# one transient false trip when a genuinely-new layout first lands.
NEGELIR_SEC_SCRAPE_SIMHASH_RING_SIZE=8

# sec.rate.v1 (§7.3). Pre-auth caps protect /v1/auth/* against credential
# stuffing; post-auth caps are looser. IPv6 prefix /64 = end-site allocation
# boundary (a single IPv6 allocation cannot spray 2^64 unique buckets).
# TRUSTED_PROXIES is a comma-separated list of CIDRs; empty = trust no proxies.
NEGELIR_SEC_RATE_PRE_AUTH_CAPACITY=30                            # shared
NEGELIR_SEC_RATE_PRE_AUTH_REFILL_PER_S=0.5                       # shared
NEGELIR_SEC_RATE_POST_AUTH_CAPACITY=600                          # shared
NEGELIR_SEC_RATE_POST_AUTH_REFILL_PER_S=5.0                      # shared
NEGELIR_SEC_RATE_BUCKET_IDLE_TTL_S=3600                          # shared
NEGELIR_SEC_RATE_MAX_SUBJECTS=100000
NEGELIR_SEC_RATE_IPV4_PREFIX=32                                  # shared
NEGELIR_SEC_RATE_IPV6_PREFIX=64                                  # shared
NEGELIR_SEC_RATE_TRUSTED_PROXIES=                                # shared
NEGELIR_SEC_RATE_REDIS_TIMEOUT_MS=50                             # shared
NEGELIR_SEC_RATE_SECONDARY_CAPACITY=300                          # shared
NEGELIR_SEC_RATE_SECONDARY_REFILL_PER_S=5.0                      # shared
NEGELIR_SEC_RATE_DEFAULT_COST=1                                  # shared
NEGELIR_SEC_RATE_EVICTION_RATE_ALERT_PER_S=50.0
NEGELIR_SEC_RATE_EVICTION_RATE_WINDOW_S=60

# Sliding-window burst detector (§7.3) — uses time.monotonic() in-process.
NEGELIR_SEC_BURST_THRESHOLD=100
NEGELIR_SEC_BURST_WINDOW_MS=60000
NEGELIR_SEC_BURST_DEDUP_WINDOW=10000

# Denylist (Redis hash; sole writer = sec.rate.v1) — §7.3.
NEGELIR_SEC_DENYLIST_TTL_S=3600
NEGELIR_SEC_DENYLIST_ESCALATION_FACTOR=2.0
NEGELIR_SEC_DENYLIST_MAX_ENTRIES=250000                          # shared

# sec.alert.v1 envelope (§7.4). Generalized debounce TTL (per (kind,subject)
# tuple in Redis) avoids alert storms from repeated identical events.
# Critical-severity alerts bypass debounce by default (set ENABLED=true to
# subject critical alerts to debounce too).
NEGELIR_SEC_ALERT_DEBOUNCE_TTL_S=60
NEGELIR_SEC_ALERT_CRITICAL_DEBOUNCE_ENABLED=false
# F7.2: dedicated per-agent LRU cap for SecAlertDebouncer (kind,subject)
# buckets. Distinct from NEGELIR_SEC_RATE_MAX_SUBJECTS (which sizes the
# rate agent's per-subject burst-window LRU). Lowering this knob during
# incident response will not affect the rate agent's subject capacity.
NEGELIR_SEC_ALERT_DEBOUNCER_MAX_BUCKETS=4096

# qa.request.v1 — NLP-side dedup window (§7.5 binding). Two producers
# (Go gateway pass-through; sec.input.v1 post-classifier pass) emit the
# same request_id; NLP must dedup over this window.
NEGELIR_QA_REQUEST_V1_DEDUP_WINDOW_S=300

# ── Phase 10 §10.0 — Turkish NLP pipeline (cross-phase contracts) ──────────
# §10.1 step 1: hard codepoint cap on raw user input (defense-in-depth).
# Codepoint-based so Turkish multi-byte chars are not double-counted.
# sec_input_max_len (bytes) is the floor.
NEGELIR_NLP_INPUT_MAX_CODEPOINTS=512
# Dedup window: must be >= NEGELIR_QA_REQUEST_V1_DEDUP_WINDOW_S(300) + 30.
# Boot validator refuses start on violation (Phase 10 §10.0 cross-phase contract).
NEGELIR_NLP_REQUEST_DEDUP_WINDOW_S=330
# Phase 10 §10.21.8 citation integrity: HMAC key file used to sign
# predict.approved.v1 citation payloads. Production mode: 0400.
NEGELIR_PREDICT_CITATION_HMAC_KEY_PATH=/var/lib/negelir/secrets/predict_citation_hmac.key
# Phase 10 §10.21.8 citation key rotation dual-acceptance window (seconds).
# NLP accepts signatures from <key_path>.prev while current key file age <= this window.
NEGELIR_PREDICT_CITATION_HMAC_KEY_GRACE_S=86400
# Phase 10 §10.21.8 consume-side signature verification mode.
# off=skip verification, warn=render+alert on invalid/missing, enforce=drop+timeout template.
NEGELIR_NLP_PREDICT_CITATION_HMAC_REQUIRED=warn
# Phase 10 §10.23.1 per-tenant intake fair-queue key.
# Values: tenant_id | account_id | ip_bucket. Default account_id.
NEGELIR_NLP_FAIRNESS_KEY=account_id
# Per-key inflight intake-slot cap; over-cap keys queue behind their own slots.
NEGELIR_NLP_PER_TENANT_INFLIGHT_MAX=8
# Cardinality cap for tracked fairness keys; oldest key is evicted (LRU).
NEGELIR_NLP_FAIRNESS_MAX_TRACKED_KEYS=10000
# Sustained per-key intake-QPS threshold for observability-only abuse alerting.
NEGELIR_NLP_TENANT_ABUSE_QPS_THRESHOLD=10
# Rolling window (seconds) used by per-key intake abuse detection.
NEGELIR_NLP_TENANT_ABUSE_WINDOW_S=60
# Bus circuit breaker (Phase 10 §10.13): consecutive publish failures before
# transitioning to bus_degraded state and spooling to disk.  Range: 1–10. Default: 3.
NEGELIR_NLP_BUS_FAILURE_CIRCUIT_THRESHOLD=3
# Max spool entries per NLP agent before dropping oldest (overflow cap).
# Range: 1–100000. Default: 1000.
NEGELIR_NLP_SPOOL_MAX_ENTRIES=1000
# Per-agent spool directory root.  Agents create subdirs under this path.
# Each NLP agent writes {ms}-{msg_id}.envelope.json entries to its subdir.
# Default: "data/nlp/spool" (relative to repo root).
NEGELIR_NLP_AGENT_SPOOL_DIR=data/nlp/spool
# Strip potentially sensitive text from qa.intent.v1 spool payloads.
# When true, spool entries replace payload.sanitized_text with
# payload.sanitized_text_sha256. Default: true.
NEGELIR_NLP_SPOOL_PAYLOAD_PII_STRIP=true
# Timeout chain extending Phase 9 §9.17.4 deadline-propagation guard:
#   NEGELIR_API_REQUEST_TIMEOUT_MS >= NLP_PIPELINE_TIMEOUT_MS + NLP_DISPATCH_OVERHEAD_MS
#   NLP_PIPELINE_TIMEOUT_MS >= CONSENSUS_WINDOW_MS + NLP_CONSENSUS_OVERHEAD_MS
#                              [+ NLP_HUMANIZER_MAX_LATENCY_MS when NLP_HUMANIZE=true]
# Boot validator refuses start on either violation.
NEGELIR_NLP_PIPELINE_TIMEOUT_MS=1800
NEGELIR_NLP_DISPATCH_OVERHEAD_MS=200
NEGELIR_NLP_CONSENSUS_OVERHEAD_MS=100
# Budget for the optional ≤1B humanizer LLM (Phase 11 device-probed).
# Only counted in the pipeline inequality when NEGELIR_NLP_HUMANIZE=true.
NEGELIR_NLP_HUMANIZER_MAX_LATENCY_MS=600
# Circuit breaker open window (seconds) after humanizer latency breach.
# After breach → fall back to template, emit nlp.event.v1{kind=humanizer_disabled},
# open breaker for this duration (refuses humanize, emits breaker_open once).
NEGELIR_NLP_HUMANIZER_BREAKER_OPEN_S=60
# Humanizer circuit breaker scope: "pod" (default, per-pod in-memory) or
# "cluster" (Redis-backed, cross-pod coordination). Phase 10 §10.21.4.
# Per-pod is the default; cluster-scope adds a Redis round-trip on every
# humanize call → only flip after measuring per-pod breaker open-rate above 5%
# (stampede-protection in dense replica deployments).
NEGELIR_NLP_HUMANIZER_BREAKER_SCOPE=pod
# §10.23.1 per-tenant humanizer budget (token bucket keyed by fairness key).
# Over-budget requests degrade to template-only answer (no user-facing error).
NEGELIR_NLP_PER_TENANT_HUMANIZER_BURST=4
NEGELIR_NLP_PER_TENANT_HUMANIZER_REFILL_PER_S=2
# Enable optional humanizer LLM for answer polish (never a decision-maker).
# Default false: deterministic templates are both floor and ceiling.
NEGELIR_NLP_HUMANIZE=false
# Decoding constraints for humanizer LLM (Phase 10 §10.8).
# Max output tokens (cap on generation length). Must be >= 1. Default 120.
NEGELIR_NLP_HUMANIZER_MAX_NEW_TOKENS=120
# Sampling temperature [0.0, 2.0]. Lower = more deterministic. Default 0.3.
NEGELIR_NLP_HUMANIZER_TEMPERATURE=0.3
# Nucleus sampling threshold [0.0, 1.0]. Default 0.9.
NEGELIR_NLP_HUMANIZER_TOP_P=0.9
# Repetition penalty [1.0, 2.0]. Higher = less repetition. Default 1.05.
NEGELIR_NLP_HUMANIZER_REPETITION_PENALTY=1.05
# Drift guard: max ratio of edit distance to template length [0.0, 1.0].
# Over-cap → discard, fall back to template, emit nlp.alert.v1{kind=nlp_humanizer_drift}.
# Default 0.6 (LLM is rephrasing, not authoring).
NEGELIR_NLP_HUMANIZER_MAX_EDIT_RATIO=0.6
# p95 latency threshold (ms) for `make nlp.bench` CI gate.
# Phase 10 §10.1 DoD: normalize_input on nlp_input_max_codepoints-length input.
NEGELIR_NLP_BENCH_LATENCY_P95_THRESHOLD_MS=5
# Hot-reload poll interval (seconds) for lexicon YAML files (§10.2 Atomic swap).
# LexiconStore checks file mtimes at most once every this many seconds.
NEGELIR_NLP_LEXICON_RELOAD_S=30
# Maximum entries per lexicon file (§10.2 Cardinality cap).
# Over-cap → dictionary_overflow warn alert + refuse load.
NEGELIR_NLP_LEXICON_MAX_ENTRIES_PER_FILE=50000
# Total process RSS budget for loaded lexicons (§10.2 Bounded memory).
# Over-budget after shadow load → dictionary_overflow error alert + refuse swap.
# Set to 0 to disable the check.
NEGELIR_NLP_LEXICON_MAX_RSS_MB=128
# Maximum retired snapshots retained for in-flight requests (§10.21.2 Old-
# generation eviction contract).  When a lexicon swap occurs, the old dict
# is added to a deque; oldest generations beyond this cap are dropped.
NEGELIR_NLP_LEXICON_MAX_OLD_GENERATIONS=2
# Swap policy for multi-file lexicon reloads (§10.21.3 Atomic swap policy).
# Values: "all_or_nothing" (default) or "per_file".  Under "all_or_nothing",
# when any file changes, ALL files are loaded into shadow and validated via
# cross-file referential validator; if validation passes, the whole snapshot
# swaps atomically; else REVERT shadow + emit nlp.alert.v1{kind=nlp_lexicon_atomic_swap_failed}.
NEGELIR_NLP_LEXICON_SWAP_ATOMICITY=all_or_nothing
# RSS budget for CRF entity tagger model (§10.21.2 RSS ceiling).
# Estimated memory footprint for the python-crfsuite model at runtime.
NEGELIR_NLP_CRF_MAX_RSS_MB=5
# RSS budget for SymSpell edit-distance index (§10.21.2 RSS ceiling).
# Estimated memory footprint for the typo-correction dictionary.
NEGELIR_NLP_SYMSPELL_MAX_RSS_MB=100
# RSS budget for Jinja2 bytecode cache (§10.21.2 RSS ceiling).
# Estimated memory footprint for precompiled template bytecode.
NEGELIR_NLP_JINJA_CACHE_MAX_RSS_MB=50
# RSS budget for Python interpreter overhead (§10.21.2 RSS ceiling).
# Baseline memory for Python runtime, standard library, and dependencies
# (numpy, fasttext, jinja2, etc.) before NLP components are loaded.
NEGELIR_NLP_PYTHON_OVERHEAD_MB=200
# RSS budget for humanizer ONNX model (§10.21.2 RSS ceiling).
# Estimated memory footprint for transformer weights, KV cache, and buffers.
NEGELIR_NLP_HUMANIZER_MAX_RSS_MB=1024
# Total RSS ceiling per NLP pod (§10.21.2 RSS ceiling).
# Boot validator sums all sub-knobs (lexicons + intent model + crf + symspell
# + jinja cache + python overhead + humanizer) and refuses start if it exceeds
# this cap.  Catches operator over-tuning a sub-knob.
NEGELIR_NLP_POD_RSS_MAX_MB=2048
# Directory path for Jinja2 bytecode cache (§10.21.2 precompiled templates).
# FileSystemBytecodeCache stores precompiled template bytecode with pattern
# __nlp_%s.cache to avoid repeated AST compilation in hot path.
NEGELIR_NLP_JINJA_BCC_DIR=data/cache/jinja_bcc
# Minimum substring length for §10.21.6 runtime guard (finalize callable).
# Jinja2 finalize checks rendered values for user-text substrings ≥ this length
# (case-insensitive via casefold).  Must be ≥ 3 to skip article noise.
NEGELIR_NLP_TEMPLATE_FINALIZE_MIN_USER_TEXT_LEN=6
# Global Levenshtein cap for tokens of length ≥ 5 in the SymSpell typo-
# correction step (§10.3).  Must be 1 or 2.  Shorter tokens use a smaller
# per-token budget (len 3-4 → 1, len ≤ 2 → 0 / exact-only).
NEGELIR_NLP_TYPO_MAX_EDIT_DISTANCE=2
# Maximum number of fuzzy (edit_distance > 0) lookups allowed per query
# (§10.3 Per-query budget).  When exceeded the pipeline short-circuits and
# returns a "Did you mean?" signal instead of guessing.  Must be ≥ 1.
NEGELIR_NLP_TYPO_MAX_LOOKUPS_PER_QUERY=8
# Diacritic ambiguity tie-break ratio (§10.3 Ambiguity policy).
# When top-2 restoration candidates have frequencies within this ratio
# (top/second ≤ ratio), the token is preserved unchanged and flagged for
# the entity resolver to disambiguate via context.  Must be >= 1.0.
NEGELIR_NLP_DIACRITIC_TIE_BREAK_RATIO=1.5
# Wall-clock deadline for the combined normalize+diacritic+typo stage
# (§10.3 Cost ceiling, Phase 9 §9.17.4 deadline propagation).  On timeout
# the pipeline falls through to the raw token sequence and emits
# nlp.event.v1{kind=normalize_timeout}.  Must be ≥ 1 ms.
NEGELIR_NLP_NORMALIZE_STAGE_TIMEOUT_MS=20
# §10.4 fastText intent classifier model.
# INTENT_MODEL_PATH: path to the .bin model file (relative to repo root).
# INTENT_MODEL_SHA256: hex SHA256 of the model file, set by `make nlp.intent-pin`.
#   Empty = SHA check disabled (dev / pre-train only; must be set in production).
# INTENT_MODEL_MAX_SIZE_MB: hard cap on model disk size (DoD: ≤ 20 MB).
# INTENT_CALIBRATION_PATH: path to intent.tr.calibration.json (§10.4 Calibration).
#   Empty = auto-resolved as <model_dir>/intent.tr.calibration.json.
#   Set after calibration script runs on the held-out validation slice.
NEGELIR_NLP_INTENT_MODEL_PATH=data/models/nlp/intent.tr.bin
NEGELIR_NLP_INTENT_MODEL_SHA256=
NEGELIR_NLP_INTENT_MODEL_MAX_SIZE_MB=20
NEGELIR_NLP_INTENT_CALIBRATION_PATH=
# §10.4 Abstention threshold: minimum calibrated confidence for a definite
# intent classification.  Below this floor the pipeline returns an
# IntentAbstention with top-3 suggestions for "Did you mean?" (§10.18
# evaluation harness pins this value).
NEGELIR_NLP_MIN_INTENT_CONF=0.55
# §10.4 Drift guard: rolling accuracy floor — when the rolling accuracy over
# the last DRIFT_WINDOW predictions drops below this value, IntentDriftGuard
# marks the classifier degraded and the agent emits nlp.event.v1
# {kind=intent_classifier_degraded} and routes to template-only fallback.
NEGELIR_NLP_INTENT_ACCURACY_FLOOR=0.92
# §10.4 Drift guard: number of most-recent predictions in the rolling window.
NEGELIR_NLP_INTENT_DRIFT_WINDOW=1000
# §10.18 Entity F1 floor: minimum F1 score required for entity extraction
# on the golden corpus (clean ∪ no_diacritics ∪ typos slice) for a release
# to pass CI gates.  Must be in (0, 1).  Default 0.90.
NEGELIR_NLP_ENTITY_F1_FLOOR=0.90
# §10.4 Versioning: human-readable semver for the deployed intent model file.
# Stamped on every qa.intent.v1 envelope as intent_model_version for post-hoc
# audit.  Set by `make nlp.intent-pin`; empty during pre-train / dev.
NEGELIR_NLP_INTENT_MODEL_VERSION=
# §10.21.1 Numpy + fastText version pin: exact numpy version expected at runtime.
# Boot probe asserts numpy.__version__ matches this value; refuse start on drift
# (defends against ABI shifts that could change model behavior or re-serialize
# binaries differently across upgrades).  Empty = check disabled (dev only).
# Recorded in xops/versioning/chart.json py_exact_versions.numpy.
NEGELIR_NLP_NUMPY_PIN=
# §10.21.1 Exact fasttext version expected at runtime. Boot probe asserts
# fasttext.__version__ matches; refuse start on drift.  Empty = check disabled.
# Recorded in xops/versioning/chart.json py_exact_versions.fasttext.
NEGELIR_NLP_FASTTEXT_PIN=

# ── Phase 10 §10.5 — Entity extraction (gazetteer + CRF) ─────────────────
# Comma-separated ordered list of entity kinds for tie-breaking in the
# gazetteer conflict-resolution pass (§10.5 conflict resolution rule c).
# Teams are resolved first, then players, leagues, competitions, markets,
# then CRF-produced temporal/numeric kinds.
NEGELIR_NLP_ENTITY_KIND_PRIORITY=team,player,league,competition,market,date,time,weekday,ordinal,money_amount,score
# Path to the trained python-crfsuite model file for BIO-tag temporal/numeric
# entity extraction (§10.5 CRF pass).  Empty = CRF pass disabled (gazetteer-
# only mode).  Set by `make nlp.entity-pin` alongside the SHA.
NEGELIR_NLP_ENTITY_CRF_MODEL_PATH=
# Expected SHA256 hex digest of the CRF model file.  Empty = integrity check
# skipped (dev / pre-train mode).
NEGELIR_NLP_ENTITY_CRF_MODEL_SHA256=
# Hard cap on the CRF model file size in MB (§10.5 "model ≤ 5 MB").
# CrfExtractor refuses to load a model larger than this value.
NEGELIR_NLP_ENTITY_CRF_MODEL_MAX_SIZE_MB=5
# p95 latency gate for `make nlp.entity-bench` (milliseconds; Phase 10 §10.5).
NEGELIR_NLP_ENTITY_BENCH_LATENCY_P95_THRESHOLD_MS=8

# ── Phase 10 §10.6 — Dispatcher slot-resolver ─────────────────────────────
# nlp_default_fixture_window_h: look-ahead window for disambiguation backoff
#   (hours).  When predict.* intent cannot resolve to a single fixture, the
#   dispatcher lists upcoming fixtures within this window.  Range: 1–720.
NEGELIR_NLP_DEFAULT_FIXTURE_WINDOW_H=48
# nlp_summary_max_fixtures: max fixtures in summary.next_week / summary.matchday
#   fan-out.  Range: 1–100.
NEGELIR_NLP_SUMMARY_MAX_FIXTURES=10
# nlp_summary_aggregation_timeout_ms: how long nlp.answer.v1 waits for all
#   predict.approved.v1 arrivals in a summary fan-out before emitting a
#   degraded answer.  Must be <= nlp_pipeline_timeout_ms.  Range: 1–300000.
NEGELIR_NLP_SUMMARY_AGGREGATION_TIMEOUT_MS=1500
# nlp_dispatch_dedup_window_s: sliding dedup window for dispatcher idempotency
#   key (qa_correlation_id, intent, entity_hash).  Replayed qa.intent.v1
#   messages seen within this window are silently dropped (§10.6).  Must be
#   >= nlp_request_dedup_window_s.  Range: 1–86400.  Default: 600.
NEGELIR_NLP_DISPATCH_DEDUP_WINDOW_S=600

# ── Phase 10 §10.7 — Answer generation / template rendering ──────────────
# Confidence band thresholds for the confidence_band Jinja2 filter/global.
# JSON list of [lower_inclusive, upper_exclusive, label] triples.  Labels
# must be Turkish.  First matching band wins.  Default 3-band table:
#   prob < 0.55 → "düşük", 0.55–0.75 → "orta", > 0.75 → "yüksek".
NEGELIR_NLP_CONFIDENCE_BANDS=[[0.0,0.55,"düşük"],[0.55,0.75,"orta"],[0.75,1.01,"yüksek"]]

# Default locale for NLP templates and responses (§10.17).
# Format: IETF BCP 47 language tag (e.g., "tr-TR", "en-GB", "en-US").
# Template resolution: ai/nlp/templates/<intent>.<locale>.j2
# Per-request override via Phase 9 Accept-Language header (lossy-mapped to
# supported set). v1 ships tr-TR only; en-GB/en-US forward hook post-Phase-13a.
NEGELIR_NLP_DEFAULT_LOCALE=tr-TR

# Phase 10 §10.21.1 — Hypothesis profile for NLP property-based tests.
# Max examples per test. Higher = better shrinking, slower CI. (1–10000)
NEGELIR_NLP_HYPOTHESIS_MAX_EXAMPLES=1000

# Phase 10 §10.21.2 — Singleflight event-map sweeper (orphan cleanup).
# Sweeper poll interval (seconds): background thread wakes every this many
# seconds, drops orphaned events older than event_max_age_s, and emits
# nlp.event.v1{kind=singleflight_event_swept, count=N} (debounced). (1–3600)
NEGELIR_NLP_SINGLEFLIGHT_SWEEP_INTERVAL_S=30
# Orphan threshold (seconds): events older than this age are dropped by the
# sweeper.  A crashed dispatcher may leave an event un-set forever; the
# sweeper reaps it. (1–3600)
NEGELIR_NLP_SINGLEFLIGHT_EVENT_MAX_AGE_S=60
# Hard cap on the event map size: over-cap → new sf.do() calls are rejected
# with an exception + nlp.alert.v1{kind=nlp_singleflight_overflow, severity=warn}.
# Defends against unbounded growth from a wedged pipeline or abnormal query
# rate. (1–100000)
NEGELIR_NLP_SINGLEFLIGHT_MAX_INFLIGHT=2048

# ── Phase 8 — Self-maintenance plane (ops console + maint.event/ack) ──
# §8.1 ops console baseline. The CLI lives at xops/opsctl/__main__.py
# and publishes maint.event.v1 → waits for maint.ack.v1 from each
# expected consumer (kind→consumer-set map: ai/swarm/agents/maint/
# _ack_routing.py). Bus-down replays land in OPSCTL_SPOOL_DIR and are
# drained by `make ops.spool-flush`. Empty AUDIT_PATH / SPOOL_DIR
# resolve to <DATA_DIR>/maint/opsctl_audit.csv and
# <DATA_DIR>/maint/opsctl_spool/ respectively.
NEGELIR_OPSCTL_ACK_TIMEOUT_MS=5000
# Phase 8 §8.16.13 — local Redis Streams budget for `make swarm.demo.live`.
# Must stay lower than NEGELIR_OPSCTL_ACK_TIMEOUT_MS.
NEGELIR_OPSCTL_ACK_TIMEOUT_MS_LIVE_DEMO=1000
# Phase 9 §9.13 — base URL for `make swarm.demo.live` API smoke test.
# Override when the API runs on a non-default port or host locally.
NEGELIR_API_DEMO_BASE_URL=http://localhost:8080
NEGELIR_OPSCTL_SPOOL_MAX_ENTRIES=1024
# Critical agents: destructive ops console commands (scale=0, restart,
# maint-pause) require typed-token confirmation when their target is in
# this set. Comma-separated agent ids (whitespace-tolerant).
NEGELIR_OPSCTL_CRITICAL_AGENTS=consensus.v1,sec.rate.v1,maint.backup.v1
NEGELIR_OPSCTL_AUDIT_PATH=
NEGELIR_OPSCTL_SPOOL_DIR=
# Re-entrancy lock dir (per (host, kind, target) advisory flock).
# Empty resolves to <DATA_DIR>/maint/opsctl_locks/. Stale lockfiles
# (no live holder, mtime older than ACK_TIMEOUT_MS × STALE_FACTOR)
# are reaped on the next acquire.
NEGELIR_OPSCTL_LOCK_DIR=
NEGELIR_OPSCTL_LOCK_STALE_FACTOR=2
# §8.16.2 spool-flush ack reconciler: alert horizon (hours) for
# audit rows with received_acks < expected_acks. Default 24h matches
# the operator-day cadence in `make ops.spool-reconcile`.
NEGELIR_OPSCTL_SPOOL_ACK_MAX_WAIT_H=24
# §8.14.10 drain-budget per flush invocation: max envelopes drained in one run.
# 0 = unlimited. Default 100 bounds wall-clock cost against a wedged bus.
# Partial flushes emit kind=spool_flush_partial; re-run or set up a cron.
NEGELIR_OPSCTL_SPOOL_FLUSH_MAX_PER_RUN=100
# maint.ack.v1 producer-side payload caps (consumers truncate at these
# limits + emit maint_ack_oversize debounced alert per §8.9 DoD).
NEGELIR_MAINT_ACK_PAYLOAD_MAX_BYTES=4096
NEGELIR_MAINT_ACK_REASON_MAX_BYTES=512
NEGELIR_MAINT_ACK_DETAILS_MAX_BYTES=2048
# §8.14.4 Redis ACL + signed envelopes.
# ACL username opsctl must authenticate as (provisioned by §2 mock + Phase 14 K8s).
NEGELIR_OPSCTL_REDIS_EXPECTED_USER=negelir_opsctl
# Runtime env hint (NOT a config knob — not read by ai/common/config.py):
# The negelir_opsctl ACL password goes into infra/redis/acl.conf at deploy time.
# In production inject via K8s Secret; never commit the real password here.
# In the §2 mock stack the password is negelir_opsctl_dev (rotate in prod).
# NEGELIR_OPSCTL_REDIS_PASSWORD=<set-via-k8s-secret-not-this-file>
# Require HMAC-SHA256 op_signature on every published envelope (true in prod).
# Set to false in mock/test environments to skip signing.
NEGELIR_OPSCTL_REQUIRE_SIGNATURE=true
# Path to the 32-byte operator key file (mode 0600).
# Empty resolves to ~/.negelir/opsctl_key. Generate with: make ops.bootstrap-key
NEGELIR_OPSCTL_KEY_PATH=
# Path to operator registry JSON (key_id → email). Empty = infra/maint/opsctl_operators.json
NEGELIR_OPSCTL_OPERATORS_FILE=
# Path to per-subcommand authz YAML. Empty = infra/maint/opsctl_authz.yaml
NEGELIR_OPSCTL_AUTHZ_FILE=

# ── Phase 8 §8.15.4 — HMAC key lifecycle ───────────────────────────
# Grace period in seconds after revoked_at during which old keys still
# verify (to absorb in-flight requests). Default 60 s.
NEGELIR_OPSCTL_KEY_REVOCATION_GRACE_S=60
# Maximum key age in days before rotation is flagged as overdue. Default 365 d.
NEGELIR_OPSCTL_KEY_MAX_AGE_DAYS=365
# Additional grace period in days after max_age before auto-revoke fires. Default 30 d.
NEGELIR_OPSCTL_KEY_REVOCATION_GRACE_DAYS=30
# How often (seconds) the consumer-side OperatorsCache reloads the operators
# file from disk (mtime-poll). Default 60 s.
NEGELIR_OPSCTL_OPERATORS_RELOAD_S=60
# Path to kill-switch sentinel file. Touch this file to drop ALL operator
# envelopes immediately. Empty = infra/maint/opsctl_kill_switch.
NEGELIR_OPSCTL_KILL_SWITCH_PATH=
# Kill-switch file max age in hours. If the sentinel is older than this,
# it is ignored (prevents stale kill-switches surviving after a restart).
NEGELIR_OPSCTL_KILL_SWITCH_MAX_AGE_H=24
# Per-key HMAC rate limit (requests per minute). Excess triggers a debounced
# critical alert. 0 = unlimited. Default 30.
NEGELIR_OPSCTL_KEY_RATE_LIMIT_PER_MIN=30

# ── Phase 8 §8.2 — `maint.scaler.v1` agent ─────────────────────────
# Decision window in ms. Anchored on a monotonic clock (Linux:
# CLOCK_BOOTTIME via auto). `boottime` and `monotonic` are explicit.
NEGELIR_MAINT_SCALER_DECISION_WINDOW_MS=30000
NEGELIR_MAINT_SCALER_CLOCK_SOURCE=auto
# Phase 8 §8.15.1 — suspend-detection probe threshold in seconds.
# The heartbeat agent computes (boottime_ns - monotonic_ns); a step-up
# exceeding this value within one heartbeat interval indicates a container
# suspend. Set to 0 to disable. Default 30 s.
NEGELIR_MAINT_CLOCK_SUSPEND_ALERT_S=30
NEGELIR_MAINT_SCALER_MAX_TARGETS=256
NEGELIR_MAINT_SCALER_MAX_REPLICAS=16
# Phase 8 §8.16.1 — conservative-by-default ceiling applied to any
# registered agent missing from NEGELIR_MAINT_SCALER_MAX_REPLICAS_OVERRIDES_CSV.
# 0 = disabled (legacy: fall back to NEGELIR_MAINT_SCALER_MAX_REPLICAS, no alert).
# Set to >=2 to OPT IN to the conservative posture + one-shot alerts.
NEGELIR_MAINT_SCALER_DEFAULT_MAX_REPLICAS=0
NEGELIR_MAINT_SCALER_MIN_REPLICAS=1
# Queue depth that triggers scale-up; under scale-down for shrink.
NEGELIR_MAINT_SCALER_SCALE_UP_QUEUE_DEPTH=50
NEGELIR_MAINT_SCALER_SCALE_DOWN_QUEUE_DEPTH=5
NEGELIR_MAINT_SCALER_SCALE_UP_HEAD_AGE_S=30
# Hysteresis: signal must persist for N windows before action;
# grace = N additional windows before reverting.
NEGELIR_MAINT_SCALER_HYSTERESIS_WINDOWS=3
NEGELIR_MAINT_SCALER_HYSTERESIS_GRACE=1
# Cap on scale_decisions emitted per window (rest become scale_throttled).
NEGELIR_MAINT_SCALER_MAX_CHANGES_PER_WINDOW=4
# Operator pin TTL in seconds (manual_scale_pin).
NEGELIR_MAINT_SCALER_MANUAL_PIN_TTL_S=1800
# Per-agent max_replicas overrides as `agent=N,agent2=M` (empty =
# every target uses NEGELIR_MAINT_SCALER_MAX_REPLICAS).
NEGELIR_MAINT_SCALER_MAX_REPLICAS_OVERRIDES_CSV=
# Replica count published when scaler reacts to a retrain_request.
NEGELIR_MAINT_SCALER_WARMUP_REPLICAS=1
# Phase 8 §8.14.8 — comma-separated agent names that self-scale.
# The auto-scaler will NOT emit scale_decision for these targets;
# it emits scale_throttled{reason=self_scaling_target} instead.
# Default: trainer.v1 (the trainer manages its own replica count).
NEGELIR_MAINT_SCALER_SELF_SCALING_TARGETS=trainer.v1
# Phase 8 §8.15.9 — JSON-encoded list of 5-field UTC cron expressions
# (minute hour dom month dow) marking known high-load periods during
# which the §8.3 backup agent inflates PG/IO signals. The auto-scaler
# suppresses load-driven decisions during active windows and emits
# scale_throttled{reason=noise_window_active}. Emergency decisions
# (vram_budget_exceeded, manual_pin) always fire. Empty list disables
# suppression. Default covers nightly backup window (03:00-05:59 UTC)
# and Sunday cold-verify (05:00 UTC, DOW=0).
NEGELIR_MAINT_SCALER_NOISE_WINDOWS=["0 3-5 * * *","0 5 * * 0"]
# Runtime selector: ``none`` (default — pure observer, no runtime
# call), ``compose`` (docker compose --scale), ``k8s`` (Phase 14).
NEGELIR_MAINT_RUNTIME=none
# Compose file used by ``ComposeController`` when MAINT_RUNTIME=compose.
NEGELIR_MAINT_SCALER_COMPOSE_FILE=docker-compose.yml
# Subprocess timeout for any runtime call (compose / k8s patch).
NEGELIR_MAINT_SCALER_RUNTIME_TIMEOUT_S=30
# Hard global cap across every target — defends against runaway
# auto-scale during a self-amplifying lag storm.
NEGELIR_MAINT_SCALER_GLOBAL_MAX_REPLICAS=64
# Minimum interval between two scale_decision events for the SAME
# target across distinct decision windows. Inside this window a
# candidate decision is coalesced and emits scale_throttled.
NEGELIR_MAINT_SCALER_MIN_DECISION_INTERVAL_S=90
# Headroom (MB) subtracted from total per-host VRAM before the
# scaler computes its budget — prevents pod packing that OOMs the
# host on a transient spike.
NEGELIR_MAINT_SCALER_VRAM_HEADROOM_MB=1024
# Phase 8 §8.16.8 — VRAM-budget pessimism factor (fraction 0..1) for agents
# whose VRAM footprint is unknown. Scale-up refused when VRAM already committed
# exceeds this fraction of the device budget. 0.6 = 60% threshold.
NEGELIR_MAINT_SCALER_VRAM_PESSIMISTIC_THRESHOLD_PCT=0.6
# Phase 8 §8.16.8 — CPU-class agent scale-up budget (fraction 0..1 of total
# detected cores per host). No-op in single-host compose mode; enforced under
# K8s (Phase 14). 0.8 = 80% of host cores may be consumed by cpu-class agents.
NEGELIR_MAINT_SCALER_CPU_BUDGET_PCT=0.8
# Phase 8 §8.2 A1 — scale-down grace: smoothed signals must remain
# below the down-scale threshold for this many consecutive decision
# windows before a scale-down is emitted (0 disables the gate).
NEGELIR_MAINT_SCALER_SCALE_DOWN_GRACE_WINDOWS=2
# Phase 8 §8.2 A1 — Welford rolling-sketch retention. Signals are
# smoothed over this many most-recent samples per (target, signal)
# pair. 0 → instantaneous decisions (legacy behaviour).
NEGELIR_MAINT_SCALER_SIGNAL_WINDOW_SAMPLES=5
# Phase 8 §8.2 A2 — load-driven clamp formula:
#   desired_replicas = clamp(min, ceil(observed_load / target_load_per_replica), max)
# observed_load is the smoothed queue_depth. 0 reverts to the
# legacy ±1-step decision.
NEGELIR_MAINT_SCALER_TARGET_LOAD_PER_REPLICA=50
# Phase 8 §8.2 A2 — cap on replicas added/removed per single
# decision window (defends against cold-start swings).
NEGELIR_MAINT_SCALER_MAX_STEP_PER_WINDOW=1
# Phase 8 §8.2 — observability: histogram bucket boundaries (CSV of
# strictly-positive floats in seconds) for the
# ``maint_scaler_runtime_call_seconds`` histogram. Parser sorts
# ascending and de-duplicates. Default mirrors the prometheus
# 5ms..10s ladder which covers both the noop path (~µs) and a slow
# ``docker compose --scale`` (~seconds).
NEGELIR_MAINT_SCALER_RUNTIME_HISTOGRAM_BUCKETS=0.005,0.01,0.025,0.05,0.1,0.25,0.5,1.0,2.5,5.0,10.0
# Bounded global decision history size (insertion-order LRU). Oldest
# scale_decision entries evicted when cap is hit. Default 1024 covers
# ~14h at the default 30s window cadence across a full target roster.
NEGELIR_MAINT_SCALER_HISTORY_MAX=1024
# Phase 8 §8.9 — leader-lease duration (seconds) for maint-plane agents.
# A losing pod transitions to observer mode no later than this many seconds
# after its last successful K8s coordination-API renewal.  Mirrors
# leaseDurationSeconds on the coordination.k8s.io/v1.Lease (Phase 14).
NEGELIR_MAINT_LEADER_LEASE_DURATION_S=15

# ── Phase 8 §8.4 — source-watcher summarizer graduation ───────────
# `true` only takes effect when a pinned model id is configured AND
# the startup probe below can reach the summarizer endpoint from the
# agent container.
NEGELIR_SOURCE_WATCHER_SUMMARIZER_ENABLED=false
# Pinned model identifier only; `*-latest` / `:latest` are refused.
NEGELIR_SOURCE_WATCHER_SUMMARIZER_MODEL_ID=
# Transport-level startup reachability probe target. LLM auth and the
# actual request/response adapter remain separate from this probe.
NEGELIR_SOURCE_WATCHER_SUMMARIZER_PROBE_URL=
NEGELIR_SOURCE_WATCHER_SUMMARIZER_PROBE_TIMEOUT_SEC=2.0
# Per-call cap clamps LLM request `max_tokens` for source-watcher
# narration so one bursty diff cannot consume the day budget.
NEGELIR_SOURCE_WATCHER_SUMMARIZER_MAX_TOKENS_PER_CALL=4096
# Daily cap on total summarizer tokens (UTC day boundary).
NEGELIR_SOURCE_WATCHER_SUMMARIZER_MAX_TOKENS_PER_DAY=50000
# Persisted token ledger (mode 0600, atomic temp+rename write).
NEGELIR_SOURCE_WATCHER_SUMMARIZER_LEDGER_PATH=data/maint/summarizer_ledger.json

# ── Phase 8 §8.5 — `maint.dlq.v1` supervisor ───────────────────────
NEGELIR_MAINT_DLQ_PER_TOPIC_QUOTA=100
NEGELIR_MAINT_DLQ_REPLAY_BACKOFF_S=60
NEGELIR_MAINT_DLQ_BACKOFF_LRU=1024
NEGELIR_MAINT_DLQ_REPLAY_ALLOW_OVERRIDES=
# CSV allow-list of replayable DLQ topics (each MUST end in '.dlq').
# Empty = allow every topic not in RECURSION_DENY_SET.
NEGELIR_MAINT_DLQ_REPLAY_TOPICS_ALLOW_CSV=
# After this many operator replays for a single (topic, request_id)
# the supervisor escalates and refuses further replays.
NEGELIR_MAINT_DLQ_VISIT_MAX=2
# Per-topic token-bucket cap on replay attempts per minute.
NEGELIR_MAINT_DLQ_PER_TOPIC_MAX_PER_MIN=60
# LRU cap on the (topic, request_id) → visit_count map.
NEGELIR_MAINT_DLQ_VISIT_LRU=4096
# Phase 8 §8.5 C1 — periodic-tick total replay budget across all
# active DLQ topics. Per-tick per-topic share is
# max(1, this // len(active_topics)) so a single hot topic cannot
# starve the rest.
NEGELIR_MAINT_DLQ_MAX_REPLAYS_PER_TICK=50
# Phase 8 §8.5 C2 — poison-pattern detection. ≥ N distinct request_ids
# escalating on the same topic within W seconds freezes that topic and
# fires sec.alert.v1{kind=consumer_likely_broken}. Lift via ops.dlq-resume.
NEGELIR_MAINT_DLQ_CONSUMER_BROKEN_THRESHOLD=5
NEGELIR_MAINT_DLQ_CONSUMER_BROKEN_WINDOW_S=600
# Phase 8 §8.5 backlog-pressure damping. When a DLQ topic depth
# exceeds this, the supervisor emits a debounced
# sec.alert.v1{kind=dlq_backlog_high} and quarters that topic's
# per-tick replay budget until depth halves.
NEGELIR_MAINT_DLQ_BACKLOG_ALERT=1000
# Phase 8 §8.9 DoD — bounded in-memory topic-state map cap (LRU
# insertion-order eviction). Pressure alert fires when an evicted
# entry is younger than REPLAY_BACKOFF_S × BACKOFF_FACTOR × 3.
NEGELIR_MAINT_DLQ_STATE_MAX=100000
# Backoff multiplier used for cap-pressure evaluation window.
NEGELIR_MAINT_DLQ_BACKOFF_FACTOR=2
# Phase 8 §8.9 DoD — per-topic per-second replay rate cap (enforced
# on both operator-driven and periodic-tick paths).
NEGELIR_MAINT_DLQ_REPLAY_RPS=10

# ── Phase 8 §8.6 — `maint.schema.v1` sentinel ──────────────────────
# Per-topic sample rate (token bucket); burst is the bucket capacity.
NEGELIR_MAINT_SCHEMA_SAMPLE_RATE_PER_S=5
NEGELIR_MAINT_SCHEMA_BURST=10
NEGELIR_MAINT_SCHEMA_DRIFT_DEBOUNCE_S=60
NEGELIR_MAINT_SCHEMA_DRIFT_LRU=512
# Phase 8 §8.6 Detector B — cadence (seconds) for the PG-column-vs-
# migration drift crawl. Default 3600 (1h). Floor 60s.
NEGELIR_MAINT_SCHEMA_PG_CHECK_INTERVAL_S=3600
# Phase 8 §8.6 binding boundary — auto-apply migrations is OUT OF
# SCOPE for v1 (humans only; or Phase 17 patcher under `migration`
# scope). This knob exists for forward compatibility; defaults to
# false. Setting it `true` logs a startup warning and emits a
# one-shot sec.alert.v1{kind=schema_auto_apply_misconfigured,
# severity=warn} — no auto-apply code path exists in v1.
NEGELIR_MAINT_SCHEMA_AUTO_APPLY_ENABLED=false
# Phase 8 §8.14.7 — hard per-process cross-topic validation-rate cap.
# Over-budget validates are dropped and counted; a debounced
# sec.alert.v1{kind=maint_schema_sample_rate_too_high} fires when
# the drop-rate exceeds 10 % of attempted over a 60 s window.
# Safety ceiling is 500 — values above 500 refuse to start
# (fail_safe_validate_rps_cap_exceeded). Default 50 rps.
NEGELIR_MAINT_SCHEMA_VALIDATE_MAX_RPS=50

# ── Phase 8 §8.7 + §8.8 — `maint.sec.v1` agent ─────────────────────
# Pattern allowlist active TTL (operator-confirmed FP suppressions).
NEGELIR_MAINT_SEC_PATTERN_TTL_S=604800
NEGELIR_MAINT_SEC_PATTERN_PROMOTE_THRESHOLD=1
# Days before an un-promoted pending row is pruned (bounds table growth).
NEGELIR_MAINT_SEC_PATTERN_PENDING_TTL_DAYS=30
# Phase 8 DoD canonical name for the allowlist pending-row TTL (same
# semantic as MAINT_SEC_PATTERN_PENDING_TTL_DAYS; required by triangle test).
NEGELIR_MAINT_SEC_ALLOWLIST_PENDING_TTL_DAYS=30
NEGELIR_MAINT_SEC_REQUEST_LRU=2048
# Phase 8 §8.8 hysteresis — minimum seconds between two
# denylist_decimate_now runs (global; one zset, one signal). A
# second decimate inside the window acks accepted=true with
# reason="hysteresis_throttled".
NEGELIR_MAINT_SEC_DECIMATE_MIN_INTERVAL_S=300

# ── Phase 8 §8.10 — broadcast pause / resume ───────────────────────
NEGELIR_MAINT_PAUSE_DEFAULT_TTL_S=600
# Hard cap on operator-specified pause TTL. Agents truncate any request
# longer than this and emit maint_pause_ttl_capped. Default 86400s (24h).
NEGELIR_MAINT_PAUSE_MAX_TTL_S=86400
NEGELIR_MAINT_SILENCE_DEDUP_S=300
# Phase 8 §8.16 D2 — dead-mans-switch. If no maint.event.v1 has been
# observed for this many hours (after the warmup grace), emit a
# critical sec.alert.v1{kind=maint_silence_alert}. Self-DLQ alert
# threshold flips an agent into PauseState.self_isolated mode.
NEGELIR_MAINT_SILENCE_ALERT_H=24
NEGELIR_MAINT_SILENCE_WARMUP_S=3600
NEGELIR_MAINT_SELF_DLQ_ALERT=100
# Growth-rate self-throttle (§8.11): agent halves its emit rate when its
# own DLQ depth grows by more than this many entries per minute. Lifts
# once growth is non-positive for MAINT_SELF_DLQ_THROTTLE_RECOVERY_S s.
NEGELIR_MAINT_SELF_DLQ_GROWTH_ALERT=50
# Seconds of non-positive DLQ growth required before the per-agent
# self-throttle lifts (default 120 = 2 minutes).
NEGELIR_MAINT_SELF_DLQ_THROTTLE_RECOVERY_S=120

# ── Phase 8 §8.11 — consumer-lag watchdog ──────────────────────────
# Tier-1 fires when median lag exceeds this threshold (ms) for the
# alert window.  Tier 2 = 15 000ms (hard-coded), Tier 3 = 60 000ms.
NEGELIR_MAINT_PLANE_LAG_ALERT_MS=5000
NEGELIR_MAINT_PLANE_LAG_ALERT_WINDOW_S=60
# Symmetric sec.alert.v1 consumer-lag watchdog (§8.16.11).
NEGELIR_SEC_PLANE_LAG_ALERT_MS=5000
NEGELIR_SEC_PLANE_LAG_ALERT_WINDOW_S=60
NEGELIR_MAINT_PLANE_RECOVERY_WINDOW_S=120

# ── Phase 8 §8.9 — per-agent bus circuit-breaker ──────────────────
# Consecutive publish failures before the breaker opens (bus_degraded).
NEGELIR_MAINT_BUS_FAIL_THRESHOLD=3
# Time window (seconds) within which the consecutive failures must occur
# for the breaker to open.  A failure outside this window resets the
# streak counter.  Default 30s per §8.11 spec.
NEGELIR_MAINT_BUS_FAIL_WINDOW_S=30.0
# Per-agent spool cap (entries); new writes refused when cap reached.
NEGELIR_MAINT_BUS_SPOOL_MAX_ENTRIES=1024
# Root directory for per-agent spool sub-directories.
NEGELIR_MAINT_AGENT_SPOOL_DIR=data/maint/agent_spool
# Cap on entries per agent in its per-agent sub-spool. Distinct from
# MAINT_BUS_SPOOL_MAX_ENTRIES (bus circuit-breaker spool). New writes
# are refused when reached; oldest entries are NOT evicted.
NEGELIR_MAINT_AGENT_SPOOL_MAX_ENTRIES=512

# ── Phase 8 §8.11 — three-tier backpressure ────────────────────────
# YELLOW: any one signal degraded → maint loops slow by FACTOR×.
# RED: hard ceiling on any one signal → maint loops halt entirely.
# Yellow MUST be < red on every dimension (validated at startup).
NEGELIR_MAINT_BACKPRESSURE_YELLOW_FACTOR=4.0
NEGELIR_MAINT_BACKPRESSURE_YELLOW_QUEUE_DEPTH=200
NEGELIR_MAINT_BACKPRESSURE_YELLOW_HEAD_AGE_S=60
NEGELIR_MAINT_BACKPRESSURE_YELLOW_STORAGE_PCT=75
NEGELIR_MAINT_BACKPRESSURE_YELLOW_ERROR_RATE_PER_S=1
NEGELIR_MAINT_BACKPRESSURE_RED_QUEUE_DEPTH=1000
NEGELIR_MAINT_BACKPRESSURE_RED_HEAD_AGE_S=300
NEGELIR_MAINT_BACKPRESSURE_RED_STORAGE_PCT=92
NEGELIR_MAINT_BACKPRESSURE_RED_ERROR_RATE_PER_S=10

# Phase 8 §8.13.2 — cumulative `data/maint/` storage cap (MB).
# Sums every per-subdir spool/audit/ledger under data/maint/ once
# per heartbeat. 80% → warn alert (debounced 1h); 100% → error
# alert + spool writes refuse with exit code 6 (maint_storage_full).
# Single hysteresis band: writes resume only when usage drops
# below 70% (prevents thrash). 0 = disabled.
NEGELIR_MAINT_STORAGE_TOTAL_MAX_MB=512

# Phase 8 §8.13.3 — spool entry max age (hours).
# Entries in both opsctl_spool and agent_spool older than this are
# pruned on every flush attempt and emit maint.event.v1 + sec.alert.v1.
# Default 168h = 7d. 0 = disabled.
NEGELIR_MAINT_SPOOL_ENTRY_MAX_AGE_H=168

# Phase 8 §8.13.3 — minimum supported spool envelope schema_version.
# Spool entries with schema_version below this value are quarantined to
# .retired/ on flush (same path as entries with a retired kind). 1 =
# accept all current schema versions. Only bump on a breaking schema change.
NEGELIR_SWARM_MIN_SUPPORTED_SCHEMA_VERSION=1

# Phase 8 §8.15.3 — advisory-lock hold-time guard (ms).
# Wall-clock cap on how long a Postgres advisory lock taken via
# xops.maint.advisory_lock.BoundLock may stay acquired before the
# context manager fires a debounced sec.alert.v1{
# kind=maint_advisory_lock_held_long, severity=warn} on release.
# Generous default — 5s — bounds accidental long transactions
# inside the critical section. 0 disables.
NEGELIR_MAINT_ADVISORY_LOCK_MAX_HOLD_MS=5000

# ── Phase 8 §8.15.7 — opsctl_audit.csv hash-chain HMAC ────────────
# Path to the 32-byte HMAC-SHA256 key file for the opsctl_audit.csv
# integrity chain (mode 0400, agent-process only).
# Empty → no chain (dev/test only — set in prod).
NEGELIR_AUDIT_CHAIN_HMAC_KEY_PATH=/var/lib/negelir/secrets/audit_chain.key
# Max bytes of opsctl_audit.csv before rotation (default 10 MB).
NEGELIR_OPSCTL_AUDIT_MAX_BYTES=10485760

# ── Phase 8 §8.14 — maint audit log ────────────────────────────────
# Base64-encoded HMAC-SHA256 secret for the §8.15.7 hash chain.
# Empty = generate per-process ephemeral key (test only — do NOT
# leave empty in prod).
NEGELIR_MAINT_AUDIT_HMAC_KEY_B64=
NEGELIR_MAINT_AUDIT_PARTITION_RETENTION_DAYS=365
# §8.15.5 — per-row hard cap for maint_audit_log payload JSONB (bytes).
# The §8.14.1 BEFORE INSERT trigger backstop truncates rows that exceed
# this to a sentinel dict.  Default 16384 (16 KB).
NEGELIR_MAINT_AUDIT_ROW_MAX_BYTES=16384
# §8.15.5 — producer-side per-kind details budget (JSON dict, kind → bytes).
# Keys are maint.event.v1 kind strings; "default" is the fallback.
# Values must be ≤ NEGELIR_MAINT_AUDIT_ROW_MAX_BYTES.
NEGELIR_MAINT_AUDIT_PER_KIND_DETAILS_MAX_BYTES={"dlq_escalated": 8192, "schema_drift_detected": 4096, "backup_dump_file_corrupted": 8192, "default": 2048}

# ── Phase 8 §8.3 — backup agent ────────────────────────────────────
# 5-field UTC cron expression that fires the nightly backup state
# machine (dump → restore-verify → prune). Operator typos are
# refused at boot by `xops.backup.cron.parse_cron`. Default = nightly
# at 03:00 UTC. Wildcards / lists / ranges / steps supported; named
# months/days are NOT (use numeric form).
NEGELIR_MAINT_BACKUP_CRON=0 3 * * *
# 5-field UTC cron expression that fires the weekly cold-verify pass
# on the oldest still-retained Sunday dump (catches silent storage
# rot / S3 lifecycle bugs / encryption-key loss). Default Sunday
# 05:00 UTC — runs after the nightly window. Cold-verify failures
# emit `kind=backup_cold_verify_failed` + `sec.alert.v1{kind=
# backup_verify_failed, severity=critical, scope=cold}` and DO NOT
# auto-prune the affected dump (operator decides).
NEGELIR_MAINT_BACKUP_COLD_VERIFY_CRON=0 5 * * 0
# Where dump artefacts + audit.csv live. Created on demand.
NEGELIR_MAINT_BACKUP_DIR=./data/backups
# Daily-grain retention. Older daily dumps are pruned; weekly
# dumps (Sunday) are kept for retention_weeks instead.
NEGELIR_MAINT_BACKUP_RETENTION_DAYS=14
NEGELIR_MAINT_BACKUP_RETENTION_WEEKS=4
# Safety floor — when true, every emit carries dry_run=true and NO
# destructive prune is executed (would_delete_count instead). Default
# false (safe for production). Set to `true` in dev/CI environments
# (e.g. via .env or docker-compose override) to prevent accidental
# destructive prune.
NEGELIR_MAINT_BACKUP_DRY_RUN=false
# Disk-pressure guard — refuse to start a dump if free space <
# max(2*last_dump_size, min_free_gb*1GB).
NEGELIR_MAINT_BACKUP_MIN_FREE_GB=5
# Catch-up: at most one make-up run if monotonic delta vs last
# successful fire exceeds this many hours.
NEGELIR_MAINT_BACKUP_MAX_SKEW_H=36
# Refuse the destructive prune phase if the most recent successful
# dump is older than this many hours.
NEGELIR_MAINT_BACKUP_AGE_ALERT_H=30
# Backwards wall-clock step bigger than this (seconds) → emit
# sec.alert.v1{kind=backup_clock_skew, severity=error} and skip this
# fire (refuse-to-start safety floor).
NEGELIR_MAINT_BACKUP_CLOCK_STEP_BACK_ALERT_S=300
# Forward wall-clock leap (last_fire → now) bigger than this (hours)
# → operator-visibility warn marker on the next backup_started event
# (`forward_leap_h` extra). The catch-up policy still owns the missed
# window; this is purely the early-warning surface (`scope=forward`).
NEGELIR_MAINT_BACKUP_CLOCK_STEP_FORWARD_ALERT_H=24
# pg_dump parallelism (-j flag); 1 disables parallel mode.
NEGELIR_MAINT_BACKUP_PG_JOBS=2
# §8.14.3 supply-chain pin — minimum acceptable `age` binary semantic version
# (major.minor.patch). Boot guard refuses to run if the installed version is
# older than this value. Update alongside infra/maint/age_binary_provenance.txt.
NEGELIR_MAINT_BACKUP_AGE_BINARY_VERSION=1.2.0
# DELETE batch size for the destructive prune phase. Bounded so a
# single cron run cannot hold a long-lived row-lock cascade.
# ROADMAP §8.16.3 binding (fail_safe_prune_order_invalid): boot validation
# in PruneOrderValidator asserts PRUNE_ORDER is a valid topological sort
# of the live PG FK graph — drift causes a refuse-to-start + critical alert.
NEGELIR_MAINT_BACKUP_PRUNE_BATCH=10000
# Maximum milliseconds a single prune batch may hold a table lock (§8.9 DoD).
NEGELIR_MAINT_BACKUP_PRUNE_MAX_LOCK_MS=500
# ROADMAP §8.3 TTL prune retention windows (calendar days). Schema
# snapshots accumulate from Phase 4 storage.v1; DLQ entries from the
# Phase 9 Postgres backend; opsctl_audit + maint_audit_log are
# operator trails (longest retention by design).
NEGELIR_MAINT_SCHEMA_SNAPSHOT_RETENTION_DAYS=90
NEGELIR_SWARM_DLQ_PG_RETENTION_DAYS=14
NEGELIR_MAINT_AUDIT_RETENTION_DAYS=365
# Per-kind retention overrides (JSON dict, kind → days). Default ships
# the ROADMAP §8.9 right-to-erasure requirement: pii_erased rows kept
# for 2555 days (7 years) as breach-evidence records.
NEGELIR_MAINT_AUDIT_RETENTION_DAYS_OVERRIDES={"pii_erased": 2555}
# Live `pg_dump` DSN — empty disables the live driver (in-memory shim
# is used; production swarm bootstrap refuses to start without this).
NEGELIR_MAINT_BACKUP_PG_DSN=
# Path to the `age` recipients file (one DR-class public key per line).
# Required when the live `LocalPgDumpExecutor` is wired.
NEGELIR_MAINT_BACKUP_AGE_RECIPIENTS_FILE=
# Directory of versioned recipient public keys (`keys.vN.age.pub` +
# optional `keys.vN.recipients.txt`). Empty disables encryption-at-rest.
# When NEGELIR_PROFILE=prod AND NEGELIR_MAINT_RUNTIME!=none, an unset
# value here AND an unset NEGELIR_MAINT_BACKUP_AGE_RECIPIENTS_FILE
# trips the `fail_safe_no_encryption_in_prod` boot refusal.
NEGELIR_MAINT_BACKUP_ENCRYPTION_KEY_DIR=
# Minimum DR-class recipients required in each `keys.vN.recipients.txt`
# under NEGELIR_MAINT_BACKUP_ENCRYPTION_KEY_DIR. Default `2` matches the
# ROADMAP §8.3 prod binding (single-recipient DR is a single point of
# disaster-recovery failure). Mock stacks may override to `1`.
NEGELIR_MAINT_BACKUP_MIN_DR_RECIPIENTS=2
# Path to the `age` identity file used by the restore-verifier to
# decrypt dumps in the ephemeral scratch container.
NEGELIR_MAINT_BACKUP_AGE_IDENTITY_FILE=
# Pinned Postgres image for the restore-verifier scratch container.
# Must NOT be `*-latest` (CLAUDE.md doctrine).
NEGELIR_MAINT_BACKUP_VERIFY_PG_IMAGE=postgres:16-alpine
# §8.14.9 nice level for pg_dump subprocess (0=disabled; 10=default; bounded 0-19).
# Mock / dedicated-PG deployments can set 0 to skip niceing.
NEGELIR_MAINT_BACKUP_PG_DUMP_NICE_LEVEL=10
# §8.14.9 ionice wrapping for pg_dump on Linux (best-effort I/O, lowest prio).
# Ignored on non-Linux. Set false in mock or test environments.
NEGELIR_MAINT_BACKUP_PG_DUMP_IONICE=true
# Restore-verify mode (ROADMAP §8.3 escape hatch). One of `full`
# (default — full pg_restore + verify.sql suite) or `toc_only`
# (pg_restore --list only — validates dump TOC without restoring rows;
# for very-large-DB nightly windows). Weekly cold-verify always runs
# the full suite regardless. Any other value refuses the agent at
# boot.
NEGELIR_MAINT_BACKUP_VERIFY_MODE=full
# ROADMAP §8.13.4 restore version-invariant: maximum schema-version gap
# (in_tree_max_version - manifest.max_version) before restore-verify refuses
# with backup_dump_too_old + sec.alert.v1{severity=error}. Default 5 covers
# ~quarterly migration cadence. Operator must escalate when gap exceeds this.
NEGELIR_MAINT_BACKUP_MAX_VERSION_GAP=5
# PII-aware dump: comma-separated table.column entries excluded from
# the logical dump by default. Maps to pg_dump --exclude-table-data
# in the live executor. ROADMAP §8.9 DoD: raw_bytes_b64 excluded so
# quarantined payload bytes never land in the encrypted dump.
NEGELIR_MAINT_BACKUP_PII_EXCLUDED_COLUMNS=quarantine_samples.raw_bytes_b64
# ROADMAP §8.3 crash-cleanup invariant: orphaned K8s Jobs + ephemeral
# PVCs under `negelir-maint-verify` that are older than this many hours
# are swept on the next agent boot and emit
# `maint.event.v1{kind=backup_verify_orphan_swept}`. Default 6h.
# The real SidecarVerifier (Phase 14) uses this for TTL filtering.
NEGELIR_MAINT_BACKUP_VERIFY_ORPHAN_TTL_H=6.0
# Size (Gi) of the ephemeral PVC provisioned for the K8s restore-verify
# job. Must be >= 2× the expected pg_restore output size.
NEGELIR_MAINT_BACKUP_PVC_SIZE_GB=10
# ROADMAP §8.9 binding (fail_safe_wrong_pg_role / fail_safe_superuser):
# the expected Postgres role name for the backup agent. Must match the role
# granted by migration 011 (negelir_backup); must NOT be a superuser.
NEGELIR_MAINT_BACKUP_PG_ROLE=negelir_backup
# ROADMAP §8.13.6 binding (fail_safe_pg_secret_expired): hard cap on the
# backup-role PG password age in days. Agent refuses to start when age
# exceeds this value, forcing rotation. Default 120d = alert@100d + 20d grace.
NEGELIR_MAINT_BACKUP_PG_SECRET_MAX_AGE_DAYS=120
# ROADMAP §8.9 two-class encryption: rotate the ephemeral verify-class
# recipient keypair each nightly dump. True (default) ensures each dump's
# verify key is distinct so a leaked verify key exposes at most one dump.
# False only for DR drills bypassing the SidecarVerifier (Phase 14).
NEGELIR_MAINT_BACKUP_VERIFY_KEY_ROTATE_PER_DUMP=true
# ROADMAP §8.9 binding (fail_safe_pg_conn_limit_too_low): minimum Postgres
# role connection limit. 0 (default) = auto-derive as pg_jobs + 1 (N parallel
# pg_dump workers + 1 coordinator). Set a higher explicit value to reserve
# additional headroom for the application connection pool.
NEGELIR_MAINT_BACKUP_PG_CONN_LIMIT=0
# ROADMAP §8.12 off-host replication (S3-compatible offsite backup target).
# Set OFFSITE_TARGET=s3 plus ENDPOINT+BUCKET to activate. Default "none" = disabled.
NEGELIR_MAINT_BACKUP_OFFSITE_TARGET=none
# S3-compatible endpoint URL. Leave empty for AWS-default region routing.
# Example: http://minio.local:9000 (local minio), https://s3.eu-central-1.amazonaws.com
NEGELIR_MAINT_BACKUP_OFFSITE_ENDPOINT=
# Destination bucket name.
NEGELIR_MAINT_BACKUP_OFFSITE_BUCKET=
# Minimum encrypted dump size (MB) to trigger S3 multipart upload. 0 = single-part.
NEGELIR_MAINT_BACKUP_OFFSITE_MULTIPART_THRESHOLD_MB=64
# Bandwidth cap (KB/s) for offsite uploads. 0 = unlimited (default).
NEGELIR_MAINT_BACKUP_OFFSITE_BW_KBPS=0
# Upload timeout per nightly fire window (hours). Exceeded → backup_offsite_failed.
NEGELIR_MAINT_BACKUP_OFFSITE_UPLOAD_TIMEOUT_H=6
# S3 Object Lock (WORM) retention period in days. 0 = no WORM lock (default for dev/mock).
# Set to 30+ in prod to prevent accidental object deletion or overwrite.
NEGELIR_MAINT_BACKUP_OFFSITE_OBJECT_LOCK_DAYS=0
# Emit backup_offsite_age_alert when the last successful offsite upload is older than
# this many hours. 0 = watchdog disabled. Default 48h (2 missed nightly windows).
NEGELIR_MAINT_BACKUP_OFFSITE_AGE_ALERT_H=48
# On-object retention in days for the remote bucket (GFS-light).
# Default: 90 d (prod) / 7 d (mock/dev) — set via NEGELIR_PROFILE-aware default in config.py.
# Override here to tune the window; must be >= object_lock_days for pruning to ever fire.
NEGELIR_MAINT_BACKUP_OFFSITE_RETENTION_DAYS=7
# S3 access key ID (public credential; the secret is referenced below).
NEGELIR_MAINT_BACKUP_OFFSITE_ACCESS_KEY_ID=
# File-path reference to the S3 secret access key. In K8s use a secretKeyRef
# volume-mount path (0400); in Compose/dev use a plain file path. NEVER the literal value.
NEGELIR_MAINT_BACKUP_OFFSITE_SECRET_ACCESS_KEY_SECRET_REF=
# AWS / S3-compatible region for SigV4 signing. Use "auto" for R2, B2, MinIO.
NEGELIR_MAINT_BACKUP_OFFSITE_S3_REGION=us-east-1
# Phase 8 §8.15.10 Fix B — offsite credential hot-reload interval (seconds).
# The FileSecretProvider background thread polls the key-id + key-secret files at
# this interval for mtime changes (atomic credential rotation without restart).
# Set to 0 to disable polling (credentials loaded once at startup).
NEGELIR_MAINT_BACKUP_OFFSITE_CRED_RELOAD_S=60
# Maximum credential age (days) before a rotation-required warning is emitted.
# 0 = age-check disabled.
NEGELIR_MAINT_BACKUP_OFFSITE_CREDENTIAL_MAX_AGE_DAYS=90
# Grace period (days) on top of max_age before upload is blocked.
# 0 = grace-check disabled.
NEGELIR_MAINT_BACKUP_OFFSITE_CREDENTIAL_GRACE_DAYS=30
# Phase 8 §8.16.5 — multipart upload-id TTL.
# Max age (hours) of .offsite_state.json before treating the persisted upload_id
# as expired without probing AWS. Default 18 h (headroom under AWS 24 h default).
# 0 = always probe (no time-based short-circuit).
NEGELIR_MAINT_BACKUP_OFFSITE_STATE_MAX_AGE_H=18
# Minimum acceptable AbortIncompleteMultipartUpload.DaysAfterInitiation.
# If the bucket's lifecycle rule is more aggressive, emits backup_offsite_lifecycle_too_aggressive.
# Default 2 days. 0 = lifecycle check disabled.
NEGELIR_MAINT_BACKUP_OFFSITE_LIFECYCLE_MIN_DAYS=2
# Phase 8 §8.16.6 — Object-Lock / WORM boot-time preflight probe.
# How often (hours) the preflight probe repeats. 0 = boot-only (no recurring probe).
NEGELIR_MAINT_BACKUP_OFFSITE_PREFLIGHT_INTERVAL_H=24
# When false the agent skips the bucket Object-Lock check (mock / non-prod only).
NEGELIR_MAINT_BACKUP_OFFSITE_OBJECT_LOCK_REQUIRED=true
# Fail-safe gates for the WORM preflight — set to false only in non-prod environments.
NEGELIR_FAIL_SAFE_OFFSITE_OBJECT_LOCK_DISABLED=true
NEGELIR_FAIL_SAFE_OFFSITE_RETENTION_NOT_APPLIED=true
NEGELIR_FAIL_SAFE_OFFSITE_LOCK_NOT_ENFORCED=true
# RsyncSshTarget: SSH host for the DR replica (user@host or bare host).
NEGELIR_MAINT_BACKUP_OFFSITE_RSYNC_HOST=
# RsyncSshTarget: absolute destination path on the remote SSH host.
NEGELIR_MAINT_BACKUP_OFFSITE_RSYNC_DEST_PATH=
# RsyncSshTarget: path to known_hosts file for strict host-key checking.
# Leave empty to fall back to the agent's ~/.ssh/known_hosts.
NEGELIR_MAINT_BACKUP_OFFSITE_RSYNC_SSH_KNOWN_HOSTS=

# Phase 8 §8.12 — DR-drill cadence gauge.
# Path to the append-only CSV recording quarterly DR-drill outcomes.
NEGELIR_MAINT_BACKUP_DR_DRILL_CSV=data/backups/dr_drills.csv
# Days before the cadence-overdue alert fires (one quarter ≈ 91 d; default 100).
NEGELIR_MAINT_BACKUP_DR_DRILL_ALERT_DAYS=100
# Phase 8 §8.15.10 Fix A — restore-verify concurrency cap.
# Seconds the nightly restore-verify waits to acquire the advisory lock before
# yielding (emitting a verify_concurrency_blocked sec.alert.v1). Cold-verify
# always yields on first contention (never waits). 0 = wait forever (not
# recommended for production).
NEGELIR_MAINT_BACKUP_VERIFY_LOCK_TIMEOUT_S=1800
# Phase 8 §8.15.10 Fix C — restore-verify forensic capture maximum file size.
# Bytes. When the serialised forensic JSON exceeds this limit the largest text
# field (pg_restore_stderr first, then pg_restore_stdout) is tail-truncated to
# fit. 0 = no limit (development shortcut only).
NEGELIR_MAINT_BACKUP_FORENSIC_MAX_BYTES=262144

# Phase 8 §8.13.1 — model-artifact backup discipline.
# Hours within which the trainer can re-derive a byte-equivalent artifact from
# the Postgres calibration/outcome rows referenced in the lineage sidecar.
NEGELIR_MAINT_BACKUP_MODEL_REPRODUCIBILITY_WINDOW_H=24
# Retention days for model tarballs in the offsite bucket.  Shorter than the PG
# retention because models are reproducible from the referenced Postgres rows.
NEGELIR_MAINT_BACKUP_MODEL_OFFSITE_RETENTION_DAYS=30
# Debounce window (hours) for the post-hoc audit alert
# sec.alert.v1{kind=backup_model_lineage_missing} per predictor_id.  Re-alerts
# at most once per window when a predictor's artifacts are persistently
# sidecar-free.  Set to 0 in tests to disable debounce.
NEGELIR_MAINT_BACKUP_MODEL_LINEAGE_MISSING_DEBOUNCE_H=24

# (test-only flag, intentionally not a runtime knob: NEGELIR_BUS_INTEGRATION=1
#  enables the Redis-backed parity tests under
#  ai/swarm/sdk/tests/test_bus_redis_integration.py)

# ── Bootstrap (real-data scrape gate before training) ──
# Minimum cached real matches required by `make bootstrap` / proofreader before
# training is allowed to proceed. Raise this once a league has full season data.
BOOTSTRAP_MIN_MATCHES=100

# ── Phase 3: Full-System Training Pipeline thresholds ──
# Min matches the trainer is willing to start on (vs BOOTSTRAP_MIN_MATCHES,
# which gates the data ingest step).
NEGELIR_TRAINING_MIN_MATCHES=100
# Pass/fail thresholds for `make train-full` verdict (model accuracy, holdout
# accuracy, quarantine fraction ceiling, holdout coverage).
NEGELIR_THRESHOLD_MODEL_ACC=0.50
NEGELIR_THRESHOLD_HOLDOUT_ACC=0.50
NEGELIR_THRESHOLD_QUARANTINE_MAX=0.10
NEGELIR_THRESHOLD_MIN_HOLDOUT_MATCHES=5
# Walk-forward holdout window (matchweeks reserved before training).
NEGELIR_VERIFICATION_WINDOW_WEEKS=4
# Where TrainingPipeline writes per-run reports + history.jsonl.
NEGELIR_REPORT_DIR=/data/reports

# ── Feature-vector firewall (roadmap §5.6.2) ──
# Optional JSON override for the feature-range clamp map used by the inference
# validator. Leave blank to use the built-in defaults from ai/common/defaults.yaml.
# Example: {"elo":[-500,3500],"sentiment":[-1,1]}
NEGELIR_FEATURE_RANGES_JSON=

# ── Scraping: Primary Sources (in priority order) ──
# Source 1: Live scores, odds, and league tables (primary)
SCRAPE_SOURCE_1=https://www.mackolik.com
# Source 2: Betting/odds aggregator (secondary)
SCRAPE_SOURCE_2=https://www.nesine.com
# Source 3: Official Turkish FA fixtures and results
SCRAPE_SOURCE_3=https://www.tff.org
# Source 4: Open-source historical scores (GitHub JSON, no rate limit)
SCRAPE_SOURCE_4=https://raw.githubusercontent.com/openfootball/football.json/master
# Source 5: European football statistics CSV archive
SCRAPE_SOURCE_5=https://www.football-data.co.uk/mmz4281
# Source 6: Fallback — historical match archive (slower, 128 seasons)
SCRAPE_SOURCE_FALLBACK=https://arsiv.mackolik.com
# Extra comma-separated sources (leave empty to disable)
SCRAPE_SOURCE_EXTRA=

# ── Mackolik Season IDs (Trendyol Süper Lig via arsiv.mackolik.com) ──
# Format: SEASON_LABEL=ID (used by fallback scraper)
MACKOLIK_SEASON_2025_2026=70381
MACKOLIK_SEASON_2024_2025=67287
MACKOLIK_SEASON_2023_2024=62682
MACKOLIK_SEASON_2022_2023=59539
MACKOLIK_SEASON_2021_2022=55775

# ── openfootball: Available Turkish Süper Lig season directories ──
# Comma-separated: season_dir:label pairs
OPENFOOTBALL_SEASONS=2018-19:2018-19,2019-20:2019-20,2020-21:2020-21,2024-25:2024-25,2025-26:2025-26

# ── football-data.co.uk: Season directory codes → labels ──
FOOTBALLDATA_UK_SEASONS=2526:2025-26,2425:2024-25,2324:2023-24,2223:2022-23,2122:2021-22,2021:2020-21,1920:2019-20,1819:2018-19

# ── Paths ──
DATA_DIR=/data
MODEL_DIR=/data/models
