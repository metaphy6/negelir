# ─────────────────────────────────────────────────────────────────────────────
# Negelir — environment variable template (LOCAL DEV)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to xops/env/.env (or run `make env`) and adjust as
# needed. Compose loads it via `env_file:` per service AND via
# `--env-file xops/env/.env` (auto-injected by xops/makefile/_common.py)
# for its own ${VAR} substitution. The Python config layer reads each
# variable below with `os.getenv(...)` defaults that match the values
# shown here.
#
# Naming convention
# -----------------
#   NEGELIR_*       AI / scraper / scheduler / training knobs (ai/common/config.py)
#   SCRAPE_*        Scraper sources & HTTP behaviour (cross-cutting)
#   POSTGRES_*      Postgres connection (Python + Go server share these)
#   REDIS_*         Redis connection (Python + Go server share these)
#   MACKOLIK_*      Mackolik archive season IDs (data layer constants)
#   OPENFOOTBALL_*  openfootball season list (data layer)
#   FOOTBALLDATA_*  football-data.co.uk season codes (data layer)
#   AI_*            Python runtime knobs that pre-date the NEGELIR_ prefix
#                   and stayed for backward compatibility
#   DB_*, HTTP_*,   Go server only (read in server/cmd/main.go); listed here
#   CACHE_*,        so docker-compose has a single source of truth
#   SERVER_*
#
# Precedence (highest → lowest):
#   1. exported shell env var
#   2. .env file (loaded by docker-compose / direnv) at xops/env/.env
#   3. hardcoded default in ai/common/config.py
#   4. canonical reference: ai/common/defaults.yaml
#
# `tests/test_config_sync.py` enforces that every NEGELIR_* / SCRAPE_* key
# documented here is actually consumed by the Python config layer, and vice
# versa. Add new env vars in BOTH places.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (local dev only) ──
# `# shared` keys are read by BOTH Python (ai/common/config.py) and
# Go (server/internal/config/config.go). Sync test enforces parity.
POSTGRES_HOST=postgres                                  # shared
POSTGRES_PORT=5432                                      # shared
POSTGRES_DB=negelir                                     # shared
POSTGRES_USER=negelir                                   # shared
# REQUIRED — generate a strong value, e.g. `openssl rand -hex 32`
POSTGRES_PASSWORD=replace_me_with_strong_secret         # shared

# ── Redis (local dev only) ──
REDIS_HOST=redis                                        # shared
REDIS_PORT=6379                                         # shared

# ── Go Server (local dev only) ──
SERVER_URL=http://server:8080
SERVER_PORT=8080
DATABASE_URL=
REDIS_URL=
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT_SEC=5
DB_PING_TIMEOUT_SEC=5
DB_RETRY_DELAY_SEC=3
REDIS_RETRY_DELAY_SEC=2
HTTP_READ_TIMEOUT_SEC=10
HTTP_WRITE_TIMEOUT_SEC=30
HTTP_SHUTDOWN_TIMEOUT_SEC=5
CACHE_MATCHES_TTL_SEC=300
CACHE_TEAMS_TTL_SEC=600

# ── AI ──
AI_DEVICE=auto
AI_LOG_LEVEL=DEBUG
# Set NEGELIR_STRICT=1 to make Config.validate() reject any unknown env key
# matching reserved prefixes (NEGELIR_*, SCRAPE_*, SWARM_*). Off by default.
NEGELIR_STRICT=0

# ── Runtime Defaults ──
NEGELIR_DEFAULT_LEAGUE_ID=super_lig
# Leave NEGELIR_DEFAULT_SEASON empty to auto-derive from today's date
# ("YYYY-YYYY+1", July rollover). Set explicitly only to pin a season.
NEGELIR_DEFAULT_SEASON=
NEGELIR_MACKOLIK_GROUP_ID=1
NEGELIR_MACKOLIK_LEAGUE_FILTER=Süper Lig

# ── Timeouts ──
NEGELIR_SERVER_FETCH_TIMEOUT=10
NEGELIR_SCRAPE_TRIGGER_TIMEOUT=30
NEGELIR_HEALTH_CHECK_TIMEOUT=5
NEGELIR_MACKOLIK_HTTP_TIMEOUT=15
NEGELIR_SCRAPE_HTTP_TIMEOUT=15
NEGELIR_FOOTBALLDATA_HTTP_TIMEOUT=10

# ── Scheduler ──
NEGELIR_SCHEDULE_DAILY_SCRAPE_HOUR=6
NEGELIR_SCHEDULE_DAILY_SCRAPE_MINUTE=0
NEGELIR_SCHEDULE_OUTCOME_CHECK_HOUR=22
NEGELIR_SCHEDULE_OUTCOME_CHECK_MINUTE=0
NEGELIR_SCHEDULE_RETRAIN_DAY=sun
NEGELIR_SCHEDULE_RETRAIN_HOUR=3
NEGELIR_SCHEDULE_HEARTBEAT_MINUTES=5

# ── Scraping ──
SCRAPE_RATE_LIMIT_SECONDS=2
NEGELIR_REAL_DATA_RATE_LIMIT=1.0
SCRAPE_USER_AGENT=Xops/0.1 (Football Analysis Research)
SCRAPE_RESPECT_ROBOTS_TXT=true

# ── Self-Healing / Failover ──
NEGELIR_SOURCE_PRIORITY=source_a,source_b,source_c,source_d
NEGELIR_STALE_THRESHOLD_SECONDS=604800
NEGELIR_STALE_CONFIDENCE_PENALTY=0.5
NEGELIR_SOURCE_FAILURE_THRESHOLD=3

# ── Model / Training ──
NEGELIR_DRIFT_WINDOW=30
NEGELIR_DRIFT_FLOOR=0.35
NEGELIR_TRAINING_NOISE_PCT=0.005
NEGELIR_TRAINING_TEST_SPLIT=0.2
NEGELIR_TRAINING_SEED=42
NEGELIR_MODEL_MAX_SIZE_MB=8.0
NEGELIR_TRAINING_SAMPLE_WEIGHTS=1.0,2.0,1.0

# ── Telemetry ──
NEGELIR_TELEMETRY_MAX_STREAM=50000
NEGELIR_REDIS_SOCKET_TIMEOUT=2

# ── Swarm SDK (Phase 3) ──
# Bus implementation: "redis" (Redis Streams; default) or "memory" (in-process,
# tests only — picks the InMemoryBus, ignores Redis).
SWARM_BUS_KIND=redis
# Consumer-group prefix; final group name is "<prefix>:<agent_name>".
SWARM_CONSUMER_GROUP_PREFIX=swarm
# Heartbeat cadence; supervisor marks an instance stale after 3× this value.
SWARM_HEARTBEAT_SEC=5  # shared
# TTL on the agent_registry hash entry (seconds). Auto-evicted by Redis if the
# instance dies without deregistering. Should be > 3× SWARM_HEARTBEAT_SEC.
SWARM_REGISTRY_TTL_SEC=30
# Max messages an agent claims at once (per-instance backpressure cap).
SWARM_MAX_IN_FLIGHT=32
# Per-message retry budget before the message goes to <topic>.dlq.
SWARM_RETRY_BUDGET=3
# Hard cap on the dead-letter stream length (Redis MAXLEN ~).
SWARM_DLQ_MAX_LEN=10000
# Time after which a pending (claimed-but-not-acked) message is reclaimed by
# another consumer via XAUTOCLAIM. Should be > p99(handler latency).
SWARM_PENDING_CLAIM_SEC=60
# HTTP port where each agent exposes /metrics in Prometheus text format.
SWARM_METRICS_PORT=9100

# ── Phase 4: Worker agents (scrape → categorize → process → store) ──
# Resolves scraper targets to mock vhosts (mock) or real upstreams (real).
# Tests + dev MUST stay on `mock`; only production sets `real`.
SCRAPE_PROFILE=mock
# Hard cap on per-fetch retries before a `scrape.request` lands in the DLQ.
SCRAPE_HTTP_MAX_RETRIES=3
# Categorizer confidence floor; below this → proof.flag, never scrape.classified.
NEGELIR_CATEGORIZER_MIN_CONF=0.55
# On-disk path the categorizer loads its trained LinearSVC from (Phase 4.2.b).
NEGELIR_CATEGORIZER_MODEL_PATH=data/models/categorizer_v1.joblib
# Cache TTLs (seconds). Records are larger and slower-moving than predictions.
NEGELIR_CACHE_RECORD_TTL_SEC=600
NEGELIR_CACHE_PREDICTION_TTL_SEC=300
# Telemetry agent's Prometheus exposer port (separate from per-agent SDK port).
NEGELIR_TELEMETRY_METRICS_PORT=9101
# Bind address for the telemetry exposer. Defaults to loopback so an
# unauthenticated /metrics endpoint is not exposed on every interface.
# Override to 0.0.0.0 only when the network policy / firewall in front
# of the container actually restricts access.
NEGELIR_TELEMETRY_METRICS_BIND=127.0.0.1
# Reactors drop events older than this (replay window upper bound).
NEGELIR_REACTOR_MAX_EVENT_AGE_SEC=86400

# ── Phase 5: Predictor swarm + consensus ──
# Consensus collection window: how long `consensus.v1` waits for `predict.vote`
# messages before fusing the votes it has, in milliseconds. Closes early once
# every healthy predictor (per agent_registry) has voted.
NEGELIR_CONSENSUS_WINDOW_MS=750
# Lower bound on `swarm_confidence` for `predict.final` to be marked
# non-degraded. Below this the proofreader (Phase 6) gates user visibility.
NEGELIR_CONSENSUS_MIN_CONFIDENCE=0.40
# Minimum number of voting predictors before consensus is considered healthy.
# Fewer voters → `predict.final.degraded=true` + degraded_reason set.
NEGELIR_CONSENSUS_MIN_VOTERS=3
# Rolling Brier-score window (matches) used to learn per-predictor weights.
NEGELIR_CONSENSUS_BRIER_WINDOW=200
# Opt-in for `pred.lgbm_market.v1`. Default off — requires odds-record coverage.
NEGELIR_PREDICTOR_MARKET_FEATURES_ENABLED=false
# Per-predictor GPU VRAM ceiling (MB). Phase 11 enforcement; Phase 5 documents.
NEGELIR_PREDICTOR_MAX_VRAM_MB=1024
# Trainer reactor debounce window per (predictor_id, league) seconds.
NEGELIR_TRAINER_DEBOUNCE_SEC=300
# Backtest CI gate: swarm log-loss must beat best individual predictor by at
# least this fraction (e.g. 0.01 = 1% improvement) per (league, market).
NEGELIR_BACKTEST_SWARM_FLOOR_PCT=0.01
# Backtest replay window in weeks. `make backtest WEEKS=N` overrides.
NEGELIR_BACKTEST_WINDOW_WEEKS=12
# Minimum match count per (league, market) for the backtest gate to apply.
NEGELIR_BACKTEST_MIN_N=20
# Phase 9 SLA budget: API request timeout ≥ consensus_window_ms + this overhead.
# Documented here; enforced by the API gateway in Phase 9.
NEGELIR_API_CONSENSUS_OVERHEAD_MS=250

# (test-only flag, intentionally not a runtime knob: NEGELIR_BUS_INTEGRATION=1
#  enables the Redis-backed parity tests under
#  ai/swarm/sdk/tests/test_bus_redis_integration.py)

# ── Bootstrap (real-data scrape gate before training) ──
# Minimum cached real matches required by `make bootstrap` / proofreader before
# training is allowed to proceed. Raise this once a league has full season data.
BOOTSTRAP_MIN_MATCHES=100

# ── Phase 3: Full-System Training Pipeline thresholds ──
# Min matches the trainer is willing to start on (vs BOOTSTRAP_MIN_MATCHES,
# which gates the data ingest step).
NEGELIR_TRAINING_MIN_MATCHES=100
# Pass/fail thresholds for `make train-full` verdict (model accuracy, holdout
# accuracy, quarantine fraction ceiling, holdout coverage).
NEGELIR_THRESHOLD_MODEL_ACC=0.50
NEGELIR_THRESHOLD_HOLDOUT_ACC=0.50
NEGELIR_THRESHOLD_QUARANTINE_MAX=0.10
NEGELIR_THRESHOLD_MIN_HOLDOUT_MATCHES=5
# Walk-forward holdout window (matchweeks reserved before training).
NEGELIR_VERIFICATION_WINDOW_WEEKS=4
# Where TrainingPipeline writes per-run reports + history.jsonl.
NEGELIR_REPORT_DIR=/data/reports

# ── Feature-vector firewall (roadmap §5.6.2) ──
# Optional JSON override for the feature-range clamp map used by the inference
# validator. Leave blank to use the built-in defaults from ai/common/defaults.yaml.
# Example: {"elo":[-500,3500],"sentiment":[-1,1]}
NEGELIR_FEATURE_RANGES_JSON=

# ── Scraping: Primary Sources (in priority order) ──
# Source 1: Live scores, odds, and league tables (primary)
SCRAPE_SOURCE_1=https://www.mackolik.com
# Source 2: Betting/odds aggregator (secondary)
SCRAPE_SOURCE_2=https://www.nesine.com
# Source 3: Official Turkish FA fixtures and results
SCRAPE_SOURCE_3=https://www.tff.org
# Source 4: Open-source historical scores (GitHub JSON, no rate limit)
SCRAPE_SOURCE_4=https://raw.githubusercontent.com/openfootball/football.json/master
# Source 5: European football statistics CSV archive
SCRAPE_SOURCE_5=https://www.football-data.co.uk/mmz4281
# Source 6: Fallback — historical match archive (slower, 128 seasons)
SCRAPE_SOURCE_FALLBACK=https://arsiv.mackolik.com
# Extra comma-separated sources (leave empty to disable)
SCRAPE_SOURCE_EXTRA=

# ── Mackolik Season IDs (Trendyol Süper Lig via arsiv.mackolik.com) ──
# Format: SEASON_LABEL=ID (used by fallback scraper)
MACKOLIK_SEASON_2025_2026=70381
MACKOLIK_SEASON_2024_2025=67287
MACKOLIK_SEASON_2023_2024=62682
MACKOLIK_SEASON_2022_2023=59539
MACKOLIK_SEASON_2021_2022=55775

# ── openfootball: Available Turkish Süper Lig season directories ──
# Comma-separated: season_dir:label pairs
OPENFOOTBALL_SEASONS=2018-19:2018-19,2019-20:2019-20,2020-21:2020-21,2024-25:2024-25,2025-26:2025-26

# ── football-data.co.uk: Season directory codes → labels ──
FOOTBALLDATA_UK_SEASONS=2526:2025-26,2425:2024-25,2324:2023-24,2223:2022-23,2122:2021-22,2021:2020-21,1920:2019-20,1819:2018-19

# ── Paths ──
DATA_DIR=/data
MODEL_DIR=/data/models
