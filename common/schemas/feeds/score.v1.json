{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Score Payload (v1) — Live-plane entity",
  "description": "Phase 16 — Live match state (score, minute, events, lineup confirmation). Per EMITTER.md §3.3, events[] is monotonic append-only within a match. Status transitions trigger new Records. Invariants enforce score consistency.",
  "type": "object",
  "required": [
    "match_stable_id",
    "minute",
    "status",
    "home",
    "away"
  ],
  "additionalProperties": false,
  "properties": {
    "match_stable_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier for the match (joins with schedule, lineup, market)."
    },
    "minute": {
      "type": "integer",
      "minimum": 0,
      "description": "Elapsed minutes in the match (0-90 for regular time, 90+ for extra time)."
    },
    "status": {
      "type": "string",
      "enum": ["not_started", "live", "halftime", "finished", "abandoned"],
      "description": "Match lifecycle state."
    },
    "home": {
      "type": "object",
      "required": ["team_id", "score"],
      "additionalProperties": false,
      "properties": {
        "team_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ID for home team."
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "description": "Current goals scored by home team."
        },
        "name": {
          "type": ["string", "null"],
          "description": "Display name."
        }
      }
    },
    "away": {
      "type": "object",
      "required": ["team_id", "score"],
      "additionalProperties": false,
      "properties": {
        "team_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ID for away team."
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "description": "Current goals scored by away team."
        },
        "name": {
          "type": ["string", "null"],
          "description": "Display name."
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "minute", "team"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["goal", "card", "substitution", "own_goal"],
            "description": "Event type."
          },
          "minute": {
            "type": "integer",
            "minimum": 0,
            "description": "Minute when event occurred."
          },
          "team": {
            "type": "string",
            "enum": ["home", "away"],
            "description": "Which team the event applies to."
          },
          "player_id": {
            "type": ["string", "null"],
            "description": "Player involved in the event."
          },
          "detail": {
            "type": ["string", "null"],
            "description": "Additional event detail (e.g., card color, goal type)."
          }
        }
      },
      "description": "Monotonic append-only list of match events."
    }
  }
}
