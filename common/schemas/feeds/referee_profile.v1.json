{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RefereeProfile Payload (v1) — Officials plane",
  "description": "Phase 21.3 — Referee and rolling statistics.",
  "type": "object",
  "required": ["referee_id", "full_name", "nationality", "federation", "licence_level", "debut_year", "rolling_stats"],
  "additionalProperties": false,
  "properties": {
    "referee_id": {"type": "string", "minLength": 1},
    "full_name": {"type": "string", "minLength": 1},
    "nationality": {"type": "string", "minLength": 2, "maxLength": 2, "description": "ISO-3166 country code."},
    "federation": {"type": "string", "minLength": 1},
    "licence_level": {"type": "string", "enum": ["fifa", "uefa_elite", "uefa_first", "domestic_top", "domestic"]},
    "debut_year": {"type": "integer", "minimum": 1900},
    "rolling_stats": {
      "type": "object",
      "required": ["matches_officiated_total", "matches_officiated_window", "yellows_per_match", "reds_per_match", "penalties_per_match", "home_win_pct", "avg_added_time_min"],
      "properties": {
        "matches_officiated_total": {"type": "integer", "minimum": 0},
        "matches_officiated_window": {"type": "integer", "minimum": 0},
        "yellows_per_match": {"type": "number", "minimum": 0},
        "reds_per_match": {"type": "number", "minimum": 0},
        "penalties_per_match": {"type": "number", "minimum": 0},
        "home_win_pct": {"type": "number", "minimum": 0, "maximum": 1},
        "avg_added_time_min": {"type": "number", "minimum": 0}
      }
    }
  }
}
