{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Market Payload (v1) — Market-plane entity",
  "description": "Phase 16 — Bookmaker odds and market data. Per EMITTER.md §3.3, one Record per (match, bookmaker, market_code) tick. Continuous updates captured as new Records.",
  "type": "object",
  "required": [
    "match_stable_id",
    "bookmaker",
    "market_code",
    "selections"
  ],
  "additionalProperties": false,
  "properties": {
    "match_stable_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier for the match."
    },
    "bookmaker": {
      "type": "string",
      "minLength": 1,
      "description": "Bookmaker code (e.g., 'nesine', 'pinnacle')."
    },
    "market_code": {
      "type": "string",
      "minLength": 1,
      "description": "Market identifier (e.g., '1X2' for match winner, 'OVU2.5' for total goals)."
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["selection_id", "odds_decimal"],
        "additionalProperties": false,
        "properties": {
          "selection_id": {
            "type": "string",
            "minLength": 1,
            "description": "Market outcome identifier (e.g., '1' for home, 'X' for draw)."
          },
          "odds_decimal": {
            "type": "number",
            "minimum": 1.01,
            "description": "Decimal odds (invariant: >= 1.01)."
          },
          "available_amount": {
            "type": ["number", "null"],
            "minimum": 0,
            "description": "Available stake at these odds (null if unlimited)."
          },
          "description": {
            "type": ["string", "null"],
            "description": "Human-readable outcome (e.g., 'Home Win')."
          }
        }
      },
      "description": "Available odds and selections."
    },
    "is_suspended": {
      "type": "boolean",
      "description": "True if the market is suspended (no new bets accepted)."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC when the odds update was captured."
    }
  }
}
